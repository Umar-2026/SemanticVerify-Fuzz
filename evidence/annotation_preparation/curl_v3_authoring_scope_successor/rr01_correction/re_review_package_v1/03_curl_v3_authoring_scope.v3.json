  "contract_id": "SVF-CURL-V3-SOURCE-ONLY-AUTHORING-SCOPE-SUCCESSOR",
  "defect_category_projection": {
    "D1": [
      "easy-handle operation before successful easy-handle acquisition",
      "multi-handle operation before successful multi-handle acquisition",
      "source-documented live-resource operation before the corresponding in-scope resource exists",
      "curl_multi_init or another non-exempt in-scope libcurl operation while actual global runtime readiness is UNINITIALIZED"
    ],
    "D2": [
      "easy-handle operation on a null curl_easy_init result",
      "multi-handle operation on a null curl_multi_init result",
      "continuation that relies on an explicitly failed in-scope acquisition result",
      "in-scope libcurl use after curl_global_init returned non-CURLE_OK"
    ],
    "D3": [
      "use of an easy handle after curl_easy_cleanup",
      "use of a multi handle after curl_multi_cleanup",
      "source-documented use of an in-scope resource after release"
    ],
    "D4": [
      "double curl_easy_cleanup of the same released easy handle",
      "double curl_multi_cleanup of the same released multi handle"
    ],
    "D5": [
      "missing curl_easy_cleanup after successful non-null curl_easy_init on a relevant exit",
      "missing curl_multi_cleanup after successful non-null curl_multi_init on a relevant exit",
      "missing matching curl_global_cleanup after successful explicit curl_global_init in the bounded S10 global-state scenario"
    ],
    "D6": [
      "curl_easy_perform while that easy handle remains attached to a multi handle",
      "curl_easy_cleanup before required detachment from its multi handle",
      "multi/easy cleanup in an order contradicting pinned documentation",
      "curl_global_cleanup before the bounded explicit-global-use region is finished",
      "other pinned-source-documented invalid ordering among the twelve in-scope calls",
      "plain curl_multi_perform continuation after a non-CURLM_OK multi-perform result without documented remove/re-add recovery; final MUST/MAY strength requires independent review"
    ],
    "D7": [
      "treating curl_multi_add_handle as transferring ownership of the easy handle to the multi handle",
      "assuming curl_multi_cleanup frees individual easy handles",
      "other pinned-source-documented ownership misuse among bounded resources"
    ],
    "D8": [
      "curl_easy_cleanup conditioned on the wrong easy-acquisition branch",
      "curl_multi_cleanup conditioned on the wrong multi-acquisition branch",
      "curl_multi_remove_handle conditioned on the wrong membership branch",
      "curl_global_cleanup conditioned on the wrong explicit-global-initialization branch",
      "cleanup under the wrong documented resource state or result condition",
      "curl_global_cleanup under a runtime/ownership condition that prematurely removes required global readiness while modeled libcurl use remains live"
    ]
  },
  "designated_reviewer": "Spec-Reviewer-1",
