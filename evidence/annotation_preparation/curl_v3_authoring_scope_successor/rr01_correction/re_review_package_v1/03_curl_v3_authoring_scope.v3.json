  "next_boundary": "INDEPENDENT_HUMAN_REVIEW_OF_EXACT_CURL_V3_SCOPE_SUCCESSOR",
  "normative_strength_review_items": {
    "EASY-CLEANUP-WHILE-ATTACHED": {
      "review_required": true,
      "source_fact": "curl_easy_cleanup documentation says to first remove an easy handle from the multi handle before it is closed",
      "v2_author_position": "retain as a strong membership prerequisite candidate"
    },
    "EXPLICIT-GLOBAL-CLEANUP": {
      "must_vs_may_review_required": true,
      "source_wording": "curl_global_cleanup should be called once for each explicit curl_global_init after libcurl use is complete",
      "v2_author_position": "track the explicit cleanup responsibility separately from runtime readiness"
    },
    "GLOBAL-CLEANUP-D4": {
      "review_required": true,
      "v1_interpretation": "unmatched extra curl_global_cleanup was automatically D4",
      "v2_author_position": "remove automatic call-count D4 classification; evaluate runtime state and cleanup timing path-sensitively"
    },
    "MULTI-CLEANUP-ORDER": {
      "must_vs_may_or_recommendation_review_required": true,
      "source_wording": "the order of cleaning up should be",
      "v2_author_position": "do not silently strengthen the whole sequence to unconditional MUST"
    },
    "MULTI-PERFORM-ERROR": {
      "must_vs_may_review_required": true,
      "source_fact": "after non-CURLM_OK, transfer states are uncertain and curl_multi_perform should not simply be called again",
      "v2_author_position": "represent an explicit post-error condition"
    }
  },
  "option_surface_policy": {
    "application_output_buffer_is_libcurl_owned_resource": false,
    "arbitrary_application_memory_bugs_in_scope": false,
    "curl_easy_setopt_handle_lifecycle_in_scope": true,
    "full_CURLOPT_specific_pointer_lifetime_surface_in_scope": false,
    "rationale": "The frozen scenarios identify curl_easy_setopt as protocol-bearing but do not freeze the complete CURLOPT-specific ownership and pointer-lifetime surface."
  },
  "predecessor_scope_binding": {
    "decision_0021_path": "documentation/decisions/0021-curl-v1-source-only-authoring-scope-freeze.md",
    "decision_0021_sha256": "9ef22ab551184808d3185c95d7286ab3c296bf6d9c29736c0312b84df78f18eb",
    "predecessor_edit_in_place_allowed": false,
    "successor_required_because": [
      "The frozen V1 EXPLICIT_GLOBAL_STATE cannot distinguish a genuinely uninitialized libcurl runtime from runtime readiness established implicitly by successful curl_easy_init.",
      "curl_multi_perform has a documented non-CURLM_OK post-error condition in which transfer states are uncertain and plain repetition is not the documented continuation discipline.",
      "The V1 D4 projection over-strengthens an unmatched extra curl_global_cleanup as an automatic double-cleanup defect.",
      "The broader multi cleanup sequence uses 'should' wording and therefore requires explicit normative-strength review."
    ],
    "v1_scope_freeze_commit": "9b3a33a358cd9cd0d4837b7221426d2e96d42239",
    "v1_scope_freeze_tree": "5933e2ea78dc3e503251e47be49c16f8971cbda3",
