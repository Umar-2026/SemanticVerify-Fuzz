{
  "$id": "urn:svf:independent-accounting-verifier-output:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "minLength": 1,
            "type": "string"
          },
          "expected": {},
          "observed": {},
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "check_id",
          "result",
          "observed",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "command_argv": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evaluated_commits": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{40}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "evaluated_objects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "git_blob": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "path",
          "git_blob",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "exit_code": {
      "type": "integer"
    },
    "generated_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "stderr_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stdout_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verification_role": {
      "enum": [
        "ancestry",
        "immutable_domains",
        "c_domain_closure"
      ]
    },
    "verifier_id": {
      "minLength": 1,
      "type": "string"
    },
    "verifier_path": {
      "minLength": 1,
      "type": "string"
    },
    "verifier_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "working_directory": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "verifier_id",
    "verification_role",
    "verifier_path",
    "verifier_sha256",
    "command_argv",
    "working_directory",
    "evaluated_commits",
    "evaluated_objects",
    "checks",
    "exit_code",
    "stdout_sha256",
    "stderr_sha256",
    "generated_at_utc"
  ],
  "type": "object"
}
