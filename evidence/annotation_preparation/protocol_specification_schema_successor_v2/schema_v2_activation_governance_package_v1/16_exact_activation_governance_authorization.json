      "mandatory": true,
      "requirement": "Preserve frozen zlib and libpcap V1 artifacts byte-for-byte and Git-blob-for-Git-blob without migration."
    },
    "AG05": {
      "mandatory": true,
      "requirement": "Define explicit version-dispatch/coexistence semantics: schema_version 1.0.0 artifacts remain governed by V1 schema and V1 hash contract; schema_version 2.0.0 artifacts may be governed by approved V2 schema and a separately approved V2 hash contract only after activation."
    },
    "AG06": {
      "mandatory": true,
      "requirement": "Keep Schema V2 activation semantically separate from any positive V4-to-V2 mapping contract."
    },
    "AG07": {
      "mandatory": true,
      "requirement": "Do not create or materialize curl.json as part of activation governance."
    },
    "AG08": {
      "mandatory": true,
      "requirement": "Do not authorize analyzer implementation/execution, baseline execution, or repair as a side effect."
    },
    "AG09": {
      "mandatory": true,
      "requirement": "Require independent review/verification of the activation governance package before any decision marks Schema V2 active."
    }
