es":["DEFLATE_ACTIVE"],"transition_id":"T08"},{"event_id":"E06_INFLATE_INIT","from_states":["UNINITIALIZED"],"ownership_effect":"ACQUIRE","return_predicate":"return == Z_OK","to_states":["INFLATE_LIVE"],"transition_id":"T09"},{"event_id":"E06_INFLATE_INIT","from_states":["UNINITIALIZED"],"ownership_effect":"NONE","return_predicate":"return != Z_OK","to_states":["INIT_FAILED"],"transition_id":"T10"},{"event_id":"E07_INFLATE","from_states":["INFLATE_LIVE"],"ownership_effect":"NONE","return_predicate":"return != Z_STREAM_END while allocated inflate state remains live","to_states":["INFLATE_LIVE"],"transition_id":"T11"},{"event_id":"E07_INFLATE","from_states":["INFLATE_LIVE"],"ownership_effect":"NONE","return_predicate":"return == Z_STREAM_END","to_states":["INFLATE_STREAM_END"],"transition_id":"T12"},{"event_id":"E08_INFLATE_END","from_states":["INFLATE_LIVE","INFLATE_STREAM_END"],"ownership_effect":"RELEASE","return_predicate":"valid allocated inflate state","to_states":["RELEASED"],"transition_id":"T13"},{"event_id":"E09_INFLATE_RESET","from_states":["INFLATE_LIVE","INFLATE_STREAM_END"],"ownership_effect":"NONE","return_predicate":"return == Z_OK","to_states":["INFLATE_LIVE"],"transition_id":"T14"},{"event_id":"E10_INFLATE_COPY","from_states":["UNINITIALIZED"],"ownership_effect":"ACQUIRE","return_predicate":"source valid and return == Z_OK","to_states":["INFLATE_LIVE"],"transition_id":"T15"},{"event_id":"E10_INFLATE_COPY","from_states":["UNINITIALIZED"],"ownership_effect":"NONE","return_predicate":"return != Z_OK","to_states":["UNINITIALIZED"],"transition_id":"T16"},{"event_id":"E07_INFLATE","from_states":["INFLATE_STREAM_END"],"ownership_effect":"NONE","return_predicate":"inflate return == Z_STREAM_END","to_states":["INFLATE_STREAM_END"],"transition_id":"T17"}]}