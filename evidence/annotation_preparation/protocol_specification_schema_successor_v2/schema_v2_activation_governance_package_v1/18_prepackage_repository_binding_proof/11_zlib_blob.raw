"EV-ZLIB-ZPIPE-004"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:deflate|deflateReset|deflateSetDictionary after failed deflate initialization"},{"cleanup_responsibility":"Failed initialization does not establish the normal successful-init cleanup obligation.","content_sha256":"7e9055556d93475dfe7679efa830002afd8d722e88159cd8c93c6798f8f18d05","creation_date":"2026-08-11","defect_category":"D2","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"INIT_FAILED is not a valid inflate-use state; a fresh successful initialization is required.","resource_kind":"zlib.z_stream.inflate","return_predicate":"prior inflateInit/inflateInit2 return != Z_OK","rule_id":"ZLIB-R04","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-INF-003","EV-ZLIB-ZPIPE-004"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:inflate|inflateReset|inflateCopy(source) after failed inflate initialization"},{"cleanup_responsibility":"End releases internal state and sets implementation state to Z_NULL.","content_sha256":"cd14529fdfdbc9c096777b5210162928e4acc4c25edf8511f873ce881a97f80e","creation_date":"2026-08-11","defect_category":"D3","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"RELEASED is not a live stream state; new successful initialization is required before subsequent stateful use.","resource_kind":"zlib.z_stream.internal_state","return_predicate":null,"rule_id":"ZLIB-R05","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-DEF-002","EV-ZLIB-INF-003","EV-ZLIB-INFCOVER-006"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:stateful deflate/inflate operation after corresponding End"},{"cleanup_responsibility":"Exactly one matching release is required for each currently-live acquisition.","content_sha256":"e49acc6e9c75c64461a2f950e3570f2150dae2f3922be5006c0569d618f2affb","creation_date":"2026-08-11","defect_category":"D4","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"RELEASE","permitted_transitions":["T05","T13"],"required_pre_state_or_exit_condition":"End requires a corresponding currently-live acquired state; a second End after RELEASED is invalid.","resource_kind":"zlib.z_stream.internal_state","return_predicate":null,"rule_id":"ZLIB-R06","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-DEF-002","EV-ZLIB-INF-003","EV-ZLIB-INFCOVER-006"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:deflateEnd|inflateEnd"},{"cleanup_responsibility":"Caller is responsible for matching deflateEnd on normal and error exits after successful initialization.","content_sha256":"5faaee2d1d1a532660e59f9b30b926978fa34f0036a47f5097a1b6c9d748bf2e","creation_date":"2026-08-11","defect_category":"D5","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"RELEASE","permitted_transitions":["T05"],"required_pre_state_or_exit_condition":"Every successful deflate initialization must reach RELEASED through deflateEnd on every relevant function exit.","resource_kind":"zlib.z_stream.deflate","return_predicate":"successful deflate initialization return == Z_OK","rule_id":"ZLIB-R07","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-DEF-002","EV-ZLIB-ZPIPE-004","EV-ZLIB-TEST-005"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"FUNCTION_EXIT"},{"cleanup_responsibility":"Caller is responsible for matching inflateEnd on normal and error exits after successful initialization.","content_sha256":"0427525b365e524ab909946b033691b2c273d5bc5e05fe0f4a1c91420fcb2dc8","creation_date":"2026-08-11","defect_category":"D5","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"RELEASE","permitted_transitions":["T13"],"required_pre_state_or_exit_condition":"Every successful inflate initialization must reach RELEASED through inflateEnd on every relevant function exit.","resource_kind":"zlib.z_stream.inflate","return_predicate":"successful inflate initialization return == Z_OK","rule_id":"ZLIB-R08","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-INF-003","EV-ZLIB-ZPIPE-004","EV-ZLIB-TEST-005"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"FUNCTION_EXIT"},{"cleanup_responsibility":"Successful destination copy acquires internal state independently requiring matching inflateEnd.","content_sha256":"d62bf7fe1786e9c0cea7ee21dbf9d1528b45b9660f280550782ef04f6597db01","creation_date":"2026-08-11","defect_category":"D5","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"ACQUIRE","permitted_transitions":["T15","T13"],"required_pre_state_or_exit_condition":"A destination for which inflateCopy returned Z_OK owns an independent copied inflate state and must reach RELEASED through inflateEnd.","resource_kind":"zlib.z_stream.inflate_copy_destination","return_predicate":"inflateCopy return == Z_OK","rule_id":"ZLIB-R09","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-INF-003","EV-ZLIB-INFCOVER-006"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"FUNCTION_EXIT after successful inflateCopy"},{"cleanup_responsibility":"Reset retains ownership; End releases ownership.","content_sha256":"b533515d45051c6adc6bde559259f07cdedc9b02e713c18a3d9f1b229f7c16b9","creation_date":"2026-08-11","defect_category":"D6","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"NONE","permitted_transitions":["T05","T06"],"required_pre_state_or_exit_condition":"When state is DEFLATE_STREAM_END, only deflateReset or deflateEnd are permitted.","resource_kind":"zlib.z_stream.deflate","return_predicate":"prior deflate return == Z_STREAM_END","rule_id":"ZLIB-R10","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL after deflate returned Z_STREAM_END"},{"cleanup_responsibility":"Dictionary configuration does not release stream ownership.","content_sha256":"9137fc07ea344a993f4ad561ebbdbc4474be1d4a3b0c99805beb2120aa63b53e","creation_date":"2026-08-11","defect_category":"D6","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"NONE","permitted_transitions":["T07","T08"],"required_pre_state_or_exit_condition":"For zlib-wrapped deflate call immediately after init/reset and before deflate; raw deflate permits the documented completed-block-boundary exception.","resource_kind":"zlib.z_stream.deflate","return_predicate":"return == Z_OK only when documented ordering/state requirements hold","rule_id":"ZLIB-R11","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-DEF-002","EV-ZLIB-TEST-005"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:deflateSetDictionary"},{"cleanup_responsibility":"Internal allocation remains owned after reset; eventual matching End remains required.","content_sha256":"ffe589b7c213bdd0a60e9e30c2c04d700fe4b6303637b3f1c83cbd5f12b2fb9c","creation_date":"2026-08-11","defect_category":"D5","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"NONE","permitted_transitions":["T06","T14"],"required_pre_state_or_exit_condition":"Reset requires a valid live corresponding stream state and returns the resource to a reusable state without releasing ownership.","resource_kind":"zlib.z_stream.internal_state","return_predicate":"reset return == Z_OK","rule_id":"ZLIB-R12","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-H-001","EV-ZLIB-DEF-002","EV-ZLIB-INF-003"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:deflateReset|inflateReset"},{"cleanup_responsibility":"Guard matching cleanup by successful acquisition; failed initialization does not carry the normal successful-init cleanup obligation.","content_sha256":"fc9d3ca5e4156acfa6d7980401c5c76beecfafcdbcd7ec0249f1c827101fc4e6","creation_date":"2026-08-11","defect_category":"D8","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"RELEASE","permitted_transitions":["T05","T13"],"required_pre_state_or_exit_condition":"Cleanup obligation exists only for a resource whose corresponding initialization or copy successfully acquired a live state.","resource_kind":"zlib.z_stream.internal_state","return_predicate":"acquisition return == Z_OK","rule_id":"ZLIB-R13","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-DEF-002","EV-ZLIB-INF-003","EV-ZLIB-ZPIPE-004","EV-ZLIB-INFCOVER-006"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:deflateEnd|inflateEnd conditioned on initialization/copy result"},{"cleanup_responsibility":"A successful inflateCopy acquires an independent destination inflate state that must later be released with inflateEnd. inflateCopy must not overwrite a destination that still owns a live modeled internal state.","content_sha256":"02d4fc8f0d4e07d46364f51ba6e3bdebbd7aab153b3aad8aa88aab6f7bc4f7da","creation_date":"2026-08-15","defect_category":"D7","freeze_date":"2026-08-16","library_revision":"da607da739fa6047df13e66a2af6b8bec7c2a498","ownership_effect":"ACQUIRE","permitted_transitions":["T15"],"required_pre_state_or_exit_condition":"Before inflateCopy, the destination must not already own any live modeled zlib internal state. The destination is treated as a fresh/uninitialized logical resource slot; a RELEASED prior lifecycle may be reused only as a fresh logical FSM instance.","resource_kind":"zlib.z_stream.internal_state_family","return_predicate":"inflateCopy return == Z_OK","rule_id":"ZLIB-R14","severity":"UNSPECIFIED","source_evidence":["EV-ZLIB-INF-003","EV-ZLIB-H-001"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:inflateCopy(destination)"}],"permitted_exit_states":["UNINITIALIZED","INIT_FAILED","RELEASED"],"provenance":[{"content_sha256":"818667d6ab6a37fe7469cb06a7f0cb2c2cb2f2c948a03e5accf1a4a74bf3020a","evidence_id":"EV-ZLIB-H-001","path_or_url":"/openbayes/home/svf-gate1c-source-qualification-v1/zlib/zlib.h","quoted_or_paraphrased_rationale":"Normative public API lifecycle evidence for deflate/inflate initialization, use, return states, reset, end, dictionary ordering, and inflateCopy.","retrieval_date":"2026-08-11","source_type":"PUBLIC_HEADER"},{"content_sha256":"ea9ca4eb51b1a71aaf214b99f4a9fab177253d6268cae8e4c26d44d1812e52c2","evidence_id":"EV-ZLIB-DEF-002","path_or_url":"/openbayes/home/svf-gate1c-source-qualification-v1/zlib/deflate.c","quoted_or_paraphrased_rationale":"Pinned implementation evidence for allocation, failed-allocation cleanup, state checking, reset, dictionary ordering, and deflateEnd release semantics.","retrieval_date":"2026-08-11","source_type":"PINNED_IMPLEMENTATION_SOURCE"},{"content_sha256":"90221ea7d762e7044057f6ad5013e969086c6ba3d3051716b7aa786d7a6362ec","evidence_id":"EV-ZLIB-INF-003","path_or_url":"/openbayes/home/svf-gate1c-source-qualification-v1/zlib/inflate.c","quoted_or_paraphrased_rationale":"Pinned implementation evidence for allocation, failed-init cleanup, state checking, reset, inflateEnd release, and inflateCopy allocation.","retrieval_date":"2026-08-11","source_type":"PINNED_IMPLEMENTATION_SOURCE"},{"content_sha256":"e79717cefd20043fb78d730fd3b9d9cdf8f4642307fc001879dc82ddb468509f","evidence_id":"EV-ZLIB-ZPIPE-004","path_or_url":"/openbayes/home/svf-gate1c-source-qualification-v1/zlib/examples/zpipe.c","quoted_or_paraphrased_