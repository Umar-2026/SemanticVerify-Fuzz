{"author":"Spec-Author-1","content_sha256":"370da6351b59f6134ae09477d8941d8ab119adad7f4230540758e09326b47c4f","creation_date":"2026-08-16","events":[{"event_id":"E01_PCAP_CREATE","event_kind":"API_CALL","symbol_or_condition":"pcap_create"},{"event_id":"E02_PRE_ACTIVATION_CONFIG","event_kind":"API_CALL","symbol_or_condition":"pcap_set_snaplen or pcap_set_promisc or pcap_set_timeout or pcap_set_immediate_mode or pcap_set_buffer_size"},{"event_id":"E03_PCAP_ACTIVATE","event_kind":"API_CALL","symbol_or_condition":"pcap_activate"},{"event_id":"E04_PCAP_DATALINK","event_kind":"API_CALL","symbol_or_condition":"pcap_datalink"},{"event_id":"E05_PCAP_NEXT_EX","event_kind":"API_CALL","symbol_or_condition":"pcap_next_ex"},{"event_id":"E06_PCAP_COMPILE","event_kind":"API_CALL","symbol_or_condition":"pcap_compile; transition tracked for the struct bpf_program resource while the associated pcap_t active-state requirement is a precondition"},{"event_id":"E07_PCAP_SETFILTER","event_kind":"API_CALL","symbol_or_condition":"pcap_setfilter; capture-handle state is tracked while valid compiled-program state is a separate resource precondition"},{"event_id":"E08_PCAP_FREECODE","event_kind":"API_CALL","symbol_or_condition":"pcap_freecode"},{"event_id":"E09_PCAP_CLOSE","event_kind":"API_CALL","symbol_or_condition":"pcap_close"},{"event_id":"E10_FUNCTION_EXIT","event_kind":"FUNCTION_EXIT","symbol_or_condition":"enclosing fuzz-driver function return or exit"}],"freeze_date":"2026-08-17","initial_state":"NO_HANDLE__BPF__NO_VALID_PROGRAM","library":"libpcap","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","obligations":[{"cleanup_responsibility":"Successful creation acquires a pcap_t that remains caller-owned until pcap_close.","content_sha256":"c19929019370aa8d36c4296e395cb5ea949f14c4fbe21fbb98b8633d2b3150aa","creation_date":"2026-08-16","defect_category":"D1","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T03__BPF__NO_VALID_PROGRAM","T03__BPF__COMPILED_OWNED","T03__BPF__FREED_OR_EMPTY","T04__BPF__NO_VALID_PROGRAM","T04__BPF__COMPILED_OWNED","T04__BPF__FREED_OR_EMPTY","T14__BPF__NO_VALID_PROGRAM","T14__BPF__COMPILED_OWNED","T14__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"A non-NULL return from pcap_create must establish UNACTIVATED_OWNED before the acquired pcap_t is used.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"prior pcap_create return != NULL","rule_id":"LIBPCAP-R01","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-H-001","EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-CREATE-005"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:any modeled pcap_t operation requiring an acquired handle"},{"cleanup_responsibility":"A failed create does not establish the successful-handle pcap_close cleanup obligation.","content_sha256":"dec8c065058c5db951c6df88e4286d4df183be386d782001a19ec47295b9d259","creation_date":"2026-08-16","defect_category":"D2","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"pcap_create returning NULL leaves NO_HANDLE; the failed acquisition result is not a usable capture handle.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"prior pcap_create return == NULL","rule_id":"LIBPCAP-R02","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-CREATE-005","EV-LIBPCAP-MAN-PCAP-004"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:modeled pcap_t use after pcap_create failure"},{"cleanup_responsibility":"Configuration does not release the acquired handle; eventual pcap_close remains required.","content_sha256":"8913fed3915d189e5fc3179e51485a4fbbd60ee7f49caf06e76ac7023fb36714","creation_date":"2026-08-16","defect_category":"D6","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T03__BPF__NO_VALID_PROGRAM","T03__BPF__COMPILED_OWNED","T03__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_set_snaplen, pcap_set_promisc, pcap_set_timeout, pcap_set_immediate_mode, and pcap_set_buffer_size require UNACTIVATED_OWNED. Calling them after activation is an ordering violation.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"valid pre-activation configuration return == 0; an activated handle yields PCAP_ERROR_ACTIVATED where documented","rule_id":"LIBPCAP-R03","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-SNAPLEN-008","EV-LIBPCAP-MAN-PROMISC-009","EV-LIBPCAP-MAN-TIMEOUT-010","EV-LIBPCAP-MAN-IMMEDIATE-011","EV-LIBPCAP-MAN-BUFFER-012"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pre-activation configuration family"},{"cleanup_responsibility":"Activation does not transfer ownership. The acquired handle still requires pcap_close.","content_sha256":"420074125acdea1b9d24c7f06a671f23ede8084e168bbe6c7b38016d111b9ac0","creation_date":"2026-08-16","defect_category":"D6","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T04__BPF__NO_VALID_PROGRAM","T04__BPF__COMPILED_OWNED","T04__BPF__FREED_OR_EMPTY","T05__BPF__NO_VALID_PROGRAM","T05__BPF__COMPILED_OWNED","T05__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_activate is modeled from UNACTIVATED_OWNED. Reactivation of an already ACTIVE_OWNED handle is invalid.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"return >= 0 establishes ACTIVE_OWNED; return < 0 establishes ACTIVATION_FAILED_OWNED","rule_id":"LIBPCAP-R04","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-ACTIVATE-006","EV-LIBPCAP-MAN-PCAP-004"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_activate"},{"cleanup_responsibility":"The failed-activation handle remains owned and must be closed with pcap_close.","content_sha256":"4631f1f75eda8951b8dd132496ddbb64079b6018e7a28f7e02807c502a02d65b","creation_date":"2026-08-16","defect_category":"D2","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"ACTIVATION_FAILED_OWNED is not an active-use state. After a negative pcap_activate result, active-only operations are not permitted.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"prior pcap_activate return < 0","rule_id":"LIBPCAP-R05","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-ACTIVATE-006","EV-LIBPCAP-MAN-PCAP-004","EV-LIBPCAP-MAN-DATALINK-013","EV-LIBPCAP-MAN-SETFILTER-016"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_datalink|pcap_next_ex|pcap_compile|pcap_setfilter after failed activation"},{"cleanup_responsibility":"Caller is responsible for pcap_close after successful creation, including pre-activation exits and activation-failure exits.","content_sha256":"8d402dc99fd5b43f7fe4ebccd0dfa423e33374802f10532c23e78ba22d21fd33","creation_date":"2026-08-16","defect_category":"D5","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"RELEASE","permitted_transitions":["T14__BPF__NO_VALID_PROGRAM","T14__BPF__COMPILED_OWNED","T14__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"Every non-NULL pcap_create acquisition must reach CLOSED through pcap_close on every relevant normal or error exit.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"pcap_create return != NULL","rule_id":"LIBPCAP-R06","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-CREATE-005","EV-LIBPCAP-MAN-ACTIVATE-006","EV-LIBPCAP-MAN-CLOSE-007","EV-LIBPCAP-MAN-PCAP-004","EV-LIBPCAP-C-002"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"FUNCTION_EXIT"},{"cleanup_responsibility":"Cleanup must be guarded by successful handle acquisition and must not be omitted merely because activation failed.","content_sha256":"3560ec7bf820ff783dd4dc3d8b1e18c31a7ae50520d6da25526cc6ca6b3e601e","creation_date":"2026-08-16","defect_category":"D8","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"RELEASE","permitted_transitions":["T14__BPF__NO_VALID_PROGRAM","T14__BPF__COMPILED_OWNED","T14__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_close cleanup is tied to a currently acquired UNACTIVATED_OWNED, ACTIVE_OWNED, or ACTIVATION_FAILED_OWNED handle; pcap_create returning NULL creates no successful-handle cleanup obligation.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"corresponding acquisition succeeded","rule_id":"LIBPCAP-R07","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-CREATE-005","EV-LIBPCAP-MAN-ACTIVATE-006","EV-LIBPCAP-MAN-CLOSE-007","EV-LIBPCAP-MAN-PCAP-004"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_close conditioned on acquisition/activation result"},{"cleanup_responsibility":"pcap_close releases the current pcap_t resource; later reuse requires a fresh logical acquisition.","content_sha256":"d5d438ec886f1238272c5246c482013a23ba0209c82f02300c3712782a7658bd","creation_date":"2026-08-16","defect_category":"D3","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"CLOSED is not a live capture-handle state. A fresh pcap_create acquisition is required for a new logical resource instance.","resource_kind":"libpcap.pcap_t.handle","return_predicate":null,"rule_id":"LIBPCAP-R08","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-CLOSE-007"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:stateful modeled pcap_t operation after pcap_close"},{"cleanup_responsibility":"Exactly one release is required for each currently-live pcap_t acquisition.","content_sha256":"428faa11189afbf172d27982df0781b6deccfb2949b4323461d8ce6bed919536","creation_date":"2026-08-16","defect_category":"D4","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"RELEASE","permitted_transitions":["T14__BPF__NO_VALID_PROGRAM","T14__BPF__COMPILED_OWNED","T14__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_close requires a currently owned capture handle. A second pcap_close after CLOSED is invalid.","resource_kind":"libpcap.pcap_t.handle","return_predicate":null,"rule_id":"LIBPCAP-R09","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-CLOSE-007"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_close"},{"cleanup_responsibility":"The metadata query does not release capture-handle ownership.","content_sha256":"b0b32d58534f80af2fb7a821cc4e44c2ec76e0554bccb541143b95b02141f23a","creation_date":"2026-08-16","defect_category":"D1","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T06__BPF__NO_VALID_PROGRAM","T06__BPF__COMPILED_OWNED","T06__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_datalink requires ACTIVE_OWNED; a handle created by pcap_create but not yet successfully activated is not a valid pre-state.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"handle is ACTIVE_OWNED","rule_id":"LIBPCAP-R10","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-DATALINK-013"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_datalink"},{"cleanup_responsibility":"The pcap_t remains caller-owned until pcap_close. A return of 1 additionally yields library-owned borrowed header/data values.","content_sha256":"4b541ff0aa93c417bd5f9b9121e8d95520b2c8cd378ce004aee63b453d671be1","creation_date":"2026-08-16","defect_category":"D1","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"BORROW","permitted_transitions":["T07__BPF__NO_VALID_PROGRAM","T07__BPF__COMPILED_OWNED","T07__BPF__FREED_OR_EMPTY","T08__BPF__NO_VALID_PROGRAM","T08__BPF__COMPILED_OWNED","T08__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_next_ex requires an ACTIVE_OWNED live-capture handle in this scenario-bounded specification.","resource_kind":"libpcap.pcap_t.handle","return_predicate":"handle is ACTIVE_OWNED","rule_id":"LIBPCAP-R11","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-H-001","EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-NEXTEX-014"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_next_ex"},{"cleanup_responsibility":"Caller may inspect or copy the values but does not own their storage.","content_sha256":"e06c563da1ef867b1ffa9ce5476f86bae8f131b8061a588471cd0763965a4cc2","creation_date":"2026-08-16","defect_category":"D7","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"BORROW","permitted_transitions":[],"required_pre_state_or_exit_condition":"The struct pcap_pkthdr and packet-data pointers yielded by a successful pcap_next_ex are library-owned borrowed values and must not be freed by the caller.","resource_kind":"libpcap.pcap_next_ex.borrowed_packet_view","return_predicate":"pcap_next_ex return == 1","rule_id":"LIBPCAP-R12","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-NEXTEX-014"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"CALLER_DEALLOCATION:pcap_next_ex returned packet header or packet data"},{"cleanup_responsibility":"Copy data that must outlive the documented borrowed-value lifetime.","content_sha256":"42cf3f81d7ba0759cf240d6dd0d0b77cc82620e5dd28544567e1a40b7a66a388","creation_date":"2026-08-16","defect_category":"D3","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"A borrowed header/data view is not guaranteed to remain valid after the next packet-reading call. For this frozen V1 scope, a later pcap_next_ex invalidates reliance on the prior borrowed view unless it was copied.","resource_kind":"libpcap.pcap_next_ex.borrowed_packet_view","return_predicate":"prior borrow was not copied before subsequent packet-read call","rule_id":"LIBPCAP-R13","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-NEXTEX-014"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"USE:prior pcap_next_ex packet header or data after a subsequent in-scope pcap_next_ex call"},{"cleanup_responsibility":"Successful compilation creates caller-owned compiled program state requiring eventual pcap_freecode.","content_sha256":"a7c3b1db23cf13780cc2bcafefd881b06fe512fe557f7a92b33232847974a3f0","creation_date":"2026-08-16","defect_category":"D1","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"ACQUIRE","permitted_transitions":["T09__PCAP__NO_HANDLE","T09__PCAP__UNACTIVATED_OWNED","T09__PCAP__ACTIVE_OWNED","T09__PCAP__ACTIVATION_FAILED_OWNED","T09__PCAP__CLOSED","T10__PCAP__NO_HANDLE","T10__PCAP__UNACTIVATED_OWNED","T10__PCAP__ACTIVE_OWNED","T10__PCAP__ACTIVATION_FAILED_OWNED","T10__PCAP__CLOSED"],"required_pre_state_or_exit_condition":"pcap_compile requires the associated pcap_t to be ACTIVE_OWNED. For a fresh BPF logical resource instance, the destination program state is NO_VALID_PROGRAM before compilation.","resource_kind":"libpcap.bpf_program","return_predicate":"associated handle ACTIVE_OWNED; return == 0 acquires COMPILED_OWNED","rule_id":"LIBPCAP-R14","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-GENCODE-003","EV-LIBPCAP-MAN-COMPILE-015"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_compile"},{"cleanup_responsibility":"Caller is responsible for pcap_freecode for every successfully compiled program.","content_sha256":"aa0fe3b56806943116ecf680ff57f1fa67bf59bee39f5ce504d9e56832981b89","creation_date":"2026-08-16","defect_category":"D5","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"RELEASE","permitted_transitions":["T12__PCAP__NO_HANDLE","T12__PCAP__UNACTIVATED_OWNED","T12__PCAP__ACTIVE_OWNED","T12__PCAP__ACTIVATION_FAILED_OWNED","T12__PCAP__CLOSED"],"required_pre_state_or_exit_condition":"Each pcap_compile return == 0 creates COMPILED_OWNED state that must reach FREED_OR_EMPTY through pcap_freecode on every relevant exit.","resource_kind":"libpcap.bpf_program","return_predicate":"pcap_compile return == 0","rule_id":"LIBPCAP-R15","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-GENCODE-003","EV-LIBPCAP-MAN-COMPILE-015","EV-LIBPCAP-MAN-FREECODE-017"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"FUNCTION_EXIT after successful pcap_compile"},{"cleanup_responsibility":"Guard successful-program use and cleanup on pcap_compile return == 0.","content_sha256":"26e577f49503bdb1bc04d2766e7f62e6fdb1e662d133ee2aa3c1e8814005cabd","creation_date":"2026-08-16","defect_category":"D8","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T10__PCAP__NO_HANDLE","T10__PCAP__UNACTIVATED_OWNED","T10__PCAP__ACTIVE_OWNED","T10__PCAP__ACTIVATION_FAILED_OWNED","T10__PCAP__CLOSED"],"required_pre_state_or_exit_condition":"A failed pcap_compile from a fresh NO_VALID_PROGRAM resource does not create a new valid compiled program or the successful-compile cleanup obligation.","resource_kind":"libpcap.bpf_program","return_predicate":"pcap_compile return != 0","rule_id":"LIBPCAP-R16","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-GENCODE-003","EV-LIBPCAP-MAN-COMPILE-015","EV-LIBPCAP-MAN-FREECODE-017"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_freecode or pcap_setfilter conditioned on pcap_compile result"},{"cleanup_responsibility":"Filter installation does not release either the capture handle or caller-owned compiled-program cleanup duty.","content_sha256":"510a890a664c10cde4d6bb3ae6c428c06b696b927a14446d49252b8db295a20e","creation_date":"2026-08-16","defect_category":"D6","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T11__BPF__NO_VALID_PROGRAM","T11__BPF__COMPILED_OWNED","T11__BPF__FREED_OR_EMPTY"],"required_pre_state_or_exit_condition":"pcap_setfilter requires an ACTIVE_OWNED capture handle and a valid COMPILED_OWNED bpf_program.","resource_kind":"libpcap.filter_installation","return_predicate":"associated pcap_t is ACTIVE_OWNED and associated bpf_program is COMPILED_OWNED","rule_id":"LIBPCAP-R17","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-C-002","EV-LIBPCAP-MAN-COMPILE-015","EV-LIBPCAP-MAN-SETFILTER-016","EV-LIBPCAP-MAN-FREECODE-017"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_setfilter"},{"cleanup_responsibility":"The caller retains the eventual pcap_freecode obligation whether pcap_setfilter succeeds or fails.","content_sha256":"db48148e2b5b20257e09e7eea0312cd5d8fff61d23796f30e5bf1fd5efd871a6","creation_date":"2026-08-16","defect_category":"D7","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":["T11__BPF__NO_VALID_PROGRAM","T11__BPF__COMPILED_OWNED","T11__BPF__FREED_OR_EMPTY","T12__PCAP__NO_HANDLE","T12__PCAP__UNACTIVATED_OWNED","T12__PCAP__ACTIVE_OWNED","T12__PCAP__ACTIVATION_FAILED_OWNED","T12__PCAP__CLOSED"],"required_pre_state_or_exit_condition":"Passing a valid compiled program to pcap_setfilter does not transfer caller ownership of the bpf_program.","resource_kind":"libpcap.bpf_program","return_predicate":"program was successfully produced by pcap_compile","rule_id":"LIBPCAP-R18","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-MAN-COMPILE-015","EV-LIBPCAP-MAN-SETFILTER-016","EV-LIBPCAP-MAN-FREECODE-017","EV-LIBPCAP-GENCODE-003"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_setfilter followed by later program cleanup"},{"cleanup_responsibility":"A later compilation, if desired, begins a fresh logical BPF resource lifecycle; this V1 does not infer reuse without a fresh successful compile.","content_sha256":"bd1d7f9601247f4af3cd9e79a0903e95dcbd381121d6f50d1c9830823e877bd8","creation_date":"2026-08-16","defect_category":"D3","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6bc185a8d4dc","ownership_effect":"NONE","permitted_transitions":[],"required_pre_state_or_exit_condition":"FREED_OR_EMPTY is not COMPILED_OWNED. A program whose compiled storage has been released cannot be treated as a live compiled filter program.","resource_kind":"libpcap.bpf_program","return_predicate":null,"rule_id":"LIBPCAP-R19","severity":"UNSPECIFIED","source_evidence":["EV-LIBPCAP-GENCODE-003","EV-LIBPCAP-MAN-SETFILTER-016","EV-LIBPCAP-MAN-FREECODE-017"],"specification_author":"Spec-Author-1","triggering_event_or_function_exit":"API_CALL:pcap_setfilter or other modeled live-program use after pcap_freecode"},{"cleanup_responsibility":"Apply pcap_close and pcap_freecode independently to each owned resource on all relevant exits.","content_sha256":"04f0dd2b87c425699b9bd47fd9fb894ace3d1fe39904890e8edb2b2043cf6e75","creation_date":"2026-08-16","defect_category":"D8","freeze_date":"2026-08-17","library_revision":"a999701dca5c873779281938baee6