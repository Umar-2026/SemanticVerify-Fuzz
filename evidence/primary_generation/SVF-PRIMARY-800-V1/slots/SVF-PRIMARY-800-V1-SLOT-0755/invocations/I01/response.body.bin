{"id":"ea93d949-2dbe-49a2-bb48-ea0df7d5c473","object":"chat.completion","created":1786351654,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include \"lcms2.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    // Use first byte to derive gamma value (avoid zero and negative)\n    double gamma = (double)(data[0] % 100 + 1) / 10.0; // 0.1 to 10.0\n\n    // Build tone curve from fuzz-derived gamma\n    cmsToneCurve *curve = cmsBuildGamma(NULL, gamma);\n    if (!curve) return 0;\n\n    // Create a profile with the tone curve as TRC for gray\n    cmsHPROFILE profile = cmsCreateGrayProfile(cmsD50_xyY(), curve);\n    if (!profile) {\n        cmsFreeToneCurve(curve);\n        return 0;\n    }\n\n    // Create a transform from profile to sRGB\n    cmsHPROFILE srgb = cmsCreate_sRGBProfile();\n    if (!srgb) {\n        cmsCloseProfile(profile);\n        cmsFreeToneCurve(curve);\n        return 0;\n    }\n\n    cmsHTRANSFORM transform = cmsCreateTransform(profile, TYPE_GRAY_8, srgb, TYPE_RGB_8, INTENT_PERCEPTUAL, 0);\n    if (!transform) {\n        cmsCloseProfile(srgb);\n        cmsCloseProfile(profile);\n        cmsFreeToneCurve(curve);\n        return 0;\n    }\n\n    // Process a small buffer if enough data\n    if (size > 1) {\n        size_t n = size - 1;\n        if (n > 256) n = 256;\n        uint8_t gray[256];\n        uint8_t rgb[256 * 3];\n        for (size_t i = 0; i < n; i++) {\n            gray[i] = data[1 + i];\n        }\n        cmsDoTransform(transform, gray, rgb, n);\n    }\n\n    // Cleanup\n    cmsDeleteTransform(transform);\n    cmsCloseProfile(srgb);\n    cmsCloseProfile(profile);\n    cmsFreeToneCurve(curve);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":161,"completion_tokens":499,"total_tokens":660,"prompt_tokens_details":{"cached_tokens":128},"prompt_ca