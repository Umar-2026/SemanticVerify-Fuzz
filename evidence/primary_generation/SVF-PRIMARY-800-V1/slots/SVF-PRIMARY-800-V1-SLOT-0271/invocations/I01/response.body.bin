{"id":"cfe1dc25-a02a-4188-a03c-db79fcdc4a5b","object":"chat.completion","created":1786292664,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    CURLM *multi_handle = curl_multi_init();\n    if (!multi_handle) {\n        return 0;\n    }\n\n    CURL *easy_handle = curl_easy_init();\n    if (!easy_handle) {\n        curl_multi_cleanup(multi_handle);\n        return 0;\n    }\n\n    char url[256];\n    snprintf(url, sizeof(url), \"file:///tmp/fuzz_%08x\", (unsigned int)data[0]);\n\n    curl_easy_setopt(easy_handle, CURLOPT_URL, url);\n    curl_easy_setopt(easy_handle, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(easy_handle, CURLOPT_TIMEOUT_MS, 100L);\n    curl_easy_setopt(easy_handle, CURLOPT_CONNECTTIMEOUT_MS, 100L);\n    curl_easy_setopt(easy_handle, CURLOPT_NOSIGNAL, 1L);\n\n    CURLMcode mc = curl_multi_add_handle(multi_handle, easy_handle);\n    if (mc != CURLM_OK) {\n        curl_easy_cleanup(easy_handle);\n        curl_multi_cleanup(multi_handle);\n        return 0;\n    }\n\n    int still_running = 0;\n    int max_iterations = 100;\n    do {\n        mc = curl_multi_perform(multi_handle, &still_running);\n        if (mc != CURLM_OK) {\n            break;\n        }\n        if (still_running) {\n            struct timeval timeout;\n            timeout.tv_sec = 0;\n            timeout.tv_usec = 1000;\n            fd_set fdread, fdwrite, fdexcep;\n            FD_ZERO(&fdread);\n            FD_ZERO(&fdwrite);\n            FD_ZERO(&fdexcep);\n            int maxfd = -1;\n            curl_multi_fdset(multi_handle, &fdread, &fdwrite, &fdexcep, &maxfd);\n            if (maxfd >= 0) {\n                select(maxfd + 1, &fdread, &fdwrite, &fdexcep, &timeout);\n            } else {\n                usleep(1000);\n            }\n        }\n    } while (still_running && --max_iterations > 0);\n\n    curl_multi_remove_handle(multi_handle, easy_handle);\n    curl_easy_cleanup(easy_handle);\n    curl_multi_cleanup(multi_handle);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":188,"completion_tokens":663,"total_tokens":851,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":60},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}