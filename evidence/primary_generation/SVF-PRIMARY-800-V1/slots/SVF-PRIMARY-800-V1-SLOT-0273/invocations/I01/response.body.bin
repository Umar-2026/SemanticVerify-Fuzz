{"id":"8a27a9e6-c819-4913-9494-e935e1c1ad51","object":"chat.completion","created":1786292669,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    // Use the first byte to determine the file path length (bounded)\n    size_t path_len = data[0] % 64;\n    if (path_len > size - 1) {\n        path_len = size - 1;\n    }\n\n    // Construct a local file:// URL from the fuzz input\n    char url[128];\n    snprintf(url, sizeof(url), \"file://\");\n    size_t url_len = strlen(url);\n    size_t copy_len = path_len;\n    if (url_len + copy_len >= sizeof(url)) {\n        copy_len = sizeof(url) - url_len - 1;\n    }\n    memcpy(url + url_len, data + 1, copy_len);\n    url[url_len + copy_len] = '\\0';\n\n    CURL *easy = curl_easy_init();\n    if (!easy) {\n        return 0;\n    }\n\n    CURLM *multi = curl_multi_init();\n    if (!multi) {\n        curl_easy_cleanup(easy);\n        return 0;\n    }\n\n    curl_easy_setopt(easy, CURLOPT_URL, url);\n    curl_easy_setopt(easy, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(easy, CURLOPT_FOLLOWLOCATION, 1L);\n    curl_easy_setopt(easy, CURLOPT_MAXREDIRS, 3L);\n    curl_easy_setopt(easy, CURLOPT_TIMEOUT_MS, 100L);\n    curl_easy_setopt(easy, CURLOPT_CONNECTTIMEOUT_MS, 100L);\n\n    CURLMcode mc = curl_multi_add_handle(multi, easy);\n    if (mc != CURLM_OK) {\n        curl_multi_cleanup(multi);\n        curl_easy_cleanup(easy);\n        return 0;\n    }\n\n    int still_running = 0;\n    int max_iterations = 10;\n    do {\n        mc = curl_multi_perform(multi, &still_running);\n        if (mc != CURLM_OK) {\n            break;\n        }\n        if (still_running) {\n            struct timeval timeout;\n            timeout.tv_sec = 0;\n            timeout.tv_usec = 1000;\n            fd_set fdread, fdwrite, fdexcep;\n            FD_ZERO(&fdread);\n            FD_ZERO(&fdwrite);\n            FD_ZERO(&fdexcep);\n            int maxfd = -1;\n            curl_multi_fdset(multi, &fdread, &fdwrite, &fdexcep, &maxfd);\n            if (maxfd >= 0) {\n                select(maxfd + 1, &fdread, &fdwrite, &fdexcep, &timeout);\n            } else {\n                // No file descriptors, just wait a bit\n                usleep(1000);\n            }\n        }\n        max_iterations--;\n    } while (still_running && max_iterations > 0);\n\n    curl_multi_remove_handle(multi, easy);\n    curl_multi_cleanup(multi);\n    curl_easy_cleanup(easy);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":188,"completion_tokens":786,"total_tokens":974,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":60},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}