{"id":"9677feb8-9fcb-4d04-9fb7-7361b84380e8","object":"chat.completion","created":1786351143,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <ares_version.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stddef.h>\n\n#ifdef _WIN32\n#include <winsock2.h>\n#include <ws2tcpip.h>\n#else\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#endif\n\nstatic void addr_callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    int *summary = (int *)arg;\n    struct ares_addrinfo_node *node;\n\n    if (status != ARES_SUCCESS || result == NULL) {\n        if (summary != NULL) {\n            *summary = -1;\n        }\n        if (result != NULL) {\n            ares_freeaddrinfo(result);\n        }\n        return;\n    }\n\n    if (summary != NULL) {\n        *summary = 0;\n    }\n\n    for (node = result->nodes; node != NULL; node = node->ai_next) {\n        if (node->ai_family == AF_INET) {\n            if (summary != NULL) {\n                (*summary)++;\n            }\n        } else if (node->ai_family == AF_INET6) {\n            if (summary != NULL) {\n                (*summary) += 1000;\n            }\n        }\n    }\n\n    ares_freeaddrinfo(result);\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    ares_channel channel;\n    struct ares_options options;\n    int optmask = 0;\n    int status;\n    const char *server_csv;\n    char *hostname;\n    size_t hostname_len;\n    int summary = 0;\n    struct ares_addrinfo_hints hints;\n\n    if (size < 1) {\n        return 0;\n    }\n\n    server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL) {\n        server_csv = \"127.0.0.1\";\n    }\n\n    memset(&options, 0, sizeof(options));\n    optmask = ARES_OPT_FLAGS;\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    status = ares_init_options(&channel, &options, optmask);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    hostname_len = size;\n    if (hostname_len > 255) {\n        hostname_len = 255;\n    }\n    hostname = (char *)malloc(hostname_len + 1);\n    if (hostname == NULL) {\n        ares_destroy(channel);\n        return 0;\n    }\n    memcpy(hostname, data, hostname_len);\n    hostname[hostname_len] = '\\0';\n\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, addr_callback, &summary);\n\n    /* Process events until the callback has been invoked or a bounded time. */\n    for (int i = 0; i < 100; i++) {\n        struct timeval tv;\n        fd_set read_fds, write_fds;\n        int nfds;\n\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            break;\n        }\n\n        tv.tv_sec = 0;\n        tv.tv_usec = 1000;\n        if (select(nfds, &read_fds, &write_fds, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n    }\n\n    ares_destroy(channel);\n    free(hostname);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":914,"total_tokens":1118,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}