{"id":"364d74da-e0dc-499f-96c9-cfc6ef5424f7","object":"chat.completion","created":1786292107,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <unistd.h>\n#include <errno.h>\n\n#define MAX_DATAGRAMS 16\n#define MAX_DATAGRAM_SIZE 2048\n\nstatic int build_datagram(const uint8_t *data, size_t size, uint8_t *out, size_t out_cap) {\n    if (size < 8) return -1;\n    size_t payload_len = size - 8;\n    if (payload_len > out_cap - 42) return -1;\n\n    /* Ethernet header (14 bytes) */\n    memset(out, 0, 14);\n    out[12] = 0x08;\n    out[13] = 0x00;\n\n    /* IPv4 header (20 bytes) */\n    out[14] = 0x45;\n    out[15] = 0x00;\n    uint16_t total_len = 20 + 8 + payload_len;\n    out[16] = (total_len >> 8) & 0xFF;\n    out[17] = total_len & 0xFF;\n    out[18] = 0x00;\n    out[19] = 0x00;\n    out[20] = 0x40;\n    out[21] = 0x00;\n    out[22] = 0x40;\n    out[23] = 17; /* UDP */\n    out[24] = 0x00;\n    out[25] = 0x00;\n    /* src 127.0.0.1 */\n    out[26] = 127;\n    out[27] = 0;\n    out[28] = 0;\n    out[29] = 1;\n    /* dst 127.0.0.1 */\n    out[30] = 127;\n    out[31] = 0;\n    out[32] = 0;\n    out[33] = 1;\n\n    /* UDP header (8 bytes) */\n    out[34] = 0x04;\n    out[35] = 0xD2; /* src port 1234 */\n    out[36] = 0x04;\n    out[37] = 0xD2; /* dst port 1234 */\n    uint16_t udp_len = 8 + payload_len;\n    out[38] = (udp_len >> 8) & 0xFF;\n    out[39] = udp_len & 0xFF;\n    out[40] = 0x00;\n    out[41] = 0x00;\n\n    memcpy(out + 42, data + 8, payload_len);\n    return 42 + payload_len;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    uint8_t datagram[MAX_DATAGRAM_SIZE + 42];\n    int dgram_len = build_datagram(data, size, datagram, sizeof(datagram));\n    if (dgram_len < 0) return 0;\n\n    /* Create loopback capture handle */\n    pcap_t *handle = pcap_create(\"lo\", NULL);\n    if (handle == NULL) return 0;\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    /* Open a UDP socket to send the datagram to loopback */\n    int sock = socket(AF_INET, SOCK_DGRAM, 0);\n    if (sock < 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(1234);\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n\n    /* Send the payload portion (after the 8-byte fuzz header) as a UDP datagram */\n    size_t payload_len = size - 8;\n    if (payload_len > 0) {\n        ssize_t sent = sendto(sock, data + 8, payload_len, 0,\n                              (struct sockaddr *)&addr, sizeof(addr));\n        if (sent < 0) {\n            close(sock);\n            pcap_close(handle);\n            return 0;\n        }\n    }\n\n    /* Capture a bounded number of packets */\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int captured = 0;\n    for (int i = 0; i < MAX_DATAGRAMS; i++) {\n        int ret = pcap_next_ex(handle, &header, &packet_data);\n        if (ret == 1) {\n            /* Inspect the packet: just check it's non-null and has a plausible length */\n            if (header->len > 0 && packet_data != NULL) {\n                captured++;\n            }\n        } else if (ret == 0) {\n            /* Timeout, continue */\n            continue;\n        } else {\n            /* Error or EOF */\n            break;\n        }\n    }\n\n    close(sock);\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":180,"completion_tokens":1167,"total_tokens":1347,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":52},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}