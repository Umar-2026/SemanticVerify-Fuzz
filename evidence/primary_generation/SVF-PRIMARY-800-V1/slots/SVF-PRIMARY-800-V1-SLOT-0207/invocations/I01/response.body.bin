{"id":"53096a12-1d31-464b-abe1-8def3e454693","object":"chat.completion","created":1786292441,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Create a temporary file with a bounded portion of the fuzz data.\n    char template[] = \"/tmp/curl_fuzz_XXXXXX\";\n    int fd = mkstemp(template);\n    if (fd == -1) {\n        return 0;\n    }\n\n    // Limit file content to at most 4096 bytes.\n    size_t write_size = size > 4096 ? 4096 : size;\n    ssize_t written = write(fd, data, write_size);\n    if (written < 0) {\n        close(fd);\n        unlink(template);\n        return 0;\n    }\n    close(fd);\n\n    // Build file:// URL.\n    char url[512];\n    snprintf(url, sizeof(url), \"file://%s\", template);\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        unlink(template);\n        return 0;\n    }\n\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 1000L);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, 1000L);\n\n    CURLcode res = curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n    unlink(template);\n\n    (void)res;\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":178,"completion_tokens":467,"total_tokens":645,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":50},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_2026040