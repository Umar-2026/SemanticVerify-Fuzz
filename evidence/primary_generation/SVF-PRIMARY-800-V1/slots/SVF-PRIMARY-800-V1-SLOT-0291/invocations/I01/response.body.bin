{"id":"d6670487-ea4b-4e0b-a377-2bfc6c4e8ce1","object":"chat.completion","created":1786292765,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <curl/curl.h>\n\nstatic size_t write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    size_t total = size * nmemb;\n    unsigned char *buf = (unsigned char *)userdata;\n    /* The buffer is 4096 bytes, we just ignore overflow for fuzzing */\n    if (total > 4096) total = 4096;\n    memcpy(buf, ptr, total);\n    return total;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    CURL *curl = NULL;\n    CURLcode res;\n    char url[128];\n    unsigned char outbuf[4096];\n    size_t i;\n\n    if (size < 1) return 0;\n\n    /* Initialize libcurl */\n    if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) {\n        return 0;\n    }\n\n    curl = curl_easy_init();\n    if (!curl) {\n        curl_global_cleanup();\n        return 0;\n    }\n\n    /* Build a local file URL from fuzz data (bounded) */\n    snprintf(url, sizeof(url), \"file:///tmp/fuzz_%u\", (unsigned)data[0]);\n    for (i = 1; i < size && i < 100; i++) {\n        /* Use some bytes to vary the path, but keep it simple */\n        if (data[i] == '\\0') break;\n        /* We just append a hex char to the filename */\n        snprintf(url + strlen(url), sizeof(url) - strlen(url), \"%02x\", data[i]);\n    }\n\n    /* Set options */\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_cb);\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, outbuf);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, 1000L);\n\n    /* Perform the transfer */\n    res = curl_easy_perform(curl);\n\n    /* Cleanup */\n    curl_easy_cleanup(curl);\n    curl_global_cleanup();\n\n    return 0;\n}"},"logprobs":null,"finish_reason":