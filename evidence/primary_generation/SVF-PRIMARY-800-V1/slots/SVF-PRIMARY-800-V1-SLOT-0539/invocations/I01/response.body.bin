nsigned int x = 0; x < img->d_w; x++) {\n                            sum += row[x];\n                        }\n                    }\n                }\n            }\n            (void)sum;\n        }\n\n        ptr += cur_size;\n        remaining -= cur_size;\n    }\n\n    // Flush decoder\n    vpx_codec_decode(&codec_ctx, NULL, 0, NULL, 0);\n    vpx_codec_iter_t iter = NULL;\n    vpx_image_t *img;\n    while ((img = vpx_codec_get_frame(&codec_ctx, &iter)) != NULL) {\n        // Consume frame data\n        volatile uint8_t sum = 0;\n        for (int plane = 0; plane < 3; plane++) {\n            if (img->planes[plane] && img->d_w && img->d_h) {\n                for (unsigned int y = 0; y < img->d_h; y++) {\n                    const uint8_t *row = img->planes[plane] + y * img->stride[plane];\n                    for (unsigned int x = 0; x < img->d_w; x++) {\n                        sum += row[x];\n                    }\n                }\n            }\n        }\n        (void)sum;\n    }\n\n    vpx_codec_destroy(&codec_ctx);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":170,"completion_tokens":822,"total_tokens":992,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":42},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}