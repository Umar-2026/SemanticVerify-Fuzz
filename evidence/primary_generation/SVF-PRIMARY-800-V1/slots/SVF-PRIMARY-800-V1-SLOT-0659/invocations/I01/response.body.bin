{"id":"1f47fa3a-4a57-4492-9bc0-dd23f145fda0","object":"chat.completion","created":1786351180,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <ares_version.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stddef.h>\n\n#ifdef _WIN32\n#include <winsock2.h>\n#include <ws2tcpip.h>\n#else\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#endif\n\nstatic void callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    int *count = (int *)arg;\n    if (status == ARES_SUCCESS && result != NULL) {\n        struct ares_addrinfo_node *node = result->nodes;\n        while (node != NULL) {\n            if (node->ai_family == AF_INET || node->ai_family == AF_INET6) {\n                (*count)++;\n            }\n            node = node->ai_next;\n        }\n    }\n    if (result != NULL) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    // Use the first byte to select a hostname length (bounded)\n    size_t host_len = data[0] % 64;\n    if (size < 1 + host_len) return 0;\n\n    char hostname[65];\n    memcpy(hostname, data + 1, host_len);\n    hostname[host_len] = '\\0';\n\n    // Ensure hostname is not empty and doesn't contain spaces or control chars\n    if (host_len == 0) return 0;\n    for (size_t i = 0; i < host_len; i++) {\n        if (hostname[i] <= 0x20 || hostname[i] == 0x7f) return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL || server_csv[0] == '\\0') return 0;\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    int status = ares_init_options(&channel, &options, ARES_OPT_FLAGS);\n    if (status != ARES_SUCCESS) return 0;\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    int count = 0;\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, callback, &count);\n\n    // Process events for a bounded time (e.g., up to 1000 iterations or 1 second)\n    int max_events = 1000;\n    while (max_events-- > 0) {\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 1000; // 1 ms\n        fd_set read_fds, write_fds;\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        int nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) break;\n        if (select(nfds, &read_fds, &write_fds, NULL, &tv) < 0) break;\n        ares_process(channel, &read_fds, &write_fds);\n    }\n\n    ares_destroy(channel);\n\n    // Use the count to produce a deterministic output (e.g., return it as a checksum)\n    // This ensures the result is \"used\" and the fuzzer can observe coverage.\n    if (count > 0) {\n        // Simple side effect: write to a volatile to prevent optimization\n        volatile int sink = count;\n        (void)sink;\n    }\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":921,"total_tokens":1125,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}