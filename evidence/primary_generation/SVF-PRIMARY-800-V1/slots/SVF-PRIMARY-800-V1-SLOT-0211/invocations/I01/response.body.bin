{"id":"9705ec77-229e-467f-9902-a8ee1c8e498d","object":"chat.completion","created":1786292453,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <curl/curl.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        return 0;\n    }\n\n    // Use input to derive a local file path (bounded, no path traversal)\n    char path[64];\n    size_t path_len = size < sizeof(path) - 1 ? size : sizeof(path) - 1;\n    memcpy(path, data, path_len);\n    path[path_len] = '\\0';\n\n    // Ensure it's a file:// URL\n    char url[128];\n    snprintf(url, sizeof(url), \"file://%s\", path);\n\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, NULL);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);\n    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 1000L);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, 1000L);\n\n    // Use a small portion of input to set a buffer size option if present\n    if (size > 1) {\n        long buffer_size = (long)(data[1] % 4096) + 1;\n        curl_easy_setopt(curl, CURLOPT_BUFFERSIZE, buffer_size);\n    }\n\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":179,"completion_tokens":457,"total_tokens":636,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":51},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}