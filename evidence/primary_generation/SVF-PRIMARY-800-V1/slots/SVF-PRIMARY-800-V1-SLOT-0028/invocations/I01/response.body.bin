            "text": "#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cstdint.h\u003e\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 2) {\n        return 0;\n    }\n\n    z_stream strm;\n    memset(&strm, 0, sizeof(strm));\n\n    /* Use the first byte to determine the windowBits for decompression mode */\n    /* 15 + 16 = 31 (gzip), 15 (zlib), -15 (raw) */\n    int windowBits;\n    uint8_t mode_selector = data[0] % 3;\n    if (mode_selector == 0) {\n        windowBits = 15 + 16;\n    } else if (mode_selector == 1) {\n        windowBits = 15;\n    } else {\n        windowBits = -15;\n    }\n\n    if (inflateInit2(&strm, windowBits) != Z_OK) {\n        return 0;\n    }\n\n    uint8_t buffer[1024];\n    strm.next_in = (Bytef *)(data + 1);\n    strm.avail_in = (uInt)(size - 1);\n\n    /* Streaming decompression loop */\n    do {\n        strm.next_out = buffer;\n        strm.avail_out = sizeof(buffer);\n        \n        int ret = inflate(&strm, Z_NO_FLUSH);\n        \n        if (ret == Z_STREAM_END || ret == Z_DATA_ERROR || ret == Z_MEM_ERROR) {\n            break;\n        }\n    } while (strm.avail_out == 0);\n\n    inflateEnd(&strm);\n    return 0;\n}",
