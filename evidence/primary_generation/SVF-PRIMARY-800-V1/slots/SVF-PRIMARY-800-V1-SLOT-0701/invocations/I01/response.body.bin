{"id":"9c687f54-94f8-495b-86a9-a9b645e729a8","object":"chat.completion","created":1786351359,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include \"lcms2.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size == 0) {\n        return 0;\n    }\n\n    cmsHPROFILE hProfile = cmsOpenProfileFromMem(data, size);\n    if (hProfile == NULL) {\n        return 0;\n    }\n\n    // Inspect basic profile information\n    char buffer[256];\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoManufacturer, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoModel, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoCopyright, \"en\", \"US\", buffer, sizeof(buffer));\n\n    cmsColorSpaceSignature colorSpace = cmsGetColorSpace(hProfile);\n    cmsColorSpaceSignature pcs = cmsGetPCS(hProfile);\n    cmsUInt32Number version = cmsGetProfileVersion(hProfile);\n    cmsUInt32Number deviceClass = cmsGetDeviceClass(hProfile);\n    cmsUInt32Number renderingIntent = cmsGetHeaderRenderingIntent(hProfile);\n    cmsUInt32Number flags = cmsGetHeaderFlags(hProfile);\n    cmsUInt32Number manufacturer = cmsGetHeaderManufacturer(hProfile);\n    cmsUInt32Number model = cmsGetHeaderModel(hProfile);\n    cmsUInt32Number attributes = cmsGetHeaderAttributes(hProfile);\n    cmsUInt32Number creator = cmsGetHeaderCreator(hProfile);\n\n    // Inspect tags\n    cmsUInt32Number tagCount = cmsGetTagCount(hProfile);\n    for (cmsUInt32Number i = 0; i < tagCount; i++) {\n        cmsTagSignature sig = cmsGetTagSignature(hProfile, i);\n        cmsUInt32Number tagSize = cmsReadRawTag(hProfile, sig, NULL, 0);\n        if (tagSize > 0 && tagSize < 1024 * 1024) {\n            void *tagData = malloc(tagSize);\n            if (tagData) {\n                cmsReadRawTag(hProfile, sig, tagData, tagSize);\n                free(tagData);\n            }\n        }\n    }\n\n    // Inspect profile ID\n    cmsUInt8Number profileID[16];\n    cmsGetHeaderProfileID(hProfile, profileID);\n\n    // Inspect chromatic adaptation if available\n    cmsCIEXYZ illuminant;\n    cmsGetIlluminant(hProfile, &illuminant);\n\n    // Inspect media white point if available\n    cmsCIEXYZ mediaWhitePoint;\n    cmsGetMediaWhitePoint(hProfile, &mediaWhitePoint);\n\n    // Inspect intent tables\n    for (cmsUInt32Number intent = 0; intent < 4; intent++) {\n        cmsUInt32Number nTransforms = cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", NULL, 0);\n        if (nTransforms > 0) {\n            cmsToneCurve *curve = cmsReadTag(hProfile, cmsSigRedTRCTag);\n            if (curve) {\n                cmsFreeToneCurve(curve);\n            }\n        }\n    }\n\n    // Inspect colorants if present\n    cmsCIEXYZ redColorant, greenColorant, blueColorant;\n    if (cmsReadTag(hProfile, cmsSigRedColorantTag)) {\n        cmsReadTag(hProfile, cmsSigRedColorantTag);\n    }\n    if (cmsReadTag(hProfile, cmsSigGreenColorantTag)) {\n        cmsReadTag(hProfile, cmsSigGreenColorantTag);\n    }\n    if (cmsReadTag(hProfile, cmsSigBlueColorantTag)) {\n        cmsReadTag(hProfile, cmsSigBlueColorantTag);\n    }\n\n    // Inspect LUT tags if present\n    cmsPipeline *lut = cmsReadTag(hProfile, cmsSigAToB0Tag);\n    if (lut) {\n        cmsPipelineFree(lut);\n    }\n    lut = cmsReadTag(hProfile, cmsSigBToA0Tag);\n    if (lut) {\n        cmsPipelineFree(lut);\n    }\n\n    // Inspect gamut tag if present\n    cmsPipeline *gamut = cmsReadTag(hProfile, cmsSigGamutTag);\n    if (gamut) {\n        cmsPipelineFree(gamut);\n    }\n\n    // Inspect profile sequence description if present\n    cmsSEQ *seq = cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);\n    if (seq) {\n        cmsFreeProfileSequenceDescription(seq);\n    }\n\n    // Inspect named color list if present\n    cmsNAMEDCOLORLIST *namedColors = cmsReadTag(hProfile, cmsSigNamedColor2Tag);\n    if (namedColors) {\n        cmsFreeNamedColorList(namedColors);\n    }\n\n    // Inspect viewing conditions if present\n    cmsVC *viewingConditions = cmsReadTag(hProfile, cmsSigViewingConditionsTag);\n    if (viewingConditions) {\n        cmsFreeViewingConditions(viewingConditions);\n    }\n\n    // Inspect chromatic adaptation matrix if present\n    cmsMAT3 *adaptation = cmsReadTag(hProfile, cmsSigChromaticAdaptationTag);\n    if (adaptation) {\n        // No free needed for MAT3, just read\n    }\n\n    // Inspect colorant table if present\n    cmsUInt32Number colorantCount = cmsGetColorantCount(hProfile);\n    if (colorantCount > 0) {\n        cmsUInt16Number colorant[3];\n        for (cmsUInt32Number i = 0; i < colorantCount; i++) {\n            cmsGetColorant(hProfile, i, colorant);\n        }\n    }\n\n    // Inspect profile sequence ID if present\n    cmsUInt32Number seqIDCount = cmsGetProfileSequenceIDCount(hProfile);\n    if (seqIDCount > 0) {\n        cmsUInt8Number seqID[16];\n        for (cmsUInt32Number i = 0; i < seqIDCount; i++) {\n            cmsGetProfileSequenceID(hProfile, i, seqID);\n        }\n    }\n\n    // Inspect profile description\n    cmsUInt32Number descSize = cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", NULL, 0);\n    if (descSize > 0 && descSize < 4096) {\n        char *desc = malloc(descSize);\n        if (desc) {\n            cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", desc, descSize);\n            free(desc);\n        }\n    }\n\n    // Inspect copyright\n    cmsUInt32Number copyrightSize = cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", NULL, 0);\n    if (copyrightSize > 0 && copyrightSize < 4096) {\n        char *copyright = malloc(copyrightSize);\n        if (copyright) {\n            cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", copyright, copyrightSize);\n            free(copyright);\n        }\n    }\n\n    // Inspect manufacturer and model strings\n    cmsUInt32Number manufacturerSize = cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", NULL, 0);\n    if (manufacturerSize > 0 && manufacturerSize < 4096) {\n        char *manufacturerStr = malloc(manufacturerSize);\n        if (manufacturerStr) {\n            cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", manufacturerStr, manufacturerSize);\n            free(manufacturerStr);\n        }\n    }\n\n    cmsUInt32Number modelSize = cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", NULL, 0);\n    if (modelSize > 0 && modelSize < 4096) {\n        char *modelStr = malloc(modelSize);\n        if (modelStr) {\n            cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", modelStr, modelSize);\n            free(modelStr);\n        }\n    }\n\n    // Inspect rendering intent gamut\n    cmsUInt32Number gamutIntent = cmsGetHeaderRenderingIntent(hProfile);\n\n    // Inspect profile connection space\n    cmsUInt32Number pcsType = cmsGetPCS(hProfile);\n\n    // Inspect color space\n    cmsUInt32Number colorSpaceType = cmsGetColorSpace(hProfile);\n\n    // Inspect device class\n    cmsUInt32Number deviceClassType = cmsGetDeviceClass(hProfile);\n\n    // Inspect version\n    cmsFloat64Number versionFloat = cmsGetProfileVersion(hProfile);\n\n    // Inspect flags\n    cmsUInt32Number flagsValue = cmsGetHeaderFlags(hProfile);\n\n    // Inspect attributes\n    cmsUInt64Number attributesValue = cmsGetHeaderAttributes(hProfile);\n\n    // Inspect creator\n    cmsUInt32Number creatorValue = cmsGetHeaderCreator(hProfile);\n\n    // Inspect manufacturer\n    cmsUInt32Number manufacturerValue = cmsGetHeaderManufacturer(hProfile);\n\n    // Inspect model\n    cmsUInt32Number modelValue = cmsGetHeaderModel(hProfile);\n\n    // Inspect illuminant\n    cmsCIEXYZ illuminantValue;\n    cmsGetIlluminant(hProfile, &illuminantValue);\n\n    // Inspect media white point\n    cmsCIEXYZ mediaWhitePointValue;\n    cmsGetMediaWhitePoint(hProfile, &mediaWhitePointValue);\n\n    // Inspect media black point if available\n    cmsCIEXYZ mediaBlackPoint;\n    cmsGetMediaBlackPoint(hProfile, &mediaBlackPoint);\n\n    // Inspect luminance\n    cmsFloat64Number luminance = cmsGetLuminance(hProfile);\n\n    // Inspect chromatic adaptation matrix\n    cmsMAT3 chromaticAdaptation;\n    cmsGetChromaticAdaptation(hProfile, &chromaticAdaptation);\n\n    // Inspect colorant tags\n    cmsCIEXYZ redColorantValue, greenColorantValue, blueColorantValue;\n    cmsGetColorant(hProfile, 0, NULL);\n    cmsGetColorant(hProfile, 1, NULL);\n    cmsGetColorant(hProfile, 2, NULL);\n\n    // Inspect profile ID\n    cmsUInt8Number profileIDValue[16];\n    cmsGetHeaderProfileID(hProfile, profileIDValue);\n\n    // Inspect tag signatures\n    for (cmsUInt32Number i = 0; i < tagCount; i++) {\n        cmsTagSignature sig = cmsGetTagSignature(hProfile, i);\n        cmsUInt32Number size = cmsReadRawTag(hProfile, sig, NULL, 0);\n        if (size > 0 && size < 1024 * 1024) {\n            void *data = malloc(size);\n            if (data) {\n                cmsReadRawTag(hProfile, sig, data, size);\n                free(data);\n            }\n        }\n    }\n\n    // Inspect profile sequence description\n    cmsSEQ *seqDesc = cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);\n    if (seqDesc) {\n        cmsFreeProfileSequenceDescription(seqDesc);\n    }\n\n    // Inspect named color list\n    cmsNAMEDCOLORLIST *namedColorList = cmsReadTag(hProfile, cmsSigNamedColor2Tag);\n    if (namedColorList) {\n        cmsFreeNamedColorList(namedColorList);\n    }\n\n    // Inspect viewing conditions\n    cmsVC *viewingCond = cmsReadTag(hProfile, cmsSigViewingConditionsTag);\n    if (viewingCond) {\n        cmsFreeViewingConditions(viewingCond);\n    }\n\n    // Inspect gamut tag\n    cmsPipeline *gamutPipeline = cmsReadTag(hProfile, cmsSigGamutTag);\n    if (gamutPipeline) {\n        cmsPipelineFree(gamutPipeline);\n    }\n\n    // Inspect AToB and BToA tags\n    cmsPipeline *aToB0 = cmsReadTag(hProfile, cmsSigAToB0Tag);\n    if (aToB0) {\n        cmsPipelineFree(aToB0);\n    }\n    cmsPipeline *bToA0 = cmsReadTag(hProfile, cmsSigBToA0Tag);\n    if (bToA0) {\n        cmsPipelineFree(bToA0);\n    }\n\n    // Inspect TRC tags\n    cmsToneCurve *redTRC = cmsReadTag(hProfile, cmsSigRedTRCTag);\n    if (redTRC) {\n        cmsFreeToneCurve(redTRC);\n    }\n    cmsToneCurve *greenTRC = cmsReadTag(hProfile, cmsSigGreenTRCTag);\n    if (greenTRC) {\n        cmsFreeToneCurve(greenTRC);\n    }\n    cmsToneCurve *blueTRC = cmsReadTag(hProfile, cmsSigBlueTRCTag);\n    if (blueTRC) {\n        cmsFreeToneCurve(blueTRC);\n    }\n    cmsToneCurve *grayTRC = cmsReadTag(hProfile, cmsSigGrayTRCTag);\n    if (grayTRC) {\n        cmsFreeToneCurve(grayTRC);\n    }\n\n    // Inspect colorant tags\n    cmsCIEXYZ *redColorantTag = cmsReadTag(hProfile, cmsSigRedColorantTag);\n    if (redColorantTag) {\n        // No free needed\n    }\n    cmsCIEXYZ *greenColorantTag = cmsReadTag(hProfile, cmsSigGreenColorantTag);\n    if (greenColorantTag) {\n        // No free needed\n    }\n    cmsCIEXYZ *blueColorantTag = cmsReadTag(hProfile, cmsSigBlueColorantTag);\n    if (blueColorantTag) {\n        // No free needed\n    }\n\n    // Inspect chromatic adaptation tag\n    cmsMAT3 *chromaticAdaptationTag = cmsReadTag(hProfile, cmsSigChromaticAdaptationTag);\n    if (chromaticAdaptationTag) {\n        // No free needed\n    }\n\n    // Inspect profile sequence ID\n    cmsUInt32Number seqIDCountValue = cmsGetProfileSequenceIDCount(hProfile);\n    if (seqIDCountValue > 0) {\n        cmsUInt8Number seqIDValue[16];\n        for (cmsUInt32Number i = 0; i < seqIDCountValue; i++) {\n            cmsGetProfileSequenceID(hProfile, i, seqIDValue);\n        }\n    }\n\n    // Inspect colorant count\n    cmsUInt32Number colorantCountValue = cmsGetColorantCount(hProfile);\n    if (colorantCountValue > 0) {\n        cmsUInt16Number colorantValue[3];\n        for (cmsUInt32Number i = 0; i < colorantCountValue; i++) {\n            cmsGetColorant(hProfile, i, colorantValue);\n        }\n    }\n\n    // Inspect profile info in various languages\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"es\", \"ES\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"fr\", \"FR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"de\", \"DE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"ja\", \"JP\", buffer, sizeof(buffer));\n\n    // Inspect profile info with different types\n    cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", buffer, sizeof(buffer));\n\n    // Inspect profile ID\n    cmsGetHeaderProfileID(hProfile, profileID);\n\n    // Inspect header fields\n    cmsUInt32Number headerFlags = cmsGetHeaderFlags(hProfile);\n    cmsUInt32Number headerManufacturer = cmsGetHeaderManufacturer(hProfile);\n    cmsUInt32Number headerModel = cmsGetHeaderModel(hProfile);\n    cmsUInt64Number headerAttributes = cmsGetHeaderAttributes(hProfile);\n    cmsUInt32Number headerCreator = cmsGetHeaderCreator(hProfile);\n    cmsUInt32Number headerRenderingIntent = cmsGetHeaderRenderingIntent(hProfile);\n    cmsUInt32Number headerDeviceClass = cmsGetDeviceClass(hProfile);\n    cmsUInt32Number headerColorSpace = cmsGetColorSpace(hProfile);\n    cmsUInt32Number headerPCS = cmsGetPCS(hProfile);\n    cmsFloat64Number headerVersion = cmsGetProfileVersion(hProfile);\n\n    // Inspect illuminant\n    cmsCIEXYZ illuminantXYZ;\n    cmsGetIlluminant(hProfile, &illuminantXYZ);\n\n    // Inspect media white point\n    cmsCIEXYZ mediaWhitePointXYZ;\n    cmsGetMediaWhitePoint(hProfile, &mediaWhitePointXYZ);\n\n    // Inspect media black point\n    cmsCIEXYZ mediaBlackPointXYZ;\n    cmsGetMediaBlackPoint(hProfile, &mediaBlackPointXYZ);\n\n    // Inspect luminance\n    cmsFloat64Number luminanceValue = cmsGetLuminance(hProfile);\n\n    // Inspect chromatic adaptation\n    cmsMAT3 chromaticAdaptationMatrix;\n    cmsGetChromaticAdaptation(hProfile, &chromaticAdaptationMatrix);\n\n    // Inspect colorants\n    cmsUInt16Number colorantValues[3];\n    cmsGetColorant(hProfile, 0, colorantValues);\n    cmsGetColorant(hProfile, 1, colorantValues);\n    cmsGetColorant(hProfile, 2, colorantValues);\n\n    // Inspect profile sequence ID\n    cmsUInt32Number seqIDCountFinal = cmsGetProfileSequenceIDCount(hProfile);\n    if (seqIDCountFinal > 0) {\n        cmsUInt8Number seqIDFinal[16];\n        for (cmsUInt32Number i = 0; i < seqIDCountFinal; i++) {\n            cmsGetProfileSequenceID(hProfile, i, seqIDFinal);\n        }\n    }\n\n    // Inspect tag count and signatures\n    cmsUInt32Number tagCountFinal = cmsGetTagCount(hProfile);\n    for (cmsUInt32Number i = 0; i < tagCountFinal; i++) {\n        cmsTagSignature sig = cmsGetTagSignature(hProfile, i);\n        cmsUInt32Number tagSizeFinal = cmsReadRawTag(hProfile, sig, NULL, 0);\n        if (tagSizeFinal > 0 && tagSizeFinal < 1024 * 1024) {\n            void *tagDataFinal = malloc(tagSizeFinal);\n            if (tagDataFinal) {\n                cmsReadRawTag(hProfile, sig, tagDataFinal, tagSizeFinal);\n                free(tagDataFinal);\n            }\n        }\n    }\n\n    // Inspect profile description\n    cmsUInt32Number descSizeFinal = cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", NULL, 0);\n    if (descSizeFinal > 0 && descSizeFinal < 4096) {\n        char *descFinal = malloc(descSizeFinal);\n        if (descFinal) {\n            cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", descFinal, descSizeFinal);\n            free(descFinal);\n        }\n    }\n\n    // Inspect copyright\n    cmsUInt32Number copyrightSizeFinal = cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", NULL, 0);\n    if (copyrightSizeFinal > 0 && copyrightSizeFinal < 4096) {\n        char *copyrightFinal = malloc(copyrightSizeFinal);\n        if (copyrightFinal) {\n            cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", copyrightFinal, copyrightSizeFinal);\n            free(copyrightFinal);\n        }\n    }\n\n    // Inspect manufacturer\n    cmsUInt32Number manufacturerSizeFinal = cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", NULL, 0);\n    if (manufacturerSizeFinal > 0 && manufacturerSizeFinal < 4096) {\n        char *manufacturerFinal = malloc(manufacturerSizeFinal);\n        if (manufacturerFinal) {\n            cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", manufacturerFinal, manufacturerSizeFinal);\n            free(manufacturerFinal);\n        }\n    }\n\n    // Inspect model\n    cmsUInt32Number modelSizeFinal = cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", NULL, 0);\n    if (modelSizeFinal > 0 && modelSizeFinal < 4096) {\n        char *modelFinal = malloc(modelSizeFinal);\n        if (modelFinal) {\n            cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", modelFinal, modelSizeFinal);\n            free(modelFinal);\n        }\n    }\n\n    // Inspect profile sequence description\n    cmsSEQ *seqDescFinal = cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);\n    if (seqDescFinal) {\n        cmsFreeProfileSequenceDescription(seqDescFinal);\n    }\n\n    // Inspect named color list\n    cmsNAMEDCOLORLIST *namedColorListFinal = cmsReadTag(hProfile, cmsSigNamedColor2Tag);\n    if (namedColorListFinal) {\n        cmsFreeNamedColorList(namedColorListFinal);\n    }\n\n    // Inspect viewing conditions\n    cmsVC *viewingConditionsFinal = cmsReadTag(hProfile, cmsSigViewingConditionsTag);\n    if (viewingConditionsFinal) {\n        cmsFreeViewingConditions(viewingConditionsFinal);\n    }\n\n    // Inspect gamut tag\n    cmsPipeline *gamutFinal = cmsReadTag(hProfile, cmsSigGamutTag);\n    if (gamutFinal) {\n        cmsPipelineFree(gamutFinal);\n    }\n\n    // Inspect AToB and BToA tags\n    cmsPipeline *aToBFinal = cmsReadTag(hProfile, cmsSigAToB0Tag);\n    if (aToBFinal) {\n        cmsPipelineFree(aToBFinal);\n    }\n    cmsPipeline *bToAFinal = cmsReadTag(hProfile, cmsSigBToA0Tag);\n    if (bToAFinal) {\n        cmsPipelineFree(bToAFinal);\n    }\n\n    // Inspect TRC tags\n    cmsToneCurve *redTRCFinal = cmsReadTag(hProfile, cmsSigRedTRCTag);\n    if (redTRCFinal) {\n        cmsFreeToneCurve(redTRCFinal);\n    }\n    cmsToneCurve *greenTRCFinal = cmsReadTag(hProfile, cmsSigGreenTRCTag);\n    if (greenTRCFinal) {\n        cmsFreeToneCurve(greenTRCFinal);\n    }\n    cmsToneCurve *blueTRCFinal = cmsReadTag(hProfile, cmsSigBlueTRCTag);\n    if (blueTRCFinal) {\n        cmsFreeToneCurve(blueTRCFinal);\n    }\n    cmsToneCurve *grayTRCFinal = cmsReadTag(hProfile, cmsSigGrayTRCTag);\n    if (grayTRCFinal) {\n        cmsFreeToneCurve(grayTRCFinal);\n    }\n\n    // Inspect colorant tags\n    cmsCIEXYZ *redColorantFinal = cmsReadTag(hProfile, cmsSigRedColorantTag);\n    if (redColorantFinal) {\n        // No free needed\n    }\n    cmsCIEXYZ *greenColorantFinal = cmsReadTag(hProfile, cmsSigGreenColorantTag);\n    if (greenColorantFinal) {\n        // No free needed\n    }\n    cmsCIEXYZ *blueColorantFinal = cmsReadTag(hProfile, cmsSigBlueColorantTag);\n    if (blueColorantFinal) {\n        // No free needed\n    }\n\n    // Inspect chromatic adaptation tag\n    cmsMAT3 *chromaticAdaptationFinal = cmsReadTag(hProfile, cmsSigChromaticAdaptationTag);\n    if (chromaticAdaptationFinal) {\n        // No free needed\n    }\n\n    // Inspect profile sequence ID\n    cmsUInt32Number seqIDCountFinal2 = cmsGetProfileSequenceIDCount(hProfile);\n    if (seqIDCountFinal2 > 0) {\n        cmsUInt8Number seqIDFinal2[16];\n        for (cmsUInt32Number i = 0; i < seqIDCountFinal2; i++) {\n            cmsGetProfileSequenceID(hProfile, i, seqIDFinal2);\n        }\n    }\n\n    // Inspect colorant count\n    cmsUInt32Number colorantCountFinal = cmsGetColorantCount(hProfile);\n    if (colorantCountFinal > 0) {\n        cmsUInt16Number colorantFinal[3];\n        for (cmsUInt32Number i = 0; i < colorantCountFinal; i++) {\n            cmsGetColorant(hProfile, i, colorantFinal);\n        }\n    }\n\n    // Inspect profile info in various languages\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"es\", \"ES\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"fr\", \"FR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"de\", \"DE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile, cmsInfoDescription, \"ja\", \"JP\", buffer, sizeof(buffer));\n\n    // Inspect profile info with different types\n    cmsGetProfileInfo(hProfile, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoManufacturer, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoModel, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfo(hProfile, cmsInfoCopyright, \"en\", \"US\", buffer, sizeof(buffer));\n\n    // Inspect profile ID\n    cmsGetHeaderProfileID(hProfile, profileID);\n\n    // Inspect header fields\n    cmsUInt32Number headerFlagsFinal = cmsGetHeaderFlags(hProfile);\n    cmsUInt32Number headerManufacturerFinal = cmsGetHeaderManufacturer(hProfile);\n    cmsUInt32Number headerModelFinal = cmsGetHeaderModel(hProfile);\n    cmsUInt64Number headerAttributesFin