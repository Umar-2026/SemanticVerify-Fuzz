{"id":"a7b0ceca-c630-4fae-a723-826ae86b4edf","object":"chat.completion","created":1786351020,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stddef.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <sys/time.h>\n#endif\n\ntypedef struct {\n    int pending;\n    int failures;\n    int successes;\n    int total;\n} query_state;\n\nstatic void dns_callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    query_state *qs = (query_state *)arg;\n    qs->pending--;\n\n    if (status == ARES_SUCCESS && result != NULL) {\n        qs->successes++;\n        ares_freeaddrinfo(result);\n    } else {\n        qs->failures++;\n    }\n}\n\nstatic void process_events(ares_channel channel) {\n    int nfds, count;\n    fd_set readers, writers;\n    struct timeval tv, *tvp;\n    time_t now;\n\n    for (;;) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        nfds = ares_fds(channel, &readers, &writers);\n        if (nfds == 0) {\n            break;\n        }\n\n        tvp = ares_timeout(channel, NULL, &tv);\n        if (tvp == NULL) {\n            tv.tv_sec = 0;\n            tv.tv_usec = 100000;\n            tvp = &tv;\n        }\n\n        count = select(nfds, &readers, &writers, NULL, tvp);\n        if (count < 0) {\n            break;\n        }\n\n        ares_process(channel, &readers, &writers);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    if (size < 1) {\n        return 0;\n    }\n\n    /* Bound the number of lookups to avoid excessive work */\n    size_t max_lookups = 16;\n    size_t num_lookups = (size_t)data[0] % max_lookups + 1;\n\n    /* Extract hostname candidates from fuzz input, bounded */\n    char hostname[256];\n    size_t host_len = size - 1;\n    if (host_len > sizeof(hostname) - 1) {\n        host_len = sizeof(hostname) - 1;\n    }\n    memcpy(hostname, data + 1, host_len);\n    hostname[host_len] = '\\0';\n\n    /* Ensure hostname is non-empty and printable-ish */\n    if (host_len == 0) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    options.timeout = 2000;\n    options.tries = 1;\n\n    int status = ares_init_options(&channel, &options, ARES_OPT_FLAGS | ARES_OPT_TIMEOUT | ARES_OPT_TRIES);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    query_state qs;\n    memset(&qs, 0, sizeof(qs));\n    qs.total = (int)num_lookups;\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    for (size_t i = 0; i < num_lookups; i++) {\n        qs.pending++;\n        ares_getaddrinfo(channel, hostname, NULL, &hints, dns_callback, &qs);\n    }\n\n    process_events(channel);\n\n    ares_destroy(channel);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":919,"total_tokens":1123,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}