{"id":"af28bb7a-f666-4c44-8e7c-59f9959207b0","object":"chat.completion","created":1786350892,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n\nstatic void sleep_ms(int ms) {\n#ifdef _WIN32\n    Sleep(ms);\n#else\n    usleep(ms * 1000);\n#endif\n}\n\nstatic void getaddrinfo_callback(void *arg, int status, struct ares_addrinfo *result) {\n    (void)arg;\n    if (status == ARES_SUCCESS && result) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (!server_csv || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    if (ares_init_options(&channel, &options, 0) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    if (ares_set_servers_csv(channel, server_csv) != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    /* Derive a bounded hostname from fuzz input. */\n    char hostname[256];\n    size_t len = size < sizeof(hostname) - 1 ? size : sizeof(hostname) - 1;\n    memcpy(hostname, data, len);\n    hostname[len] = '\\0';\n\n    /* Ensure the hostname is NUL-terminated and printable-ish. */\n    for (size_t i = 0; i < len; i++) {\n        if (hostname[i] == '\\0' || hostname[i] == '\\n' || hostname[i] == '\\r') {\n            hostname[i] = '.';\n        }\n    }\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, getaddrinfo_callback, NULL);\n\n    /* Run the event loop with a bounded timeout. */\n    int nfds;\n    fd_set readers, writers;\n    struct timeval tv, *tvp;\n    int total_wait_ms = 0;\n    const int max_wait_ms = 5000;\n\n    while (total_wait_ms < max_wait_ms) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        nfds = ares_fds(channel, &readers, &writers);\n        if (nfds == 0) {\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000; /* 100 ms */\n        tvp = &tv;\n        if (select(nfds, &readers, &writers, NULL, tvp) < 0) {\n            break;\n        }\n        ares_process(channel, &readers, &writers);\n        total_wait_ms += 100;\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":206,"completion_tokens":756,"total_tokens":962,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":78},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}