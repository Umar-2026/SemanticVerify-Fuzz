{"id":"4188f555-cebe-492f-8011-8a8e278150cd","object":"chat.completion","created":1786292323,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <net/if.h>\n#include <errno.h>\n\n#define BUF_SIZE 65536\n\nstatic void emit_udp_packet(void) {\n    int fd = socket(AF_INET, SOCK_DGRAM, 0);\n    if (fd < 0) return;\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(9999);\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    const char *payload = \"hello\";\n    sendto(fd, payload, strlen(payload), 0, (struct sockaddr *)&addr, sizeof(addr));\n    close(fd);\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    pcap_t *handle = pcap_create(\"lo\", NULL);\n    if (handle == NULL) return 0;\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    // Build a filter from the fuzz input, but keep it bounded and safe.\n    // We only use the first byte to select a simple filter expression.\n    char filter_expr[64];\n    uint8_t selector = data[0] % 3;\n    if (selector == 0) {\n        snprintf(filter_expr, sizeof(filter_expr), \"udp\");\n    } else if (selector == 1) {\n        snprintf(filter_expr, sizeof(filter_expr), \"udp port 9999\");\n    } else {\n        snprintf(filter_expr, sizeof(filter_expr), \"udp and src host 127.0.0.1\");\n    }\n\n    struct bpf_program fp;\n    if (pcap_compile(handle, &fp, filter_expr, 1, PCAP_NETMASK_UNKNOWN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_setfilter(handle, &fp) != 0) {\n        pcap_freecode(&fp);\n        pcap_close(handle);\n        return 0;\n    }\n    pcap_freecode(&fp);\n\n    // Emit a local UDP packet to trigger capture.\n    emit_udp_packet();\n\n    // Capture a bounded number of packets.\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int packets_seen = 0;\n    int timeout_ms = 100;\n    struct timeval tv;\n    tv.tv_sec = 0;\n    tv.tv_usec = timeout_ms * 1000;\n\n    // Use pcap_next_ex with a short timeout via pcap_set_timeout? We already activated.\n    // We'll just call pcap_next_ex a few times with a small sleep between.\n    for (int i = 0; i < 5; i++) {\n        int ret = pcap_next_ex(handle, &header, &packet_data);\n        if (ret == 1) {\n            packets_seen++;\n            // Process packet data minimally: just check length.\n            if (header->len > 0 && packet_data != NULL) {\n                // No-op to use data.\n                volatile uint8_t sum = 0;\n                for (uint32_t j = 0; j < header->caplen && j < 64; j++) {\n                    sum += packet_data[j];\n                }\n                (void)sum;\n            }\n            if (packets_seen >= 3) break;\n        } else if (ret == 0) {\n            // Timeout, try again.\n            usleep(10000);\n        } else if (ret == -1) {\n            // Error.\n            break;\n        } else if (ret == -2) {\n            // No more packets.\n            break;\n        }\n    }\n\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":189,"completion_tokens":923,"total_tokens":1112,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":61},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}