{"id":"9467c52b-013c-4a83-bc10-5c9eaa324e29","object":"chat.completion","created":1786350910,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n\nstatic void sleep_ms(int ms) {\n#ifdef _WIN32\n    Sleep(ms);\n#else\n    usleep(ms * 1000);\n#endif\n}\n\nstatic void getaddrinfo_callback(void *arg, int status, struct ares_addrinfo *result) {\n    (void)arg;\n    if (status == ARES_SUCCESS && result != NULL) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    int status = ares_init_options(&channel, &options, 0);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    /* Derive a bounded hostname from fuzz input. */\n    size_t name_len = size;\n    if (name_len > 255) {\n        name_len = 255;\n    }\n    char hostname[256];\n    memcpy(hostname, data, name_len);\n    hostname[name_len] = '\\0';\n\n    /* Ensure the hostname is not empty and is NUL-terminated within bounds. */\n    if (name_len == 0) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, getaddrinfo_callback, NULL);\n\n    /* Process the event loop for a bounded time. */\n    int max_waits = 100;\n    while (max_waits-- > 0) {\n        fd_set read_fds, write_fds;\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        int nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            break;\n        }\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 10000; /* 10 ms */\n        if (select(nfds, &read_fds, &write_fds, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":206,"completion_tokens":714,"total_tokens":920,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":78},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}