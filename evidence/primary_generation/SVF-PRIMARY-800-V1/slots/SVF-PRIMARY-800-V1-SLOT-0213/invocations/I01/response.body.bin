{"id":"03a6b05e-ecd7-45b5-9aff-27fa71f1b1b6","object":"chat.completion","created":1786292459,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <curl/curl.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic size_t write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        return 0;\n    }\n\n    /* Use input to construct a local file URL, bounded to avoid huge strings. */\n    size_t url_len = size < 256 ? size : 256;\n    char *url = (char *)malloc(url_len + 1);\n    if (!url) {\n        curl_easy_cleanup(curl);\n        return 0;\n    }\n    memcpy(url, data, url_len);\n    url[url_len] = '\\0';\n\n    /* Ensure the URL starts with file:// to keep it local. */\n    if (strncmp(url, \"file://\", 7) != 0) {\n        free(url);\n        curl_easy_cleanup(curl);\n        return 0;\n    }\n\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_cb);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 1000L);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, 1000L);\n\n    /* Use one byte from input to optionally set a follow-location flag. */\n    if (data[0] & 1) {\n        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);\n    }\n\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n    free(url);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":179,"completion_tokens":473,"total_tokens":652,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":51},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}