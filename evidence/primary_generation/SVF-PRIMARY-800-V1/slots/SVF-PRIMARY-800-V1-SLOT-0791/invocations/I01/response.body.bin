{"id":"dea74ad0-96eb-47b5-b8f2-f590bb833079","object":"chat.completion","created":1786351849,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <lcms2.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) return 0;\n\n    cmsHPROFILE input_profile = cmsOpenProfileFromMem(data, size);\n    if (!input_profile) return 0;\n\n    cmsHPROFILE output_profile = cmsCreate_sRGBProfile();\n    if (!output_profile) {\n        cmsCloseProfile(input_profile);\n        return 0;\n    }\n\n    cmsUInt32Number input_format = TYPE_RGBA_8;\n    cmsUInt32Number output_format = TYPE_RGBA_8;\n\n    cmsHTRANSFORM transform = cmsCreateTransform(input_profile, input_format,\n                                                 output_profile, output_format,\n                                                 INTENT_PERCEPTUAL, 0);\n    if (!transform) {\n        cmsCloseProfile(input_profile);\n        cmsCloseProfile(output_profile);\n        return 0;\n    }\n\n    // Representative pixel data: 16x16 RGBA image\n    const int width = 16;\n    const int height = 16;\n    uint8_t pixels[width * height * 4];\n    for (int i = 0; i < width * height * 4; i++) {\n        pixels[i] = (uint8_t)(i * 7 + 3);\n    }\n\n    cmsDoTransform(transform, pixels, pixels, width * height);\n\n    cmsDeleteTransform(transform);\n    cmsCloseProfile(input_profile);\n    cmsCloseProfile(output_profile);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":184,"completion_tokens":352,"total_tokens":536,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":56},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}