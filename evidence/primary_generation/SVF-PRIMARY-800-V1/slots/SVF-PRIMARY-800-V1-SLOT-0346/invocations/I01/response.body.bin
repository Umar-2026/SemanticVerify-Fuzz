            "text": "#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \"cJSON.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 1) {\n        return 0;\n    }\n\n    char *json_str = (char *)malloc(size + 1);\n    if (json_str == NULL) {\n        return 0;\n    }\n    memcpy(json_str, data, size);\n    json_str[size] = '\\0';\n\n    cJSON *root = cJSON_Parse(json_str);\n    if (root == NULL) {\n        free(json_str);\n        return 0;\n    }\n\n    // Transformation 1: Print the JSON to a string (serialization)\n    char *printed = cJSON_Print(root);\n    if (printed != NULL) {\n        cJSON_free(printed);\n    }\n\n    // Transformation 2: Query the root for a specific key or type\n    // We perform a generic traversal/query to ensure the tree is navigated\n    if (cJSON_IsObject(root)) {\n        cJSON *child = root-\u003echild;\n        while (child != NULL) {\n            const char *name = child-\u003estring;\n            if (name != NULL) {\n                cJSON *item = cJSON_GetObjectItem(root, name);\n                (void)item;\n            }\n            child = child-\u003enext;\n        }\n    } else if (cJSON_IsArray(root)) {\n        int array_size = cJSON_GetArraySize(root);\n        if (array_size \u003e 0) {\n            cJSON *first = cJSON_GetArrayItem(root, 0);\n            (void)first;\n        }\n    }\n\n    cJSON_Delete(root);\n    free(json_str);\n\n    return 0;\n}",
