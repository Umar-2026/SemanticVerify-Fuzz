{"id":"cedfee1b-fb61-4a28-82a9-a1c75115908b","object":"chat.completion","created":1786350924,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n\nstatic void sleep_ms(int ms) {\n#ifdef _WIN32\n    Sleep(ms);\n#else\n    usleep(ms * 1000);\n#endif\n}\n\nstatic void getaddrinfo_callback(void *arg, int status, struct ares_addrinfo *result) {\n    (void)arg;\n    if (status == ARES_SUCCESS && result) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n\n    /* Derive a bounded timeout (1-1000 ms) from the first 4 bytes */\n    uint32_t timeout_ms = (uint32_t)data[0] | ((uint32_t)data[1] << 8) |\n                          ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);\n    timeout_ms = (timeout_ms % 1000) + 1;\n\n    options.timeout = (int)timeout_ms;\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    int status = ares_init_options(&channel, &options, ARES_OPT_TIMEOUT | ARES_OPT_FLAGS);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    /* Configure DNS server from environment variable */\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv) {\n        status = ares_set_servers_csv(channel, server_csv);\n        if (status != ARES_SUCCESS) {\n            ares_destroy(channel);\n            return 0;\n        }\n    }\n\n    /* Use remaining fuzz bytes to construct a hostname (bounded length) */\n    size_t host_len = size - 4;\n    if (host_len > 255) {\n        host_len = 255;\n    }\n    char hostname[256];\n    memcpy(hostname, data + 4, host_len);\n    hostname[host_len] = '\\0';\n\n    /* Perform address lookup */\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, getaddrinfo_callback, NULL);\n\n    /* Process events until callback completes or timeout */\n    int max_waits = 100;\n    while (max_waits-- > 0) {\n        fd_set read_fds, write_fds;\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        int nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            break;\n        }\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 10000; /* 10 ms */\n        if (select(nfds, &read_fds, &write_fds, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":214,"completion_tokens":803,"total_tokens":1017,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":86},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}