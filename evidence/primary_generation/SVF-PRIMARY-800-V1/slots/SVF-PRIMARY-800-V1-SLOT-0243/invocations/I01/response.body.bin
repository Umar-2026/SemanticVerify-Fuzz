{"id":"854e67e5-016c-4a67-9ac0-b849aebd6605","object":"chat.completion","created":1786292576,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Split input into two parts for two file paths\n    size_t split = (size_t)data[0] % (size - 1) + 1;\n    const uint8_t *path1_data = data + 1;\n    size_t path1_len = split;\n    const uint8_t *path2_data = data + 1 + split;\n    size_t path2_len = size - 1 - split;\n\n    if (path1_len == 0 || path2_len == 0) {\n        return 0;\n    }\n\n    // Construct file URLs from the input bytes (treat as raw path, but ensure no NUL)\n    char url1[256];\n    char url2[256];\n    if (path1_len >= sizeof(url1) - 6 || path2_len >= sizeof(url2) - 6) {\n        return 0;\n    }\n\n    memcpy(url1, \"file://\", 7);\n    memcpy(url1 + 7, path1_data, path1_len);\n    url1[7 + path1_len] = '\\0';\n\n    memcpy(url2, \"file://\", 7);\n    memcpy(url2 + 7, path2_data, path2_len);\n    url2[7 + path2_len] = '\\0';\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        return 0;\n    }\n\n    // First operation\n    curl_easy_setopt(curl, CURLOPT_URL, url1);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_perform(curl);\n\n    // Reset handle\n    curl_easy_reset(curl);\n\n    // Second operation with different URL and options\n    curl_easy_setopt(curl, CURLOPT_URL, url2);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":185,"completion_tokens":631,"total_tokens":816,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":57},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}