{"id":"4101e4de-c421-40a9-8b0d-74c2d9c5c36f","object":"chat.completion","created":1786291942,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    z_stream strm;\n    int ret;\n    uLong bound;\n    Bytef *compressed = NULL;\n    Bytef *decompressed = NULL;\n    uLong compressed_size;\n    uLong decompressed_size;\n    size_t total_in = 0;\n    size_t total_out = 0;\n    int flush;\n    int have;\n    int err;\n\n    if (size == 0) {\n        return 0;\n    }\n\n    /* Initialize deflate stream */\n    memset(&strm, 0, sizeof(strm));\n    ret = deflateInit(&strm, Z_DEFAULT_COMPRESSION);\n    if (ret != Z_OK) {\n        return 0;\n    }\n\n    /* Allocate output buffer for compression */\n    bound = deflateBound(&strm, (uLong)size);\n    compressed = (Bytef *)malloc(bound);\n    if (compressed == NULL) {\n        deflateEnd(&strm);\n        return 0;\n    }\n\n    /* Compress input in chunks */\n    strm.next_in = (Bytef *)data;\n    strm.avail_in = (uInt)size;\n    strm.next_out = compressed;\n    strm.avail_out = (uInt)bound;\n\n    do {\n        flush = (strm.avail_in == 0) ? Z_FINISH : Z_NO_FLUSH;\n        ret = deflate(&strm, flush);\n        if (ret == Z_STREAM_ERROR) {\n            free(compressed);\n            deflateEnd(&strm);\n            return 0;\n        }\n        if (ret == Z_BUF_ERROR && strm.avail_in > 0) {\n            /* Should not happen with enough output space, but handle */\n            free(compressed);\n            deflateEnd(&strm);\n            return 0;\n        }\n    } while (strm.avail_in > 0 || (flush == Z_FINISH && ret != Z_STREAM_END));\n\n    if (ret != Z_STREAM_END) {\n        free(compressed);\n        deflateEnd(&strm);\n        return 0;\n    }\n\n    compressed_size = (uLong)(strm.total_out);\n    deflateEnd(&strm);\n\n    /* Initialize inflate stream */\n    memset(&strm, 0, sizeof(strm));\n    ret = inflateInit(&strm);\n    if (ret != Z_OK) {\n        free(compressed);\n        return 0;\n    }\n\n    /* Allocate decompression buffer */\n    decompressed_size = (uLong)size + 1; /* +1 for safety */\n    decompressed = (Bytef *)malloc(decompressed_size);\n    if (decompressed == NULL) {\n        inflateEnd(&strm);\n        free(compressed);\n        return 0;\n    }\n\n    /* Decompress */\n    strm.next_in = compressed;\n    strm.avail_in = (uInt)compressed_size;\n    strm.next_out = decompressed;\n    strm.avail_out = (uInt)decompressed_size;\n\n    do {\n        ret = inflate(&strm, Z_NO_FLUSH);\n        if (ret == Z_STREAM_ERROR || ret == Z_NEED_DICT || ret == Z_DATA_ERROR || ret == Z_MEM_ERROR) {\n            break;\n        }\n        if (ret == Z_BUF_ERROR && strm.avail_in == 0) {\n            /* Not enough input, but we have all input, so this is an error */\n            break;\n        }\n    } while (ret != Z_STREAM_END && strm.avail_in > 0);\n\n    if (ret != Z_STREAM_END) {\n        /* Decompression failed, but we still free resources */\n    }\n\n    inflateEnd(&strm);\n    free(decompressed);\n    free(compressed);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":168,"completion_tokens":875,"total_tokens":1043,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":40},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}