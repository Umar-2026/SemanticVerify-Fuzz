{"id":"a2e84264-1bc0-438b-bac4-e2ccc608f172","object":"chat.completion","created":1786351068,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ares.h>\n\ntypedef struct {\n    int pending;\n    int success;\n    int failure;\n} query_state;\n\nstatic void query_callback(void *arg, int status, int timeouts, unsigned char *abuf, int alen) {\n    query_state *qs = (query_state *)arg;\n    (void)timeouts;\n    (void)abuf;\n    (void)alen;\n    if (qs == NULL) {\n        return;\n    }\n    if (status == ARES_SUCCESS) {\n        qs->success++;\n    } else {\n        qs->failure++;\n    }\n    qs->pending--;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    /* Split fuzz input into two hostname strings, each bounded and NUL-terminated. */\n    size_t half = size / 2;\n    size_t len1 = half;\n    size_t len2 = size - half;\n    if (len1 == 0 || len2 == 0) {\n        return 0;\n    }\n\n    /* Ensure room for NUL terminators. */\n    char *name1 = (char *)malloc(len1 + 1);\n    char *name2 = (char *)malloc(len2 + 1);\n    if (name1 == NULL || name2 == NULL) {\n        free(name1);\n        free(name2);\n        return 0;\n    }\n\n    memcpy(name1, data, len1);\n    name1[len1] = '\\0';\n    memcpy(name2, data + half, len2);\n    name2[len2] = '\\0';\n\n    /* Initialize c-ares channel. */\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    int optmask = 0;\n\n    if (ares_init_options(&channel, &options, optmask) != ARES_SUCCESS) {\n        free(name1);\n        free(name2);\n        return 0;\n    }\n\n    /* Set server from environment variable. */\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv != NULL && server_csv[0] != '\\0') {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    query_state qs1;\n    query_state qs2;\n    memset(&qs1, 0, sizeof(qs1));\n    memset(&qs2, 0, sizeof(qs2));\n    qs1.pending = 1;\n    qs2.pending = 1;\n\n    /* Issue two A-record queries. */\n    ares_query_dnsrec(channel, name1, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &qs1);\n    ares_query_dnsrec(channel, name2, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &qs2);\n\n    /* Drive the event loop until both callbacks have fired. */\n    int total_pending = 2;\n    while (total_pending > 0) {\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 1000; /* 1 ms */\n        fd_set read_fds, write_fds;\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        int nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            /* No sockets to wait on; break to avoid infinite loop. */\n            break;\n        }\n        if (select(nfds, &read_fds, &write_fds, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n        total_pending = qs1.pending + qs2.pending;\n    }\n\n    /* Consume callback outcomes (prevent unused warnings). */\n    (void)qs1.success;\n    (void)qs1.failure;\n    (void)qs2.success;\n    (void)qs2.failure;\n\n    /* Cleanup. */\n    ares_destroy(channel);\n    free(name1);\n    free(name2);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":222,"completion_tokens":955,"total_tokens":1177,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":94},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}