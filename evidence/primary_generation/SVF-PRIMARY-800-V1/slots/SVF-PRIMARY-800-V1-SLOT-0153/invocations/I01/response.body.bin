{"id":"1af73ff8-e25a-4de2-97e4-3ee86e999e42","object":"chat.completion","created":1786292209,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <net/if.h>\n#include <errno.h>\n\n#define FUZZ_PACKET_SIZE 64\n\nstatic int send_udp_packet(void) {\n    int fd = socket(AF_INET, SOCK_DGRAM, 0);\n    if (fd < 0) return -1;\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    addr.sin_port = htons(9999);\n\n    uint8_t payload[8] = {0xde, 0xad, 0xbe, 0xef, 0x01, 0x02, 0x03, 0x04};\n    int ret = sendto(fd, payload, sizeof(payload), 0, (struct sockaddr *)&addr, sizeof(addr));\n    close(fd);\n    return ret;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    // Use first byte to choose filter expression (bounded set)\n    const char *filter_expr;\n    switch (data[0] % 4) {\n        case 0: filter_expr = \"udp\"; break;\n        case 1: filter_expr = \"udp port 9999\"; break;\n        case 2: filter_expr = \"ip and udp\"; break;\n        default: filter_expr = \"udp dst port 9999\"; break;\n    }\n\n    pcap_t *handle = pcap_create(\"lo\", NULL);\n    if (handle == NULL) return 0;\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    struct bpf_program fp;\n    if (pcap_compile(handle, &fp, filter_expr, 1, PCAP_NETMASK_UNKNOWN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_setfilter(handle, &fp) != 0) {\n        pcap_freecode(&fp);\n        pcap_close(handle);\n        return 0;\n    }\n    pcap_freecode(&fp);\n\n    // Send a UDP packet to loopback\n    if (send_udp_packet() < 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int ret = pcap_next_ex(handle, &header, &packet_data);\n    if (ret == 1) {\n        // Inspect the captured packet: just read a few bytes safely\n        if (header->caplen > 0) {\n            volatile uint8_t first_byte = packet_data[0];\n            (void)first_byte;\n        }\n    }\n\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":189,"completion_tokens":721,"total_tokens":910,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":61},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}