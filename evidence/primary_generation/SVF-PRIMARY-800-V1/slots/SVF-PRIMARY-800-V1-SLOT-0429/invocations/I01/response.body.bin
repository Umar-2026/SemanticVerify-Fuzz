{"id":"a8ac94c5-b539-4159-9568-a5c792b25747","object":"chat.completion","created":1786293282,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary file to hold the fuzz data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (tif) {\n        uint32_t w = 0, h = 0;\n        uint16_t spp = 0, bps = 0, fmt = 0;\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &w);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &h);\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &spp);\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bps);\n        TIFFGetField(tif, TIFFTAG_SAMPLEFORMAT, &fmt);\n\n        if (w > 0 && h > 0 && w <= 10000 && h <= 10000) {\n            tmsize_t scanline_size = TIFFScanlineSize(tif);\n            if (scanline_size > 0 && scanline_size <= (tmsize_t)(w * spp * (bps / 8) + 16)) {\n                uint8_t *buf = (uint8_t *)malloc((size_t)scanline_size);\n                if (buf) {\n                    for (uint32_t row = 0; row < h; row++) {\n                        if (TIFFReadScanline(tif, buf, row, 0) < 0) {\n                            break;\n                        }\n                    }\n                    free(buf);\n                }\n            }\n        }\n        TIFFClose(tif);\n    }\n\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":164,"completion_tokens":510,"total_tokens":674,"prompt_tokens_details":{"cached_tokens":128},"prompt_