{"id":"0a9731d5-e786-4700-b41e-f19b2724f3c4","object":"chat.completion","created":1786350613,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"vpx/vpx_encoder.h\"\n#include \"vpx/vp8cx.h\"\n#include \"vpx/vpx_image.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Parse dimensions from input\n    unsigned int width = (data[0] << 8) | data[1];\n    unsigned int height = (data[2] << 8) | data[3];\n    if (width == 0 || height == 0 || width > 4096 || height > 4096) return 0;\n\n    // Determine bit depth and flags\n    int bit_depth = 8;\n    vpx_img_fmt_t fmt = VPX_IMG_FMT_I420;\n    unsigned int flags = 0;\n    if (data[4] & 0x01) {\n        bit_depth = 10;\n        fmt = VPX_IMG_FMT_I42016;\n        flags |= VPX_IMG_FLAG_HIGHBITDEPTH;\n    }\n\n    // Allocate image\n    vpx_image_t *img = vpx_img_alloc(NULL, fmt, width, height, 1);\n    if (!img) return 0;\n\n    // Fill image planes with fuzz data\n    size_t offset = 8;\n    size_t plane_size = (size_t)img->stride[0] * img->d_h;\n    if (offset + plane_size > size) {\n        vpx_img_free(img);\n        return 0;\n    }\n    memcpy(img->planes[0], data + offset, plane_size);\n    offset += plane_size;\n\n    plane_size = (size_t)img->stride[1] * ((img->d_h + 1) / 2);\n    if (offset + plane_size > size) {\n        vpx_img_free(img);\n        return 0;\n    }\n    memcpy(img->planes[1], data + offset, plane_size);\n    offset += plane_size;\n\n    plane_size = (size_t)img->stride[2] * ((img->d_h + 1) / 2);\n    if (offset + plane_size > size) {\n        vpx_img_free(img);\n        return 0;\n    }\n    memcpy(img->planes[2], data + offset, plane_size);\n    offset += plane_size;\n\n    // Initialize encoder\n    vpx_codec_ctx_t codec;\n    vpx_codec_iface_t *iface = vpx_codec_vp8_cx();\n    vpx_codec_enc_cfg_t cfg;\n    if (vpx_codec_enc_config_default(iface, &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    cfg.g_w = width;\n    cfg.g_h = height;\n    cfg.g_bit_depth = bit_depth;\n    cfg.g_input_bit_depth = bit_depth;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    if (vpx_codec_enc_init(&codec, iface, &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Encode one frame\n    vpx_codec_err_t res = vpx_codec_encode(&codec, img, 0, 1, 0, VPX_DL_REALTIME);\n    if (res == VPX_CODEC_OK) {\n        // Consume packets\n        const vpx_codec_cx_pkt_t *pkt;\n        vpx_codec_iter_t iter = NULL;\n        while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n            // Packet data is consumed by reading it\n            if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n                volatile uint8_t sum = 0;\n                const uint8_t *buf = (const uint8_t *)pkt->data.frame.buf;\n                size_t sz = pkt->data.frame.sz;\n                for (size_t i = 0; i < sz && i < 1024; i++) {\n                    sum += buf[i];\n                }\n                (void)sum;\n            }\n        }\n    }\n\n    vpx_codec_destroy(&codec);\n    vpx_img_free(img);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":191,"completion_tokens":989,"total_tokens":1180,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":63},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}