{"id":"62e55257-7435-4e69-8ffb-0d596849c412","object":"chat.completion","created":1786350932,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n\nstatic void sleep_ms(int ms) {\n#ifdef _WIN32\n    Sleep(ms);\n#else\n    usleep(ms * 1000);\n#endif\n}\n\nstatic void getaddrinfo_callback(void *arg, int status, struct ares_addrinfo *result) {\n    (void)arg;\n    if (status == ARES_SUCCESS && result) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    /* Derive a bounded timeout from the first two bytes */\n    unsigned int timeout_ms = ((unsigned int)data[0] << 8) | data[1];\n    timeout_ms = timeout_ms % 10000; /* bound to 0-9999 ms */\n\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.timeout = timeout_ms;\n    options.tries = 1;\n\n    ares_channel channel;\n    int status = ares_init_options(&channel, &options, ARES_OPT_TIMEOUT | ARES_OPT_TRIES);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv) {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    /* Use a fixed hostname for the lookup */\n    const char *host = \"example.com\";\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, host, NULL, &hints, getaddrinfo_callback, NULL);\n\n    /* Process events for a bounded time */\n    int max_wait_ms = 5000;\n    int waited = 0;\n    while (waited < max_wait_ms) {\n        int nfds;\n        fd_set read_fds, write_fds;\n        struct timeval tv;\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000; /* 100 ms */\n        int sel = select(nfds, &read_fds, &write_fds, NULL, &tv);\n        if (sel < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n        waited += 100;\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":214,"completion_tokens":674,"total_tokens":888,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":86},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}