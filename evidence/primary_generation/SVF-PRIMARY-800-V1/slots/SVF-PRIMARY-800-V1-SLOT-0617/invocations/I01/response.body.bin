{"id":"f81561f5-37ec-4058-922b-3925ec5cff39","object":"chat.completion","created":1786350947,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\nstatic void callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    (void)arg;\n    (void)status;\n    (void)timeouts;\n    if (result) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n\n    /* Derive a bounded timeout from the first 4 bytes (0-1000 ms) */\n    uint32_t raw_timeout;\n    memcpy(&raw_timeout, data, 4);\n    int timeout_ms = (int)(raw_timeout % 1001);\n    options.timeout = timeout_ms;\n    options.flags = ARES_FLAG_STAYOPEN;\n    options.tries = 1;\n\n    int status = ares_init_options(&channel, &options, ARES_OPT_TIMEOUT | ARES_OPT_FLAGS | ARES_OPT_TRIES);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv) {\n        status = ares_set_servers_csv(channel, server_csv);\n        if (status != ARES_SUCCESS) {\n            ares_destroy(channel);\n            return 0;\n        }\n    }\n\n    /* Use remaining bytes to form a hostname (null-terminated, bounded) */\n    size_t name_len = size - 4;\n    if (name_len > 255) {\n        name_len = 255;\n    }\n    char hostname[256];\n    memcpy(hostname, data + 4, name_len);\n    hostname[name_len] = '\\0';\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, callback, NULL);\n\n    /* Process events until the callback is invoked (bounded by timeout) */\n    int nfds;\n    fd_set readers, writers;\n    struct timeval tv;\n    tv.tv_sec = 0;\n    tv.tv_usec = (timeout_ms > 0) ? timeout_ms * 1000 : 1000;\n\n    for (int i = 0; i < 10; i++) {\n        nfds = ares_fds(channel, &readers, &writers);\n        if (nfds == 0) {\n            break;\n        }\n        if (select(nfds, &readers, &writers, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &readers, &writers);\n        tv.tv_sec = 0;\n        tv.tv_usec = (timeout_ms > 0) ? timeout_ms * 1000 : 1000;\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":214,"completion_tokens":725,"total_tokens":939,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":86},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}