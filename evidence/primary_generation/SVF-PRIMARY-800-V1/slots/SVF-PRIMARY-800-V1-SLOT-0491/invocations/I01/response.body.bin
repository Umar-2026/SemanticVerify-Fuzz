{"id":"8aedd9c9-ad24-4d12-834d-c062ec4a6902","object":"chat.completion","created":1786350257,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (!tif) {\n        unlink(filename);\n        return 0;\n    }\n\n    // Inspect image metadata\n    uint32_t width = 0, height = 0;\n    uint16_t bits_per_sample = 0, samples_per_pixel = 0;\n    uint16_t photometric = 0;\n    uint32_t rows_per_strip = 0;\n    uint32_t strips_per_image = 0;\n\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PHOTOMETRIC, &photometric);\n    TIFFGetField(tif, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);\n\n    if (width == 0 || height == 0 || rows_per_strip == 0) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    // Compute number of strips\n    strips_per_image = (height + rows_per_strip - 1) / rows_per_strip;\n\n    // Attempt to read representative image data: read a few strips from the middle\n    // Limit to at most 4 strips to keep the fuzzer bounded\n    uint32_t start_strip = strips_per_image / 2;\n    uint32_t num_strips = strips_per_image - start_strip;\n    if (num_strips > 4) num_strips = 4;\n\n    // Allocate a buffer for one strip\n    tmsize_t strip_size = TIFFStripSize(tif);\n    if (strip_size <= 0) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    unsigned char *buf = (unsigned char *)malloc(strip_size);\n    if (!buf) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    for (uint32_t i = 0; i < num_strips; i++) {\n        uint32_t strip = start_strip + i;\n        if (strip >= strips_per_image) break;\n        TIFFReadEncodedStrip(tif, strip, buf, strip_size);\n    }\n\n    free(buf);\n    TIFFClose(tif);\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":173,"completion_tokens":740,"total_tokens":913,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":45},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}