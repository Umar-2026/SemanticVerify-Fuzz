{"id":"7982a7b1-04ca-4284-9c39-eeb1d6d7c9db","object":"chat.completion","created":1786350019,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary input file from fuzz data\n    char input_path[] = \"/tmp/libtiff_fuzz_input_XXXXXX\";\n    int input_fd = mkstemp(input_path);\n    if (input_fd < 0) return 0;\n    write(input_fd, data, size);\n    close(input_fd);\n\n    // Create a temporary output file\n    char output_path[] = \"/tmp/libtiff_fuzz_output_XXXXXX\";\n    int output_fd = mkstemp(output_path);\n    if (output_fd < 0) {\n        unlink(input_path);\n        return 0;\n    }\n    close(output_fd);\n\n    TIFF *in = TIFFOpen(input_path, \"r\");\n    if (!in) {\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel;\n    uint16_t photometric, planar_config;\n    uint16_t compression, predictor;\n\n    TIFFGetField(in, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(in, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(in, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(in, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(in, TIFFTAG_PHOTOMETRIC, &photometric);\n    TIFFGetField(in, TIFFTAG_PLANARCONFIG, &planar_config);\n    TIFFGetField(in, TIFFTAG_COMPRESSION, &compression);\n    TIFFGetField(in, TIFFTAG_PREDICTOR, &predictor);\n\n    if (width == 0 || height == 0 || width > 10000 || height > 10000) {\n        TIFFClose(in);\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    // Determine scanline size\n    tmsize_t scanline_size = TIFFScanlineSize(in);\n    if (scanline_size <= 0) {\n        TIFFClose(in);\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    // Allocate buffer for one scanline\n    unsigned char *buffer = (unsigned char *)malloc(scanline_size);\n    if (!buffer) {\n        TIFFClose(in);\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    // Open output TIFF\n    TIFF *out = TIFFOpen(output_path, \"w\");\n    if (!out) {\n        free(buffer);\n        TIFFClose(in);\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    // Set output fields based on input\n    TIFFSetField(out, TIFFTAG_IMAGEWIDTH, width);\n    TIFFSetField(out, TIFFTAG_IMAGELENGTH, height);\n    TIFFSetField(out, TIFFTAG_BITSPERSAMPLE, bits_per_sample);\n    TIFFSetField(out, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);\n    TIFFSetField(out, TIFFTAG_PHOTOMETRIC, photometric);\n    TIFFSetField(out, TIFFTAG_PLANARCONFIG, planar_config);\n    TIFFSetField(out, TIFFTAG_COMPRESSION, compression);\n    TIFFSetField(out, TIFFTAG_PREDICTOR, predictor);\n    TIFFSetField(out, TIFFTAG_ROWSPERSTRIP, TIFFDefaultStripSize(out, 0));\n\n    // Copy scanlines\n    for (uint32_t row = 0; row < height; row++) {\n        if (TIFFReadScanline(in, buffer, row, 0) < 0) {\n            break;\n        }\n        if (TIFFWriteScanline(out, buffer, row, 0) < 0) {\n            break;\n        }\n    }\n\n    TIFFClose(out);\n    free(buffer);\n    TIFFClose(in);\n\n    unlink(input_path);\n    unlink(output_path);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":182,"completion_tokens":980,"total_tokens":1162,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":54},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}