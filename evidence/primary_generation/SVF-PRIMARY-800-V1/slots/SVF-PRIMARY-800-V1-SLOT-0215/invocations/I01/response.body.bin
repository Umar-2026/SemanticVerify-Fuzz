{"id":"0deb87ff-6ee3-4bb8-9054-eccddd57dc3a","object":"chat.completion","created":1786292466,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <curl/curl.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\nstatic size_t write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        return 0;\n    }\n\n    /* Use first byte to select a file path prefix */\n    const char *path_prefix;\n    switch (data[0] % 3) {\n        case 0:\n            path_prefix = \"file:///tmp/fuzz_\";\n            break;\n        case 1:\n            path_prefix = \"file://./fuzz_\";\n            break;\n        default:\n            path_prefix = \"file://fuzz_\";\n            break;\n    }\n\n    /* Use second byte to select a suffix */\n    const char *suffix;\n    switch (data[1] % 4) {\n        case 0:\n            suffix = \".txt\";\n            break;\n        case 1:\n            suffix = \".dat\";\n            break;\n        case 2:\n            suffix = \"\";\n            break;\n        default:\n            suffix = \"/\";\n            break;\n    }\n\n    /* Build a bounded file URL from the remaining input bytes */\n    size_t max_name_len = 64;\n    size_t avail = size - 2;\n    if (avail > max_name_len) {\n        avail = max_name_len;\n    }\n\n    char *url = (char *)malloc(strlen(path_prefix) + avail + strlen(suffix) + 1);\n    if (!url) {\n        curl_easy_cleanup(curl);\n        return 0;\n    }\n\n    strcpy(url, path_prefix);\n    for (size_t i = 0; i < avail; i++) {\n        char c = (char)data[2 + i];\n        /* Keep the URL path printable and safe */\n        if (c >= 0x20 && c <= 0x7e && c != '?' && c != '#' && c != '%') {\n            url[strlen(path_prefix) + i] = c;\n        } else {\n            url[strlen(path_prefix) + i] = '_';\n        }\n    }\n    url[strlen(path_prefix) + avail] = '\\0';\n    strcat(url, suffix);\n\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_cb);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 100L);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, 100L);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);\n\n    /* Use a bounded output buffer as an alternative sink */\n    char outbuf[256];\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, outbuf);\n\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n    free(url);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":179,"completion_tokens":741,"total_tokens":920,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":51},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}