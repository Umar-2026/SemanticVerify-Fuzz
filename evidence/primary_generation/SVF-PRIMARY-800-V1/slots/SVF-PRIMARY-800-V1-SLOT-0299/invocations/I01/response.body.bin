{"id":"96ff1ded-af27-45ee-ba71-ead26b4ddc22","object":"chat.completion","created":1786292793,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    size_t total = size * nmemb;\n    unsigned char *buf = (unsigned char *)userdata;\n    /* buf layout: [4 bytes length][data...] */\n    uint32_t *len = (uint32_t *)buf;\n    unsigned char *data = buf + 4;\n    if (*len + total > 4096) {\n        total = 4096 - *len;\n    }\n    memcpy(data + *len, ptr, total);\n    *len += total;\n    return total;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    /* Bounded configuration from fuzz input */\n    uint32_t timeout_ms = 0;\n    uint32_t connect_timeout_ms = 0;\n    memcpy(&timeout_ms, data, 4);\n    memcpy(&connect_timeout_ms, data + 4, 4);\n    timeout_ms %= 10000;\n    connect_timeout_ms %= 10000;\n\n    /* Use a fixed local file URL */\n    const char *url = \"file:///tmp/fuzz_input.txt\";\n\n    /* Application output buffer: 4-byte length + 4096 data */\n    unsigned char outbuf[4100];\n    memset(outbuf, 0, sizeof(outbuf));\n\n    /* Library setup */\n    if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) {\n        return 0;\n    }\n\n    CURL *easy = curl_easy_init();\n    if (!easy) {\n        curl_global_cleanup();\n        return 0;\n    }\n\n    /* Configure the easy handle */\n    curl_easy_setopt(easy, CURLOPT_URL, url);\n    curl_easy_setopt(easy, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(easy, CURLOPT_WRITEDATA, outbuf);\n    curl_easy_setopt(easy, CURLOPT_TIMEOUT_MS, timeout_ms);\n    curl_easy_setopt(easy, CURLOPT_CONNECTTIMEOUT_MS, connect_timeout_ms);\n    curl_easy_setopt(easy, CURLOPT_FOLLOWLOCATION, 0L);\n    curl_easy_setopt(easy, CURLOPT_NOSIGNAL, 1L);\n\n    /* Perform the transfer */\n    curl_easy_perform(easy);\n\n    /* Cleanup */\n    curl_easy_cleanup(easy);\n    curl_global_cleanup();\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":193,"completion_tokens":608,"total_tokens":801,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":65},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}