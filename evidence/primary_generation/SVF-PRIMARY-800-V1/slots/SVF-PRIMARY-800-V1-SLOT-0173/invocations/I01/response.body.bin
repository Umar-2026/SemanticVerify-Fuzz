{"id":"737fe664-ec2b-4dad-9c25-274e668dfeaf","object":"chat.completion","created":1786292301,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <net/if.h>\n#include <errno.h>\n\n#define MAX_PACKETS 10\n#define SNAP_LEN 65535\n#define TIMEOUT_MS 1000\n\nstatic void emit_udp_packet(void) {\n    int fd = socket(AF_INET, SOCK_DGRAM, 0);\n    if (fd < 0) return;\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(9999);\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    const char *payload = \"fuzz\";\n    sendto(fd, payload, strlen(payload), 0, (struct sockaddr *)&addr, sizeof(addr));\n    close(fd);\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    pcap_t *handle = pcap_create(\"lo\", NULL);\n    if (handle == NULL) return 0;\n\n    if (pcap_set_snaplen(handle, SNAP_LEN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n    if (pcap_set_promisc(handle, 0) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n    if (pcap_set_timeout(handle, TIMEOUT_MS) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    // Build a filter string from fuzz input (bounded, null-terminated)\n    size_t filter_len = size < 256 ? size : 255;\n    char filter[256];\n    memcpy(filter, data, filter_len);\n    filter[filter_len] = '\\0';\n\n    struct bpf_program fp;\n    if (pcap_compile(handle, &fp, filter, 1, PCAP_NETMASK_UNKNOWN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_setfilter(handle, &fp) != 0) {\n        pcap_freecode(&fp);\n        pcap_close(handle);\n        return 0;\n    }\n\n    // Emit a bounded number of local UDP packets to trigger capture\n    emit_udp_packet();\n\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int packets_seen = 0;\n    while (packets_seen < MAX_PACKETS) {\n        int ret = pcap_next_ex(handle, &header, &packet_data);\n        if (ret == 1) {\n            // Inspect packet: just touch the data to ensure it's accessible\n            if (header->caplen > 0) {\n                volatile uint8_t sum = 0;\n                for (uint32_t i = 0; i < header->caplen && i < 64; i++) {\n                    sum += packet_data[i];\n                }\n                (void)sum;\n            }\n            packets_seen++;\n        } else if (ret == 0) {\n            // Timeout, stop to keep bounded\n            break;\n        } else {\n            // Error or PCAP_ERROR_BREAK\n            break;\n        }\n    }\n\n    pcap_freecode(&fp);\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":189,"completion_tokens":837,"total_tokens":1026,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":61},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}