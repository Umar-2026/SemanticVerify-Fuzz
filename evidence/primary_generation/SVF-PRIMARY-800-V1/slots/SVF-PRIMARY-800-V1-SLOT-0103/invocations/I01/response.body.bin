{"id":"6f68044e-65fa-4e38-acc0-763592ff1f9c","object":"chat.completion","created":1786291963,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <unistd.h>\n#include <errno.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    // Create a UDP socket bound to loopback\n    int sock = socket(AF_INET, SOCK_DGRAM, 0);\n    if (sock < 0) return 0;\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    addr.sin_port = 0; // ephemeral port\n\n    if (bind(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        close(sock);\n        return 0;\n    }\n\n    // Get the assigned port\n    socklen_t addr_len = sizeof(addr);\n    if (getsockname(sock, (struct sockaddr *)&addr, &addr_len) < 0) {\n        close(sock);\n        return 0;\n    }\n\n    // Prepare payload from fuzz input (limit to reasonable size)\n    size_t payload_len = size;\n    if (payload_len > 1400) payload_len = 1400; // keep within UDP payload limits\n\n    // Send the datagram to ourselves\n    struct sockaddr_in dest;\n    memset(&dest, 0, sizeof(dest));\n    dest.sin_family = AF_INET;\n    dest.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    dest.sin_port = addr.sin_port;\n\n    ssize_t sent = sendto(sock, data, payload_len, 0, (struct sockaddr *)&dest, sizeof(dest));\n    if (sent < 0) {\n        close(sock);\n        return 0;\n    }\n\n    // Set up libpcap on loopback\n    char errbuf[PCAP_ERRBUF_SIZE];\n    pcap_t *pcap = pcap_create(\"lo\", errbuf);\n    if (pcap == NULL) {\n        close(sock);\n        return 0;\n    }\n\n    // Set immediate mode to avoid buffering delays\n    if (pcap_set_immediate_mode(pcap, 1) != 0) {\n        pcap_close(pcap);\n        close(sock);\n        return 0;\n    }\n\n    if (pcap_activate(pcap) != 0) {\n        pcap_close(pcap);\n        close(sock);\n        return 0;\n    }\n\n    // Set a filter to only capture UDP packets to our port\n    char filter[64];\n    snprintf(filter, sizeof(filter), \"udp and dst port %d\", ntohs(addr.sin_port));\n    struct bpf_program fp;\n    if (pcap_compile(pcap, &fp, filter, 1, PCAP_NETMASK_UNKNOWN) != 0) {\n        pcap_close(pcap);\n        close(sock);\n        return 0;\n    }\n    if (pcap_setfilter(pcap, &fp) != 0) {\n        pcap_freecode(&fp);\n        pcap_close(pcap);\n        close(sock);\n        return 0;\n    }\n    pcap_freecode(&fp);\n\n    // Capture one packet with a timeout\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int ret = pcap_next_ex(pcap, &header, &packet_data);\n    if (ret == 1) {\n        // Successfully got a packet; we don't need to do anything with it\n        // The packet data is available but we just verify capture worked\n    }\n\n    pcap_close(pcap);\n    close(sock);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":181,"completion_tokens":864,"total_tokens":1045,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":53},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}