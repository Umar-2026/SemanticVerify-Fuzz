{"id":"b6f3920c-40dc-44ec-87c7-57f555225689","object":"chat.completion","created":1786291935,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    z_stream strm;\n    int ret;\n    uLong bound;\n    Bytef *compressed;\n    Bytef *decompressed;\n    uLongf decompressed_len;\n    size_t compressed_len;\n\n    if (size == 0) return 0;\n\n    /* Initialize deflate stream */\n    memset(&strm, 0, sizeof(strm));\n    ret = deflateInit(&strm, Z_DEFAULT_COMPRESSION);\n    if (ret != Z_OK) return 0;\n\n    /* Determine upper bound for compressed size */\n    bound = deflateBound(&strm, (uLong)size);\n    compressed = (Bytef *)malloc(bound);\n    if (compressed == NULL) {\n        deflateEnd(&strm);\n        return 0;\n    }\n\n    /* Compress input */\n    strm.next_in = (Bytef *)data;\n    strm.avail_in = (uInt)size;\n    strm.next_out = compressed;\n    strm.avail_out = (uInt)bound;\n\n    ret = deflate(&strm, Z_FINISH);\n    if (ret != Z_STREAM_END) {\n        free(compressed);\n        deflateEnd(&strm);\n        return 0;\n    }\n    compressed_len = strm.total_out;\n\n    ret = deflateEnd(&strm);\n    if (ret != Z_OK) {\n        free(compressed);\n        return 0;\n    }\n\n    /* Initialize inflate stream */\n    memset(&strm, 0, sizeof(strm));\n    ret = inflateInit(&strm);\n    if (ret != Z_OK) {\n        free(compressed);\n        return 0;\n    }\n\n    /* Prepare decompression buffer */\n    decompressed_len = (uLongf)size;\n    decompressed = (Bytef *)malloc(size ? size : 1);\n    if (decompressed == NULL) {\n        inflateEnd(&strm);\n        free(compressed);\n        return 0;\n    }\n\n    /* Decompress */\n    strm.next_in = compressed;\n    strm.avail_in = (uInt)compressed_len;\n    strm.next_out = decompressed;\n    strm.avail_out = (uInt)decompressed_len;\n\n    ret = inflate(&strm, Z_FINISH);\n    if (ret != Z_STREAM_END) {\n        /* Not necessarily an error; just ignore */\n    }\n\n    inflateEnd(&strm);\n    free(decompressed);\n    free(compressed);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":168,"completion_tokens":593,"total_tokens":761,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":40},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}