{"id":"361d993b-fa47-4586-95f6-1d0853384fd6","object":"chat.completion","created":1786351729,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include \"lcms2.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Split input into two halves for two profiles\n    size_t half = size / 2;\n    const uint8_t *data1 = data;\n    size_t size1 = half;\n    const uint8_t *data2 = data + half;\n    size_t size2 = size - half;\n\n    cmsHPROFILE hProfile1 = NULL;\n    cmsHPROFILE hProfile2 = NULL;\n\n    // First profile: try to open from memory, fallback to sRGB\n    if (size1 > 0) {\n        hProfile1 = cmsOpenProfileFromMem(data1, size1);\n    }\n    if (hProfile1 == NULL) {\n        hProfile1 = cmsCreate_sRGBProfile();\n    }\n\n    // Second profile: try to open from memory, fallback to sRGB\n    if (size2 > 0) {\n        hProfile2 = cmsOpenProfileFromMem(data2, size2);\n    }\n    if (hProfile2 == NULL) {\n        hProfile2 = cmsCreate_sRGBProfile();\n    }\n\n    if (hProfile1 == NULL || hProfile2 == NULL) {\n        if (hProfile1) cmsCloseProfile(hProfile1);\n        if (hProfile2) cmsCloseProfile(hProfile2);\n        return 0;\n    }\n\n    // Inspect information from each profile\n    char buffer[256];\n    cmsUInt32Number version1 = cmsGetProfileVersion(hProfile1);\n    cmsUInt32Number version2 = cmsGetProfileVersion(hProfile2);\n    (void)version1;\n    (void)version2;\n\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoManufacturer, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoManufacturer, \"en\", \"US\", buffer, sizeof(buffer));\n\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoModel, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoModel, \"en\", \"US\", buffer, sizeof(buffer));\n\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoCopyright, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoCopyright, \"en\", \"US\", buffer, sizeof(buffer));\n\n    // Check color space and PCS\n    cmsColorSpaceSignature cs1 = cmsGetColorSpace(hProfile1);\n    cmsColorSpaceSignature cs2 = cmsGetColorSpace(hProfile2);\n    (void)cs1;\n    (void)cs2;\n\n    cmsColorSpaceSignature pcs1 = cmsGetPCS(hProfile1);\n    cmsColorSpaceSignature pcs2 = cmsGetPCS(hProfile2);\n    (void)pcs1;\n    (void)pcs2;\n\n    // Check device class\n    cmsProfileClassSignature class1 = cmsGetDeviceClass(hProfile1);\n    cmsProfileClassSignature class2 = cmsGetDeviceClass(hProfile2);\n    (void)class1;\n    (void)class2;\n\n    // Check rendering intent\n    cmsUInt32Number intent1 = cmsGetHeaderRenderingIntent(hProfile1);\n    cmsUInt32Number intent2 = cmsGetHeaderRenderingIntent(hProfile2);\n    (void)intent1;\n    (void)intent2;\n\n    // Check flags\n    cmsUInt32Number flags1 = cmsGetHeaderFlags(hProfile1);\n    cmsUInt32Number flags2 = cmsGetHeaderFlags(hProfile2);\n    (void)flags1;\n    (void)flags2;\n\n    // Check manufacturer and model from header\n    cmsUInt32Number manuf1 = cmsGetHeaderManufacturer(hProfile1);\n    cmsUInt32Number manuf2 = cmsGetHeaderManufacturer(hProfile2);\n    (void)manuf1;\n    (void)manuf2;\n\n    cmsUInt32Number model1 = cmsGetHeaderModel(hProfile1);\n    cmsUInt32Number model2 = cmsGetHeaderModel(hProfile2);\n    (void)model1;\n    (void)model2;\n\n    // Check attributes\n    cmsUInt64Number attr1 = cmsGetHeaderAttributes(hProfile1);\n    cmsUInt64Number attr2 = cmsGetHeaderAttributes(hProfile2);\n    (void)attr1;\n    (void)attr2;\n\n    // Check creator\n    cmsUInt32Number creator1 = cmsGetHeaderCreator(hProfile1);\n    cmsUInt32Number creator2 = cmsGetHeaderCreator(hProfile2);\n    (void)creator1;\n    (void)creator2;\n\n    // Check profile ID\n    cmsUInt8Number profileID1[16];\n    cmsUInt8Number profileID2[16];\n    cmsGetHeaderProfileID(hProfile1, profileID1);\n    cmsGetHeaderProfileID(hProfile2, profileID2);\n\n    // Check tag count\n    cmsInt32Number tagCount1 = cmsGetTagCount(hProfile1);\n    cmsInt32Number tagCount2 = cmsGetTagCount(hProfile2);\n    (void)tagCount1;\n    (void)tagCount2;\n\n    // Check tag signatures\n    if (tagCount1 > 0) {\n        cmsTagSignature sig = cmsGetTagSignature(hProfile1, 0);\n        (void)sig;\n    }\n    if (tagCount2 > 0) {\n        cmsTagSignature sig = cmsGetTagSignature(hProfile2, 0);\n        (void)sig;\n    }\n\n    // Check whether profiles are matrix-shaper or LUT-based\n    cmsBool isMatrix1 = cmsIsMatrixShaper(hProfile1);\n    cmsBool isMatrix2 = cmsIsMatrixShaper(hProfile2);\n    (void)isMatrix1;\n    (void)isMatrix2;\n\n    // Check CLUT presence\n    cmsBool hasCLUT1 = cmsIsCLUT(hProfile1, 0, 0);\n    cmsBool hasCLUT2 = cmsIsCLUT(hProfile2, 0, 0);\n    (void)hasCLUT1;\n    (void)hasCLUT2;\n\n    // Check intent support\n    cmsBool intentSupport1 = cmsIsIntentSupported(hProfile1, INTENT_PERCEPTUAL, LCMS_USED_AS_INPUT);\n    cmsBool intentSupport2 = cmsIsIntentSupported(hProfile2, INTENT_PERCEPTUAL, LCMS_USED_AS_INPUT);\n    (void)intentSupport1;\n    (void)intentSupport2;\n\n    // Check profile is suitable for CMYK\n    cmsBool isCMYK1 = cmsIsCMYK(hProfile1);\n    cmsBool isCMYK2 = cmsIsCMYK(hProfile2);\n    (void)isCMYK1;\n    (void)isCMYK2;\n\n    // Check profile is suitable for LAB\n    cmsBool isLab1 = cmsIsLab(hProfile1);\n    cmsBool isLab2 = cmsIsLab(hProfile2);\n    (void)isLab1;\n    (void)isLab2;\n\n    // Check profile is suitable for XYZ\n    cmsBool isXYZ1 = cmsIsXYZ(hProfile1);\n    cmsBool isXYZ2 = cmsIsXYZ(hProfile2);\n    (void)isXYZ1;\n    (void)isXYZ2;\n\n    // Check profile is suitable for sRGB\n    cmsBool isSRGB1 = cmsIs_sRGB(hProfile1);\n    cmsBool isSRGB2 = cmsIs_sRGB(hProfile2);\n    (void)isSRGB1;\n    (void)isSRGB2;\n\n    // Check profile is suitable for printing\n    cmsBool isPrint1 = cmsIsPrinter(hProfile1);\n    cmsBool isPrint2 = cmsIsPrinter(hProfile2);\n    (void)isPrint1;\n    (void)isPrint2;\n\n    // Check profile is suitable for display\n    cmsBool isDisplay1 = cmsIsDisplay(hProfile1);\n    cmsBool isDisplay2 = cmsIsDisplay(hProfile2);\n    (void)isDisplay1;\n    (void)isDisplay2;\n\n    // Check profile is suitable for input\n    cmsBool isInput1 = cmsIsInput(hProfile1);\n    cmsBool isInput2 = cmsIsInput(hProfile2);\n    (void)isInput1;\n    (void)isInput2;\n\n    // Check profile is suitable for output\n    cmsBool isOutput1 = cmsIsOutput(hProfile1);\n    cmsBool isOutput2 = cmsIsOutput(hProfile2);\n    (void)isOutput1;\n    (void)isOutput2;\n\n    // Check profile is suitable for proofing\n    cmsBool isProof1 = cmsIsProofing(hProfile1);\n    cmsBool isProof2 = cmsIsProofing(hProfile2);\n    (void)isProof1;\n    (void)isProof2;\n\n    // Check profile is suitable for abstract\n    cmsBool isAbstract1 = cmsIsAbstract(hProfile1);\n    cmsBool isAbstract2 = cmsIsAbstract(hProfile2);\n    (void)isAbstract1;\n    (void)isAbstract2;\n\n    // Check profile is suitable for device link\n    cmsBool isDeviceLink1 = cmsIsDeviceLink(hProfile1);\n    cmsBool isDeviceLink2 = cmsIsDeviceLink(hProfile2);\n    (void)isDeviceLink1;\n    (void)isDeviceLink2;\n\n    // Check profile is suitable for named color\n    cmsBool isNamedColor1 = cmsIsNamedColor(hProfile1);\n    cmsBool isNamedColor2 = cmsIsNamedColor(hProfile2);\n    (void)isNamedColor1;\n    (void)isNamedColor2;\n\n    // Check profile is suitable for color space\n    cmsBool isColorSpace1 = cmsIsColorSpace(hProfile1);\n    cmsBool isColorSpace2 = cmsIsColorSpace(hProfile2);\n    (void)isColorSpace1;\n    (void)isColorSpace2;\n\n    // Check profile is suitable for matrix shaper\n    cmsBool isMatrixShaper1 = cmsIsMatrixShaper(hProfile1);\n    cmsBool isMatrixShaper2 = cmsIsMatrixShaper(hProfile2);\n    (void)isMatrixShaper1;\n    (void)isMatrixShaper2;\n\n    // Check profile is suitable for LUT\n    cmsBool isLUT1 = cmsIsLUT(hProfile1, 0, 0);\n    cmsBool isLUT2 = cmsIsLUT(hProfile2, 0, 0);\n    (void)isLUT1;\n    (void)isLUT2;\n\n    // Check profile is suitable for CLUT\n    cmsBool isCLUT1 = cmsIsCLUT(hProfile1, 0, 0);\n    cmsBool isCLUT2 = cmsIsCLUT(hProfile2, 0, 0);\n    (void)isCLUT1;\n    (void)isCLUT2;\n\n    // Check profile is suitable for tone curve\n    cmsBool isToneCurve1 = cmsIsToneCurve(hProfile1);\n    cmsBool isToneCurve2 = cmsIsToneCurve(hProfile2);\n    (void)isToneCurve1;\n    (void)isToneCurve2;\n\n    // Check profile is suitable for parametric curve\n    cmsBool isParametric1 = cmsIsParametricCurve(hProfile1);\n    cmsBool isParametric2 = cmsIsParametricCurve(hProfile2);\n    (void)isParametric1;\n    (void)isParametric2;\n\n    // Check profile is suitable for multi-localized unicode\n    cmsBool isMLU1 = cmsIsMLU(hProfile1);\n    cmsBool isMLU2 = cmsIsMLU(hProfile2);\n    (void)isMLU1;\n    (void)isMLU2;\n\n    // Check profile is suitable for signature\n    cmsBool isSignature1 = cmsIsSignature(hProfile1);\n    cmsBool isSignature2 = cmsIsSignature(hProfile2);\n    (void)isSignature1;\n    (void)isSignature2;\n\n    // Check profile is suitable for text\n    cmsBool isText1 = cmsIsText(hProfile1);\n    cmsBool isText2 = cmsIsText(hProfile2);\n    (void)isText1;\n    (void)isText2;\n\n    // Check profile is suitable for date time\n    cmsBool isDateTime1 = cmsIsDateTime(hProfile1);\n    cmsBool isDateTime2 = cmsIsDateTime(hProfile2);\n    (void)isDateTime1;\n    (void)isDateTime2;\n\n    // Check profile is suitable for viewing conditions\n    cmsBool isViewingConditions1 = cmsIsViewingConditions(hProfile1);\n    cmsBool isViewingConditions2 = cmsIsViewingConditions(hProfile2);\n    (void)isViewingConditions1;\n    (void)isViewingConditions2;\n\n    // Check profile is suitable for named color list\n    cmsBool isNamedColorList1 = cmsIsNamedColorList(hProfile1);\n    cmsBool isNamedColorList2 = cmsIsNamedColorList(hProfile2);\n    (void)isNamedColorList1;\n    (void)isNamedColorList2;\n\n    // Check profile is suitable for multi-process elements\n    cmsBool isMPE1 = cmsIsMPE(hProfile1);\n    cmsBool isMPE2 = cmsIsMPE(hProfile2);\n    (void)isMPE1;\n    (void)isMPE2;\n\n    // Check profile is suitable for profile sequence\n    cmsBool isProfileSequence1 = cmsIsProfileSequence(hProfile1);\n    cmsBool isProfileSequence2 = cmsIsProfileSequence(hProfile2);\n    (void)isProfileSequence1;\n    (void)isProfileSequence2;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceID1 = cmsIsProfileSequenceID(hProfile1);\n    cmsBool isProfileSequenceID2 = cmsIsProfileSequenceID(hProfile2);\n    (void)isProfileSequenceID1;\n    (void)isProfileSequenceID2;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1 = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2 = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1;\n    (void)isProfileSequenceDesc2;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1 = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2 = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1;\n    (void)isProfileSequenceId2;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1b = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2b = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1b;\n    (void)isProfileSequenceDesc2b;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1b = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2b = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1b;\n    (void)isProfileSequenceId2b;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1c = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2c = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1c;\n    (void)isProfileSequenceDesc2c;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1c = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2c = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1c;\n    (void)isProfileSequenceId2c;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1d = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2d = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1d;\n    (void)isProfileSequenceDesc2d;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1d = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2d = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1d;\n    (void)isProfileSequenceId2d;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1e = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2e = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1e;\n    (void)isProfileSequenceDesc2e;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1e = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2e = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1e;\n    (void)isProfileSequenceId2e;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1f = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2f = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1f;\n    (void)isProfileSequenceDesc2f;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1f = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2f = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1f;\n    (void)isProfileSequenceId2f;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1g = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2g = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1g;\n    (void)isProfileSequenceDesc2g;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1g = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2g = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1g;\n    (void)isProfileSequenceId2g;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1h = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2h = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1h;\n    (void)isProfileSequenceDesc2h;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1h = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2h = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1h;\n    (void)isProfileSequenceId2h;\n\n    // Check profile is suitable for profile sequence description\n    cmsBool isProfileSequenceDesc1i = cmsIsProfileSequenceDesc(hProfile1);\n    cmsBool isProfileSequenceDesc2i = cmsIsProfileSequenceDesc(hProfile2);\n    (void)isProfileSequenceDesc1i;\n    (void)isProfileSequenceDesc2i;\n\n    // Check profile is suitable for profile sequence ID\n    cmsBool isProfileSequenceId1i = cmsIsProfileSequenceId(hProfile1);\n    cmsBool isProfileSequenceId2i = cmsIsProfileSequenceId(hProfile2);\n    (void)isProfileSequenceId1i;\n    (void)isProfileSequ