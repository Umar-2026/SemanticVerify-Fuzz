.avail_out == 0) {\n            // Expand output buffer if needed\n            size_t new_capacity = output_capacity * 2;\n            uint8_t *new_output = (uint8_t *)realloc(output, new_capacity);\n            if (!new_output) {\n                deflateEnd(&strm);\n                free(output);\n                return 0;\n            }\n            output = new_output;\n            output_capacity = new_capacity;\n            strm.next_out = output + total_out;\n            strm.avail_out = (uInt)(output_capacity - total_out);\n        }\n\n        ret = deflate(&strm, flush);\n        if (ret == Z_STREAM_END) {\n            finished = 1;\n            break;\n        }\n        if (ret != Z_OK && ret != Z_BUF_ERROR) {\n            deflateEnd(&strm);\n            free(output);\n            return 0;\n        }\n        total_out = output_capacity - strm.avail_out;\n        if (strm.avail_in == 0 && flush != Z_FINISH) {\n            // If we've consumed all input and not finishing, we can stop\n            break;\n        }\n    }\n\n    // Clean up\n    deflateEnd(&strm);\n    free(output);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":161,"completion_tokens":870,"total_tokens":1031,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":33},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}