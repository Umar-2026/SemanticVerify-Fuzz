{"id":"27254688-8628-4f1f-a4f9-09430539f6cb","object":"chat.completion","created":1786350277,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (!tif) {\n        unlink(filename);\n        return 0;\n    }\n\n    // Read metadata\n    uint32_t width = 0, height = 0;\n    uint16_t bits_per_sample = 0, samples_per_pixel = 0;\n    uint16_t photometric = 0;\n    uint32_t rows_per_strip = 0;\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PHOTOMETRIC, &photometric);\n    TIFFGetField(tif, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);\n\n    // Attempt to read representative data from the first strip\n    if (width > 0 && height > 0 && rows_per_strip > 0) {\n        tmsize_t strip_size = TIFFStripSize(tif);\n        if (strip_size > 0 && strip_size <= 1024 * 1024 * 16) { // limit to 16 MB\n            uint8_t *buf = (uint8_t *)malloc(strip_size);\n            if (buf) {\n                TIFFReadEncodedStrip(tif, 0, buf, strip_size);\n                free(buf);\n            }\n        }\n    }\n\n    TIFFClose(tif);\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":173,"completion_tokens":541,"tota