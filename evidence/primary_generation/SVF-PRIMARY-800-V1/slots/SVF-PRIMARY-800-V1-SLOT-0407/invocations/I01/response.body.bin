{"id":"39567aef-2a17-4c34-b4d3-b5dc60d4e395","object":"chat.completion","created":1786293185,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the fuzz data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n\n    size_t written = 0;\n    while (written < size) {\n        ssize_t n = write(fd, data + written, size - written);\n        if (n <= 0) break;\n        written += (size_t)n;\n    }\n    close(fd);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (tif) {\n        uint32_t width = 0, height = 0;\n        uint16_t bits_per_sample = 0, samples_per_pixel = 0;\n        uint16_t compression = 0, photometric = 0;\n\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n        TIFFGetField(tif, TIFFTAG_COMPRESSION, &compression);\n        TIFFGetField(tif, TIFFTAG_PHOTOMETRIC, &photometric);\n\n        // Basic sanity checks to exercise the values\n        if (width > 0 && height > 0 && bits_per_sample > 0 && samples_per_pixel > 0) {\n            // Just touch the values to prevent optimization\n            volatile uint32_t dummy = width + height + bits_per_sample + samples_per_pixel + compression + photometric;\n            (void)dummy;\n        }\n\n        TIFFClose(tif);\n    }\n\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":171,"completion_tokens":472,"total_tokens":643,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":43},"