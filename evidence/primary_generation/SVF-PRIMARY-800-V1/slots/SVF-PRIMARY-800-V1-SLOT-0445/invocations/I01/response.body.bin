{"id":"6c33e6c0-324c-465f-a0e7-1ec2d3f060e1","object":"chat.completion","created":1786293351,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (!tif) {\n        unlink(filename);\n        return 0;\n    }\n\n    // Process the first directory\n    if (TIFFReadDirectory(tif)) {\n        uint32_t w = 0, h = 0;\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &w);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &h);\n        if (w > 0 && h > 0 && w < 10000 && h < 10000) {\n            tmsize_t scanline_size = TIFFScanlineSize(tif);\n            if (scanline_size > 0) {\n                uint8_t *buf = (uint8_t *)malloc(scanline_size);\n                if (buf) {\n                    for (uint32_t row = 0; row < h; row++) {\n                        if (TIFFReadScanline(tif, buf, row, 0) < 0) break;\n                    }\n                    free(buf);\n                }\n            }\n        }\n    }\n\n    // Process subsequent directories if present\n    while (TIFFReadDirectory(tif)) {\n        uint32_t w = 0, h = 0;\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &w);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &h);\n        if (w > 0 && h > 0 && w < 10000 && h < 10000) {\n            tmsize_t scanline_size = TIFFScanlineSize(tif);\n            if (scanline_size > 0) {\n                uint8_t *buf = (uint8_t *)malloc(scanline_size);\n                if (buf