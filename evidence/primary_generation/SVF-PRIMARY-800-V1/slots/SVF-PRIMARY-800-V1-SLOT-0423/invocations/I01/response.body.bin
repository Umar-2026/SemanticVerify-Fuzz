{"id":"747b799b-a13e-45e6-88c6-c4451199f6b2","object":"chat.completion","created":1786293264,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary file to hold the fuzz data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (tif) {\n        uint32_t width = 0, height = 0;\n        uint16_t samples_per_pixel = 0, bits_per_sample = 0;\n        uint16_t planar_config = 0;\n        uint32_t *raster = NULL;\n\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n        TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n\n        // Basic sanity checks to avoid excessive allocation\n        if (width > 0 && height > 0 && width <= 10000 && height <= 10000 &&\n            samples_per_pixel > 0 && samples_per_pixel <= 4 &&\n            bits_per_sample == 8 && planar_config == PLANARCONFIG_CONTIG) {\n            size_t npixels = (size_t)width * height;\n            raster = (uint32_t *)malloc(npixels * sizeof(uint32_t));\n            if (raster) {\n                if (TIFFReadRGBAImage(tif, width, height, raster, 0)) {\n                    // Inspect a few pixels to ensure the data is accessible\n                    volatile uint32_t sum = 0;\n                    for (size_t i = 0; i < npixels && i < 1024; i++) {\n                        sum += raster[i];\n                    }\n                    (void)sum;\n                }\n                free(raster);\n            }\n        }\n\n        TIFFClose(tif);\n    }\n\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":164,"completion_tokens":578,"total_tokens":742,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":36},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}