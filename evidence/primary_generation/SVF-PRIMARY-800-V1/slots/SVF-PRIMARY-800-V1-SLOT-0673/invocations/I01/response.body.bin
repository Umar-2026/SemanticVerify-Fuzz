{"id":"4f290efb-4efe-43ee-b780-e15ee4b92928","object":"chat.completion","created":1786351248,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ares.h>\n\ntypedef struct {\n    int done;\n    int got_record;\n} query_state;\n\nstatic void query_callback(void *arg, int status, int timeouts, ares_dns_record_t *dnsrec) {\n    query_state *state = (query_state *)arg;\n    (void)timeouts;\n    if (status == ARES_SUCCESS && dnsrec != NULL) {\n        state->got_record = 1;\n    }\n    state->done = 1;\n    if (dnsrec != NULL) {\n        ares_dns_record_destroy(dnsrec);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL) {\n        return 0;\n    }\n\n    ares_channel_t *channel = NULL;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n\n    if (ares_init_options(&channel, &options, 0) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    if (ares_set_servers_csv(channel, server_csv) != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    /* Build a bounded hostname from fuzz input: up to 63 chars, alphanumeric and hyphen */\n    char name[64];\n    size_t name_len = size > 63 ? 63 : size;\n    size_t i;\n    for (i = 0; i < name_len; i++) {\n        char c = (char)data[i];\n        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-') {\n            name[i] = c;\n        } else {\n            name[i] = 'a';\n        }\n    }\n    name[name_len] = '\\0';\n\n    query_state state;\n    state.done = 0;\n    state.got_record = 0;\n\n    ares_dns_record_t *dnsrec = NULL;\n    ares_status_t status = ares_query_dnsrec(channel, &dnsrec, name, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &state, NULL);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    /* Wait for the callback to complete (bounded by ares' internal timeouts) */\n    int nfds;\n    ares_pollfd_t *pollfds = NULL;\n    while (!state.done) {\n        if (ares_get_pollfds(channel, &pollfds, &nfds) != ARES_SUCCESS) {\n            break;\n        }\n        if (nfds == 0) {\n            break;\n        }\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000; /* 100 ms */\n        int res = ares_poll(pollfds, nfds, &tv);\n        if (res < 0) {\n            break;\n        }\n        ares_process_fd(channel, ARES_SOCKET_BAD, ARES_SOCKET_BAD);\n        ares_free_pollfds(pollfds);\n        pollfds = NULL;\n    }\n    if (pollfds != NULL) {\n        ares_free_pollfds(pollfds);\n    }\n\n    /* Produce binary result: 1 if got a record, 0 otherwise */\n    uint8_t result = state.got_record ? 1 : 0;\n    (void)result; /* result is the fuzz output; in this harness we just return */\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":236,"completion_tokens":891,"total_tokens":1127,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":108},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}