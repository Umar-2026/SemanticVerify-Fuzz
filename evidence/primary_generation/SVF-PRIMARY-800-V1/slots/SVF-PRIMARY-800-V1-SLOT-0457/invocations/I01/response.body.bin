{"id":"a46c334b-7c49-49a2-a04c-b847f3cb69b0","object":"chat.completion","created":1786293406,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    size_t written = 0;\n    while (written < size) {\n        ssize_t n = write(fd, data + written, size - written);\n        if (n <= 0) break;\n        written += (size_t)n;\n    }\n    close(fd);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    unlink(filename);\n    if (!tif) return 0;\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel;\n    if (TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width) != 1 ||\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height) != 1 ||\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample) != 1 ||\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel) != 1) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    tmsize_t scanline_size = TIFFScanlineSize(tif);\n    if (scanline_size <= 0) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Allocate a dynamically sized buffer for one scanline\n    uint8_t *buf = (uint8_t *)malloc((size_t)scanline_size);\n    if (!buf) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Read all scanlines\n    for (uint32_t row = 0; row < height; row++) {\n        if (TIFFReadScanline(tif, buf, row, 0) < 0) {\n            break;\n        }\n        // Inspect the data: compute a simple checksum to force reading\n        volatile uint32_t sum = 0;\n        for (tmsize_t i = 0; i < scanline_size; i++) {\n            sum += buf[i];\n        }\n        (void)sum;\n    }\n\n    free(buf);\n    TIFFClo