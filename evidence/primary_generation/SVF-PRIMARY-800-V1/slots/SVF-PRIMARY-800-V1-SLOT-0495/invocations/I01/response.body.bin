{"id":"5d14136b-1bba-49f0-8fd6-c6ed5fe02df1","object":"chat.completion","created":1786350267,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (!tif) {\n        unlink(filename);\n        return 0;\n    }\n\n    // Inspect image metadata\n    uint32_t width = 0, height = 0;\n    uint16_t bits_per_sample = 0, samples_per_pixel = 0;\n    uint16_t planar_config = 0;\n    uint32_t rows_per_strip = 0;\n    uint32_t strips_per_image = 0;\n\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n    TIFFGetField(tif, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);\n\n    if (width == 0 || height == 0 || rows_per_strip == 0) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    strips_per_image = (height + rows_per_strip - 1) / rows_per_strip;\n\n    // Attempt to read representative image data from a few strips\n    // Limit the number of strips read to avoid excessive work\n    uint32_t max_strips = strips_per_image < 4 ? strips_per_image : 4;\n    for (uint32_t s = 0; s < max_strips; s++) {\n        tmsize_t strip_size = TIFFStripSize(tif);\n        if (strip_size <= 0) break;\n        // Allocate a buffer for the strip data\n        unsigned char *buf = (unsigned char *)malloc(strip_size);\n        if (!buf) break;\n        if (TIFFReadEncodedStrip(tif, s, buf, strip_size) < 0) {\n            free(buf);\n            break;\n        }\n        free(buf);\n    }\n\n    TIFFClose(tif);\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":173,"completion_tokens":652,"total_tokens":825,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":45},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}