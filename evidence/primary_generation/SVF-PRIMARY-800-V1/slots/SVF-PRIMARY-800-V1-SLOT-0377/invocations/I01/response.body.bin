{"id":"4d6b4a0f-2f23-41de-9762-7989bc46cc84","object":"chat.completion","created":1786293022,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"cJSON.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    cJSON *root = cJSON_CreateObject();\n    if (root == NULL) {\n        return 0;\n    }\n\n    cJSON *array = cJSON_CreateArray();\n    if (array == NULL) {\n        cJSON_Delete(root);\n        return 0;\n    }\n\n    cJSON_AddItemToObject(root, \"items\", array);\n\n    size_t offset = 0;\n    size_t num_children = data[offset++] % 8;  // 0 to 7 children\n    if (offset + num_children > size) {\n        cJSON_Delete(root);\n        return 0;\n    }\n\n    for (size_t i = 0; i < num_children; i++) {\n        uint8_t type = data[offset++];\n        cJSON *child = NULL;\n\n        switch (type % 4) {\n            case 0: {\n                // Create a child object with a fuzz-derived key and value\n                if (offset + 2 > size) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                uint8_t key_len = data[offset] % 16;\n                offset++;\n                if (offset + key_len > size) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                char *key = (char *)malloc(key_len + 1);\n                if (key == NULL) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                memcpy(key, data + offset, key_len);\n                key[key_len] = '\\0';\n                offset += key_len;\n\n                uint8_t val_type = data[offset++];\n                cJSON *val = NULL;\n                if (val_type % 2 == 0) {\n                    val = cJSON_CreateNumber((double)(data[offset] % 100));\n                } else {\n                    if (offset + 1 > size) {\n                        free(key);\n                        cJSON_Delete(root);\n                        return 0;\n                    }\n                    uint8_t str_len = data[offset] % 16;\n                    offset++;\n                    if (offset + str_len > size) {\n                        free(key);\n                        cJSON_Delete(root);\n                        return 0;\n                    }\n                    char *str = (char *)malloc(str_len + 1);\n                    if (str == NULL) {\n                        free(key);\n                        cJSON_Delete(root);\n                        return 0;\n                    }\n                    memcpy(str, data + offset, str_len);\n                    str[str_len] = '\\0';\n                    offset += str_len;\n                    val = cJSON_CreateString(str);\n                    free(str);\n                }\n                if (val == NULL) {\n                    free(key);\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                child = cJSON_CreateObject();\n                if (child == NULL) {\n                    cJSON_Delete(val);\n                    free(key);\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                cJSON_AddItemToObject(child, key, val);\n                free(key);\n                break;\n            }\n            case 1: {\n                // Create a number child\n                if (offset + 1 > size) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                child = cJSON_CreateNumber((double)(data[offset] % 1000));\n                offset++;\n                break;\n            }\n            case 2: {\n                // Create a string child\n                if (offset + 1 > size) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                uint8_t str_len = data[offset] % 16;\n                offset++;\n                if (offset + str_len > size) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                char *str = (char *)malloc(str_len + 1);\n                if (str == NULL) {\n                    cJSON_Delete(root);\n                    return 0;\n                }\n                memcpy(str, data + offset, str_len);\n                str[str_len] = '\\0';\n                offset += str_len;\n                child = cJSON_CreateString(str);\n                free(str);\n                break;\n            }\n            case 3: {\n                // Create a boolean child\n                child = cJSON_CreateBool(data[offset] % 2);\n                offset++;\n                break;\n            }\n            default:\n                child = NULL;\n                break;\n        }\n\n        if (child != NULL) {\n            cJSON_AddItemToArray(array, child);\n        } else {\n            cJSON_Delete(root);\n            return 0;\n        }\n    }\n\n    cJSON_Delete(root);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":184,"completion_tokens":1039,"total_tokens":1223,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":56},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}