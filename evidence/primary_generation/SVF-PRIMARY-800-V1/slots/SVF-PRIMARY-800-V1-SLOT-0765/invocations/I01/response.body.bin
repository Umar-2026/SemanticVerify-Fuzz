{"id":"39a39f45-5af2-4bae-b730-5dfdd36d416f","object":"chat.completion","created":1786351691,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include \"lcms2.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Split input into two halves for two profiles\n    size_t half = size / 2;\n    const uint8_t *data1 = data;\n    size_t size1 = half;\n    const uint8_t *data2 = data + half;\n    size_t size2 = size - half;\n\n    cmsHPROFILE hProfile1 = NULL;\n    cmsHPROFILE hProfile2 = NULL;\n\n    // First profile: try to open from memory, if fails create sRGB\n    hProfile1 = cmsOpenProfileFromMem(data1, size1);\n    if (!hProfile1) {\n        hProfile1 = cmsCreate_sRGBProfile();\n    }\n\n    // Second profile: try to open from memory, if fails create sRGB\n    hProfile2 = cmsOpenProfileFromMem(data2, size2);\n    if (!hProfile2) {\n        hProfile2 = cmsCreate_sRGBProfile();\n    }\n\n    if (!hProfile1 || !hProfile2) {\n        if (hProfile1) cmsCloseProfile(hProfile1);\n        if (hProfile2) cmsCloseProfile(hProfile2);\n        return 0;\n    }\n\n    // Inspect information from each profile\n    cmsInfoType infoTypes[] = {\n        cmsInfoDescription,\n        cmsInfoManufacturer,\n        cmsInfoModel,\n        cmsInfoCopyright\n    };\n\n    char buffer[256];\n    for (int i = 0; i < 4; i++) {\n        cmsGetProfileInfoASCII(hProfile1, infoTypes[i], \"en\", \"US\", buffer, sizeof(buffer));\n        cmsGetProfileInfoASCII(hProfile2, infoTypes[i], \"en\", \"US\", buffer, sizeof(buffer));\n    }\n\n    // Get color space and PCS\n    cmsColorSpaceSignature cs1 = cmsGetColorSpace(hProfile1);\n    cmsColorSpaceSignature cs2 = cmsGetColorSpace(hProfile2);\n    cmsColorSpaceSignature pcs1 = cmsGetPCS(hProfile1);\n    cmsColorSpaceSignature pcs2 = cmsGetPCS(hProfile2);\n\n    // Get device class\n    cmsProfileClassSignature class1 = cmsGetDeviceClass(hProfile1);\n    cmsProfileClassSignature class2 = cmsGetDeviceClass(hProfile2);\n\n    // Get rendering intent\n    cmsUInt32Number intent1 = cmsGetHeaderRenderingIntent(hProfile1);\n    cmsUInt32Number intent2 = cmsGetHeaderRenderingIntent(hProfile2);\n\n    // Get version\n    cmsFloat64Number version1 = cmsGetProfileVersion(hProfile1);\n    cmsFloat64Number version2 = cmsGetProfileVersion(hProfile2);\n\n    // Get flags\n    cmsUInt32Number flags1 = cmsGetHeaderFlags(hProfile1);\n    cmsUInt32Number flags2 = cmsGetHeaderFlags(hProfile2);\n\n    // Get manufacturer and model\n    cmsUInt32Number manufacturer1 = cmsGetHeaderManufacturer(hProfile1);\n    cmsUInt32Number manufacturer2 = cmsGetHeaderManufacturer(hProfile2);\n    cmsUInt32Number model1 = cmsGetHeaderModel(hProfile1);\n    cmsUInt32Number model2 = cmsGetHeaderModel(hProfile2);\n\n    // Get attributes\n    cmsUInt64Number attributes1 = cmsGetHeaderAttributes(hProfile1);\n    cmsUInt64Number attributes2 = cmsGetHeaderAttributes(hProfile2);\n\n    // Get creator\n    cmsUInt32Number creator1 = cmsGetHeaderCreator(hProfile1);\n    cmsUInt32Number creator2 = cmsGetHeaderCreator(hProfile2);\n\n    // Get profile ID\n    cmsProfileID profileID1, profileID2;\n    cmsGetHeaderProfileID(hProfile1, &profileID1);\n    cmsGetHeaderProfileID(hProfile2, &profileID2);\n\n    // Get tag count\n    cmsInt32Number tagCount1 = cmsGetTagCount(hProfile1);\n    cmsInt32Number tagCount2 = cmsGetTagCount(hProfile2);\n\n    // Get tag signatures\n    if (tagCount1 > 0 && tagCount1 < 100) {\n        for (cmsInt32Number i = 0; i < tagCount1; i++) {\n            cmsTagSignature sig = cmsGetTagSignature(hProfile1, i);\n            (void)sig;\n        }\n    }\n    if (tagCount2 > 0 && tagCount2 < 100) {\n        for (cmsInt32Number i = 0; i < tagCount2; i++) {\n            cmsTagSignature sig = cmsGetTagSignature(hProfile2, i);\n            (void)sig;\n        }\n    }\n\n    // Check if profiles are matrix-shaper or LUT based\n    cmsBool isMatrixShaper1 = cmsIsMatrixShaper(hProfile1);\n    cmsBool isMatrixShaper2 = cmsIsMatrixShaper(hProfile2);\n    cmsBool isCLM1 = cmsIsCLM(hProfile1);\n    cmsBool isCLM2 = cmsIsCLM(hProfile2);\n\n    // Get intent count and descriptions\n    cmsUInt32Number intentCount1 = cmsGetHeaderIntentCount(hProfile1);\n    cmsUInt32Number intentCount2 = cmsGetHeaderIntentCount(hProfile2);\n\n    // Get supported intents\n    cmsUInt32Number supportedIntents1[16];\n    cmsUInt32Number supportedIntents2[16];\n    cmsGetSupportedIntents(16, supportedIntents1);\n    cmsGetSupportedIntents(16, supportedIntents2);\n\n    // Get profile info in different languages\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n\n    // Get profile info in Unicode\n    cmsUInt16Number unicodeBuffer[128];\n    cmsGetProfileInfo(hProfile1, cmsInfoDescription, \"en\", \"US\", unicodeBuffer, sizeof(unicodeBuffer));\n    cmsGetProfileInfo(hProfile2, cmsInfoDescription, \"en\", \"US\", unicodeBuffer, sizeof(unicodeBuffer));\n\n    // Get profile info in C locale\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"en\", \"US\", buffer, sizeof(buffer));\n\n    // Get profile info in default locale\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, NULL, NULL, buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, NULL, NULL, buffer, sizeof(buffer));\n\n    // Get profile info in specific language\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"fr\", \"FR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"fr\", \"FR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"en\", \"GB\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"en\", \"GB\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"de\", \"DE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"de\", \"DE\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"es\", \"ES\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"es\", \"ES\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"it\", \"IT\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"it\", \"IT\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ja\", \"JP\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ja\", \"JP\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ko\", \"KR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ko\", \"KR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"zh\", \"CN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"zh\", \"CN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ru\", \"RU\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ru\", \"RU\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"pt\", \"BR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"pt\", \"BR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ar\", \"SA\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ar\", \"SA\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"hi\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"hi\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"tr\", \"TR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"tr\", \"TR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"pl\", \"PL\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"pl\", \"PL\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"nl\", \"NL\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"nl\", \"NL\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sv\", \"SE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sv\", \"SE\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"fi\", \"FI\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"fi\", \"FI\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"da\", \"DK\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"da\", \"DK\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"no\", \"NO\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"no\", \"NO\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"el\", \"GR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"el\", \"GR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"cs\", \"CZ\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"cs\", \"CZ\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"hu\", \"HU\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"hu\", \"HU\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ro\", \"RO\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ro\", \"RO\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"uk\", \"UA\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"uk\", \"UA\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"th\", \"TH\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"th\", \"TH\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"vi\", \"VN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"vi\", \"VN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"id\", \"ID\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"id\", \"ID\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ms\", \"MY\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ms\", \"MY\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"fa\", \"IR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"fa\", \"IR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"he\", \"IL\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"he\", \"IL\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sw\", \"KE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sw\", \"KE\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"bn\", \"BD\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"bn\", \"BD\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ta\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ta\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"te\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"te\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"mr\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"mr\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"gu\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"gu\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"kn\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"kn\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ml\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ml\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"pa\", \"IN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"pa\", \"IN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ne\", \"NP\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ne\", \"NP\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"si\", \"LK\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"si\", \"LK\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"km\", \"KH\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"km\", \"KH\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"lo\", \"LA\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"lo\", \"LA\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"my\", \"MM\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"my\", \"MM\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"ka\", \"GE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"ka\", \"GE\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"hy\", \"AM\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"hy\", \"AM\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"az\", \"AZ\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"az\", \"AZ\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"uz\", \"UZ\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"uz\", \"UZ\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"kk\", \"KZ\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"kk\", \"KZ\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"mn\", \"MN\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"mn\", \"MN\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"is\", \"IS\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"is\", \"IS\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"lt\", \"LT\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"lt\", \"LT\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"lv\", \"LV\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"lv\", \"LV\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"et\", \"EE\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"et\", \"EE\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sq\", \"AL\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sq\", \"AL\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"mk\", \"MK\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"mk\", \"MK\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"bs\", \"BA\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"bs\", \"BA\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"hr\", \"HR\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"hr\", \"HR\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sr\", \"RS\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sr\", \"RS\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sk\", \"SK\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sk\", \"SK\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"sl\", \"SI\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"sl\", \"SI\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"bg\", \"BG\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"bg\", \"BG\", buffer, sizeof(buffer));\n\n    // Get profile info in specific language and country\n    cmsGetProfileInfoASCII(hProfile1, cmsInfoDescription, \"be\", \"BY\", buffer, sizeof(buffer));\n    cmsGetProfileInfoASCII(hProfile2, cmsInfoDescription, \"b