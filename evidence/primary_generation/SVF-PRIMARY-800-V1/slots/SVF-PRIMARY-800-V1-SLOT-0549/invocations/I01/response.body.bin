{"id":"f779757c-4909-4c02-89ee-153e15ef8dd4","object":"chat.completion","created":1786350459,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <vpx/vpx_encoder.h>\n#include <vpx/vp8cx.h>\n\n#define WIDTH 64\n#define HEIGHT 64\n#define FRAME_SIZE (WIDTH * HEIGHT * 3 / 2)\n\nstatic void generate_frame(vpx_image_t *img, unsigned int seed) {\n    unsigned int x, y;\n    unsigned char *plane;\n    unsigned int stride;\n    unsigned int val;\n\n    plane = img->planes[0];\n    stride = img->stride[0];\n    for (y = 0; y < HEIGHT; y++) {\n        for (x = 0; x < WIDTH; x++) {\n            val = (seed + x * 3 + y * 5) & 0xff;\n            plane[y * stride + x] = (unsigned char)val;\n        }\n    }\n\n    plane = img->planes[1];\n    stride = img->stride[1];\n    for (y = 0; y < HEIGHT / 2; y++) {\n        for (x = 0; x < WIDTH / 2; x++) {\n            val = (seed + x * 7 + y * 11) & 0xff;\n            plane[y * stride + x] = (unsigned char)val;\n        }\n    }\n\n    plane = img->planes[2];\n    stride = img->stride[2];\n    for (y = 0; y < HEIGHT / 2; y++) {\n        for (x = 0; x < WIDTH / 2; x++) {\n            val = (seed + x * 13 + y * 17) & 0xff;\n            plane[y * stride + x] = (unsigned char)val;\n        }\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    vpx_codec_ctx_t codec;\n    vpx_codec_enc_cfg_t cfg;\n    vpx_image_t *img1 = NULL;\n    vpx_image_t *img2 = NULL;\n    vpx_codec_iter_t iter = NULL;\n    const vpx_codec_cx_pkt_t *pkt;\n    unsigned int seed1, seed2;\n    int ret;\n\n    if (size < 8) {\n        return 0;\n    }\n\n    seed1 = (unsigned int)data[0] | ((unsigned int)data[1] << 8) |\n            ((unsigned int)data[2] << 16) | ((unsigned int)data[3] << 24);\n    seed2 = (unsigned int)data[4] | ((unsigned int)data[5] << 8) |\n            ((unsigned int)data[6] << 16) | ((unsigned int)data[7] << 24);\n\n    vpx_codec_dec_cfg_t dec_cfg;\n    memset(&dec_cfg, 0, sizeof(dec_cfg));\n    dec_cfg.threads = 1;\n    dec_cfg.w = WIDTH;\n    dec_cfg.h = HEIGHT;\n\n    ret = vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0);\n    if (ret != VPX_CODEC_OK) {\n        return 0;\n    }\n\n    cfg.g_w = WIDTH;\n    cfg.g_h = HEIGHT;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    ret = vpx_codec_enc_init(&codec, vpx_codec_vp8_cx(), &cfg, 0);\n    if (ret != VPX_CODEC_OK) {\n        return 0;\n    }\n\n    img1 = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, WIDTH, HEIGHT, 1);\n    img2 = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, WIDTH, HEIGHT, 1);\n    if (!img1 || !img2) {\n        vpx_img_free(img1);\n        vpx_img_free(img2);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    generate_frame(img1, seed1);\n    generate_frame(img2, seed2);\n\n    ret = vpx_codec_encode(&codec, img1, 0, 1, 0, VPX_DL_REALTIME);\n    if (ret != VPX_CODEC_OK) {\n        vpx_img_free(img1);\n        vpx_img_free(img2);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    iter = NULL;\n    while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n        if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n            /* consume packet */\n        }\n    }\n\n    ret = vpx_codec_encode(&codec, img2, 1, 1, 0, VPX_DL_REALTIME);\n    if (ret != VPX_CODEC_OK) {\n        vpx_img_free(img1);\n        vpx_img_free(img2);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    iter = NULL;\n    while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n        if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n            /* consume packet */\n        }\n    }\n\n    vpx_img_free(img1);\n    vpx_img_free(img2);\n    vpx_codec_destroy(&codec);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":167,"completion_tokens":1245,"total_tokens":1412,"prompt_tokens_details":{"cached_tokens":