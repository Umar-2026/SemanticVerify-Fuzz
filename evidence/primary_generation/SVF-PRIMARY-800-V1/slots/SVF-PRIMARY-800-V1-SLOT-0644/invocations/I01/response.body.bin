            "text": "#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cares.h\u003e\n\ntypedef struct {\n    int completed;\n} user_data_t;\n\nstatic void callback(void *arg, int status, int timeouts, unsigned char *abuf, int alen) {\n    user_data_t *data = (user_data_t *)arg;\n    data-\u003ecompleted = 1;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 10) return 0;\n\n    ares_channel channel;\n    struct ares_options options;\n    int optmask = 0;\n    \n    if (ares_init_options(&channel, &options, optmask) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    char *server_list = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_list) {\n        ares_set_servers_csv(channel, server_list);\n    }\n\n    char name1[64] = {0};\n    char name2[64] = {0};\n    size_t len1 = (size / 2) - 1;\n    size_t len2 = (size / 2) - 1;\n    if (len1 \u003e 63) len1 = 63;\n    if (len2 \u003e 63) len2 = 63;\n\n    memcpy(name1, data, len1);\n    memcpy(name2, data + (size / 2), len2);\n\n    user_data_t ctx1 = {0};\n    user_data_t ctx2 = {0};\n\n    ares_query_dnsrec(channel, name1, ARES_CLASS_IN, ARES_REC_TYPE_A, callback, &ctx1);\n    ares_query_dnsrec(channel, name2, ARES_CLASS_IN, ARES_REC_TYPE_A, callback, &ctx2);\n\n    for (int i = 0; i \u003c 100; i++) {\n        struct timeval tv, *tvp;\n        fd_set read_fds, write_fds;\n        int nfds;\n\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) break;\n\n        tvp = ares_timeout(channel, NULL, &tv);\n        select(nfds, &read_fds, &write_fds, NULL, tvp);\n        ares_process(channel, &read_fds, &write_fds);\n\n        if (ctx1.completed && ctx2.completed) break;\n    }\n\n    ares_destroy(channel);\n    return 0;\n}",
