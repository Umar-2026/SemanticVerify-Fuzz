            "text": "#include \u003ctiffio.h\u003e\n#include \u003cstdint.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 10) return 0;\n\n    TIFFSetErrorHandler(NULL);\n    TIFFSetWarningHandler(NULL);\n\n    TIFF *tif = TIFFStreamOpen(\"fuzz.tiff\", data, size);\n    if (!tif) return 0;\n\n    uint32_t width, height;\n    if (TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width) &&\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height)) {\n        \n        tsize_t scanline_size = TIFFScanlineSize(tif);\n        if (scanline_size \u003e 0 && scanline_size \u003c 1024 * 1024) {\n            void *buf = malloc(scanline_size);\n            if (buf) {\n                for (uint32_t row = 0; row \u003c height && row \u003c 16; row++) {\n                    TIFFReadScanline(tif, buf, row, 0);\n                }\n                free(buf);\n            }\n        }\n\n        tstrip_t nstrips = TIFFNumberOfStrips(tif);\n        if (nstrips \u003e 0 && nstrips \u003c 1024) {\n            tsize_t strip_size = TIFFStripSize(tif);\n            if (strip_size \u003e 0 && strip_size \u003c 1024 * 1024) {\n                void *strip_buf = malloc(strip_size);\n                if (strip_buf) {\n                    for (tstrip_t s = 0; s \u003c nstrips && s \u003c 16; s++) {\n                        TIFFReadEncodedStrip(tif, s, strip_buf, strip_size);\n                    }\n                    free(strip_buf);\n                }\n            }\n        }\n    }\n\n    TIFFClose(tif);\n    return 0;\n}",
