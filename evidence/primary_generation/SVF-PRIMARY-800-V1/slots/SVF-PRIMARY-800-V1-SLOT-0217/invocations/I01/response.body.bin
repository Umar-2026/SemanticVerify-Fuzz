{"id":"e5b760a9-dae6-40c6-be87-9e6e0fba9e35","object":"chat.completion","created":1786292473,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <curl/curl.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        return 0;\n    }\n\n    // Use first byte to select a local file path variant\n    const char *path = \"/tmp/fuzz_input\";\n    if (data[0] & 1) {\n        path = \"/etc/hostname\";\n    }\n\n    // Build file:// URL\n    char url[256];\n    snprintf(url, sizeof(url), \"file://%s\", path);\n\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, NULL);\n\n    // Bounded input-derived options\n    if (size > 1) {\n        long timeout = (long)(data[1] % 10);\n        curl_easy_setopt(curl, CURLOPT_TIMEOUT, timeout);\n    }\n    if (size > 2) {\n        long connect_timeout = (long)(data[2] % 5);\n        curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, connect_timeout);\n    }\n    if (size > 3) {\n        long low_speed_limit = (long)(data[3] % 100);\n        curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, low_speed_limit);\n    }\n    if (size > 4) {\n        long low_speed_time = (long)(data[4] % 30);\n        curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, low_speed_time);\n    }\n\n    curl_easy_perform(curl);\n    curl_easy_cleanup(curl);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":179,"completion_tokens":505,"total_tokens":684,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"p