{"id":"4eabc79a-affa-4544-8fc0-d84876acc31c","object":"chat.completion","created":1786350990,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <ares.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int optmask = ARES_OPT_FLAGS;\n\n    int status = ares_init_options(&channel, &options, optmask);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv != NULL && server_csv[0] != '\\0') {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    // Build a bounded domain name from fuzz input.\n    // Use at most 63 characters for a single label, and ensure NUL termination.\n    char domain[64];\n    size_t len = size;\n    if (len > 63) len = 63;\n    memcpy(domain, data, len);\n    domain[len] = '\\0';\n    // Ensure the domain is not empty; if it is, use a default.\n    if (len == 0) {\n        strcpy(domain, \"example.com\");\n    }\n\n    // Prepare callback data.\n    int callback_called = 0;\n    int callback_status = ARES_ENOTFOUND;\n\n    // Issue an A-record query.\n    ares_query_dnsrec(channel, domain, ARES_CLASS_IN, ARES_REC_TYPE_A,\n                      (ares_callback_dnsrec)NULL, &callback_called);\n\n    // Wait for the callback to complete, with a bounded timeout.\n    int nfds;\n    fd_set readers, writers;\n    struct timeval tv;\n    tv.tv_sec = 1;\n    tv.tv_usec = 0;\n    for (int i = 0; i < 10; i++) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        nfds = ares_fds(channel, &readers, &writers);\n        if (nfds == 0) break;\n        if (select(nfds, &readers, &writers, NULL, &tv) < 0) break;\n        ares_process(channel, &readers, &writers);\n        if (callback_called) break;\n    }\n\n    // Cleanup.\n    ares_destroy(channel);\n    return 0;\n}\n\n#ifdef __cplusplus\n}\n#endif"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":232,"completion_tokens":591,"total_tokens":823,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":104},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}