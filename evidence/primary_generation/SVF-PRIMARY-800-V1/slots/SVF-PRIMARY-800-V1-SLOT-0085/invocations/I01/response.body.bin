{"id":"19c9a273-5326-4cbd-92ac-0a8995ca5518","object":"chat.completion","created":1786291895,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    z_stream strm;\n    memset(&strm, 0, sizeof(strm));\n\n    if (inflateInit(&strm) != Z_OK) {\n        return 0;\n    }\n\n    // Use first byte to decide windowBits for inflateInit2? No, we already used inflateInit.\n    // We'll just use the data as compressed stream.\n\n    strm.next_in = (Bytef *)data;\n    strm.avail_in = (uInt)size;\n\n    // Output buffer\n    unsigned char out[256];\n    int ret;\n    int total_out = 0;\n\n    // Feed in chunks to exercise streaming behavior\n    size_t consumed = 0;\n    while (consumed < size) {\n        size_t chunk = size - consumed;\n        if (chunk > 64) chunk = 64;\n        strm.next_in = (Bytef *)(data + consumed);\n        strm.avail_in = (uInt)chunk;\n        consumed += chunk;\n\n        do {\n            strm.next_out = out;\n            strm.avail_out = sizeof(out);\n            ret = inflate(&strm, Z_NO_FLUSH);\n            total_out += (int)(sizeof(out) - strm.avail_out);\n\n            if (ret == Z_STREAM_END) {\n                // Successfully decompressed to end\n                inflateEnd(&strm);\n                return 0;\n            }\n            if (ret == Z_NEED_DICT) {\n                // Dictionary needed, not supported\n                inflateEnd(&strm);\n                return 0;\n            }\n            if (ret == Z_DATA_ERROR || ret == Z_STREAM_ERROR || ret == Z_MEM_ERROR) {\n                // Error occurred\n                inflateEnd(&strm);\n                return 0;\n            }\n            // Z_OK or Z_BUF_ERROR: continue\n        } while (strm.avail_out == 0 && ret != Z_BUF_ERROR);\n    }\n\n    //