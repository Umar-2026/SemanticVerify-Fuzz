{"id":"04a27f9b-7bad-4e4f-907d-192fa6f70564","object":"chat.completion","created":1786351866,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <lcms2.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) return 0;\n\n    cmsHPROFILE input_profile = cmsOpenProfileFromMem(data, size);\n    if (!input_profile) return 0;\n\n    cmsHPROFILE output_profile = cmsCreate_sRGBProfile();\n    if (!output_profile) {\n        cmsCloseProfile(input_profile);\n        return 0;\n    }\n\n    cmsUInt32Number input_format = TYPE_RGBA_8;\n    cmsUInt32Number output_format = TYPE_RGBA_8;\n    cmsUInt32Number intent = INTENT_PERCEPTUAL;\n    cmsUInt32Number flags = cmsFLAGS_NOCACHE | cmsFLAGS_NOOPTIMIZE;\n\n    cmsHTRANSFORM transform = cmsCreateTransform(input_profile, input_format,\n                                                 output_profile, output_format,\n                                                 intent, flags);\n    if (!transform) {\n        cmsCloseProfile(output_profile);\n        cmsCloseProfile(input_profile);\n        return 0;\n    }\n\n    // Representative pixel data: 16 pixels of RGBA, each channel 0..255\n    uint8_t pixels[64];\n    for (int i = 0; i < 64; i++) {\n        pixels[i] = (uint8_t)(i * 4); // deterministic pattern\n    }\n\n    cmsDoTransform(transform, pixels, pixels, 16);\n\n    cmsDeleteTransform(transform);\n    cmsCloseProfile(output_profile);\n    cmsCloseProfile(input_profile);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":184,"completion_tokens":369,"total_tokens":553,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":56},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}