{"id":"dc1d8195-6381-43dd-917c-89742703b6c1","object":"chat.completion","created":1786292772,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <curl/curl.h>\n\nstatic size_t write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    size_t total = size * nmemb;\n    char **buf = (char **)userdata;\n    size_t cur_len = *buf ? strlen(*buf) : 0;\n    char *newbuf = realloc(*buf, cur_len + total + 1);\n    if (!newbuf) return 0;\n    memcpy(newbuf + cur_len, ptr, total);\n    newbuf[cur_len + total] = '\\0';\n    *buf = newbuf;\n    return total;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) return 0;\n\n    // Bounded configuration from fuzz input\n    long timeout_ms = 1 + (data[0] % 1000);\n    long connect_timeout_ms = 1 + (data[1] % 1000);\n    int follow_redirects = data[2] % 2;\n    int verbose = data[3] % 2;\n\n    // Local file source: use a fixed path, content is not fuzz-controlled\n    const char *url = \"file:///tmp/curl_fuzz_input.txt\";\n\n    // Application output buffer\n    char *output = NULL;\n\n    // Library setup\n    if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) {\n        return 0;\n    }\n\n    CURL *easy = curl_easy_init();\n    if (!easy) {\n        curl_global_cleanup();\n        return 0;\n    }\n\n    // Configure easy transfer\n    curl_easy_setopt(easy, CURLOPT_URL, url);\n    curl_easy_setopt(easy, CURLOPT_TIMEOUT_MS, timeout_ms);\n    curl_easy_setopt(easy, CURLOPT_CONNECTTIMEOUT_MS, connect_timeout_ms);\n    curl_easy_setopt(easy, CURLOPT_FOLLOWLOCATION, follow_redirects);\n    curl_easy_setopt(easy, CURLOPT_VERBOSE, verbose);\n    curl_easy_setopt(easy, CURLOPT_WRITEFUNCTION, write_cb);\n    curl_easy_setopt(easy, CURLOPT_WRITEDATA, &output);\n\n    // Perform transfer\n    CURLcode res = curl_easy_perform(easy);\n\n    // Cleanup\n    curl_easy_cleanup(easy);\n    curl_global_cleanup();\n\n    if (output) {\n        free(output);\n    }\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":193,"completion_tokens":597,"total_tokens":790,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":65},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}