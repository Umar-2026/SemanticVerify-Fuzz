{"id":"22d25c43-cb4e-43e9-8bb6-98d72519c6ca","object":"chat.completion","created":1786351637,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include \"lcms2.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    cmsHPROFILE hIn = cmsCreate_sRGBProfile();\n    cmsHPROFILE hOut = cmsCreateLab4Profile(NULL);\n    if (!hIn || !hOut) {\n        if (hIn) cmsCloseProfile(hIn);\n        if (hOut) cmsCloseProfile(hOut);\n        return 0;\n    }\n\n    cmsHTRANSFORM hTransform = cmsCreateTransform(hIn, TYPE_RGB_8, hOut, TYPE_Lab_DBL, INTENT_PERCEPTUAL, 0);\n    cmsCloseProfile(hIn);\n    cmsCloseProfile(hOut);\n    if (!hTransform) return 0;\n\n    size_t half = size / 2;\n    const uint8_t *data1 = data;\n    const uint8_t *data2 = data + half;\n    size_t size1 = half;\n    size_t size2 = size - half;\n\n    // Each pixel is 3 bytes (RGB 8-bit). Process as many complete pixels as possible.\n    size_t pixels1 = size1 / 3;\n    size_t pixels2 = size2 / 3;\n    if (pixels1 == 0 || pixels2 == 0) {\n        cmsDeleteTransform(hTransform);\n        return 0;\n    }\n\n    // Allocate output buffers for Lab double (3 doubles per pixel)\n    size_t outSize1 = pixels1 * 3 * sizeof(double);\n    size_t outSize2 = pixels2 * 3 * sizeof(double);\n    double *out1 = (double *)malloc(outSize1);\n    double *out2 = (double *)malloc(outSize2);\n    if (!out1 || !out2) {\n        free(out1);\n        free(out2);\n        cmsDeleteTransform(hTransform);\n        return 0;\n    }\n\n    // Apply the same transform to both buffers\n    cmsDoTransform(hTransform, data1, out1, (cmsUInt32Number)pixels1);\n    cmsDoTransform(hTransform, data2, out2, (cmsUInt32Number)pixels2);\n\n    // Simple sanity check: ensure outputs are finite (Lab values are finite)\n    for (size_t i = 0; i < pixels1 * 3; ++i) {\n        if (!(out1[i] == out1[i])) { // NaN check\n            free(out1);\n            free(out2);\n            cmsDeleteTransform(hTransform);\n            return 0;\n        }\n    }\n    for (size_t i = 0; i < pixels2 * 3; ++i) {\n        if (!(out2[i] == out2[i])) {\n            free(out1);\n            free(out2);\n            cmsDeleteTransform(hTransform);\n            return 0;\n        }\n    }\n\n    free(out1);\n    free(out2);\n    cmsDeleteTransform(hTransform);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":156,"completion_tokens":671,"total_tokens":827,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":28},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}