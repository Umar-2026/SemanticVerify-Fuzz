{"id":"f31d0bed-0fac-4cb2-9db1-2c523476e182","object":"chat.completion","created":1786350886,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n\nstatic void sleep_ms(int ms) {\n#ifdef _WIN32\n    Sleep(ms);\n#else\n    usleep(ms * 1000);\n#endif\n}\n\nstatic void getaddrinfo_callback(void *arg, int status, struct ares_addrinfo *result) {\n    (void)arg;\n    if (status == ARES_SUCCESS && result != NULL) {\n        ares_freeaddrinfo(result);\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL) {\n        server_csv = \"127.0.0.1\";\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    options.timeout = 2000;\n    options.tries = 1;\n\n    int status = ares_init_options(&channel, &options, ARES_OPT_FLAGS | ARES_OPT_TIMEOUT | ARES_OPT_TRIES);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    size_t name_len = size - 1;\n    char *name = (char *)malloc(name_len + 1);\n    if (name == NULL) {\n        ares_destroy(channel);\n        return 0;\n    }\n    memcpy(name, data, name_len);\n    name[name_len] = '\\0';\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    ares_getaddrinfo(channel, name, NULL, &hints, getaddrinfo_callback, NULL);\n\n    int num_fds = 0;\n    fd_set read_fds, write_fds;\n    struct timeval tv;\n    int max_fd = -1;\n\n    for (int i = 0; i < 10; i++) {\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        tv.tv_sec = 0;\n        tv.tv_usec = 200000;\n\n        num_fds = ares_fds(channel, &read_fds, &write_fds);\n        if (num_fds == 0) {\n            break;\n        }\n\n        max_fd = -1;\n        for (int fd = 0; fd < FD_SETSIZE; fd++) {\n            if (FD_ISSET(fd, &read_fds) || FD_ISSET(fd, &write_fds)) {\n                max_fd = fd;\n            }\n        }\n\n        if (max_fd >= 0) {\n            select(max_fd + 1, &read_fds, &write_fds, NULL, &tv);\n            ares_process(channel, &read_fds, &write_fds);\n        } else {\n            sleep_ms(10);\n        }\n    }\n\n    free(name);\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":206,"completion_tokens":783,"total_tokens":989,"prompt_tokens_details":{"cached_tokens":0},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":206},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}