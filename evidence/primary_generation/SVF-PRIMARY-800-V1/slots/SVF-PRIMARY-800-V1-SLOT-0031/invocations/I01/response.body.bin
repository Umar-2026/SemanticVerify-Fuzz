       strm.next_in = (Bytef *)(input_ptr + input_offset);\n        strm.avail_in = (uInt)chunk_size;\n        input_offset += chunk_size;\n\n        // Process all available input in this chunk\n        while (strm.avail_in > 0) {\n            strm.next_out = outbuf;\n            strm.avail_out = sizeof(outbuf);\n\n            ret = inflate(&strm, Z_NO_FLUSH);\n            if (ret != Z_OK && ret != Z_STREAM_END && ret != Z_BUF_ERROR) {\n                // Error or unexpected return; stop processing\n                inflateEnd(&strm);\n                free(chunk_sizes);\n                return 0;\n            }\n\n            if (ret == Z_STREAM_END) {\n                // Stream ended; we can stop feeding more chunks\n                inflateEnd(&strm);\n                free(chunk_sizes);\n                return 0;\n            }\n\n            // If no progress possible (avail_in unchanged and avail_out full), break to avoid infinite loop\n            if (strm.avail_in > 0 && strm.avail_out == 0) {\n                continue;\n            }\n            if (strm.avail_in > 0 && strm.avail_out == sizeof(outbuf)) {\n                // No progress; break out of inner loop\n                break;\n            }\n        }\n    }\n\n    // Clean up\n    inflateEnd(&strm);\n    free(chunk_sizes);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":163,"completion_tokens":827,"total_tokens":990,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":35},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}