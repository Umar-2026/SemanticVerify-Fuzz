{"id":"0ea77087-17b8-47ec-8f1d-58bdd1b7fded","object":"chat.completion","created":1786291956,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <unistd.h>\n#include <errno.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    // Create a UDP socket bound to loopback\n    int sock = socket(AF_INET, SOCK_DGRAM, 0);\n    if (sock < 0) return 0;\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    addr.sin_port = 0; // ephemeral port\n\n    if (bind(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        close(sock);\n        return 0;\n    }\n\n    // Determine payload size (cap at 512 bytes)\n    size_t payload_len = size > 512 ? 512 : size;\n    char payload[512];\n    memcpy(payload, data, payload_len);\n\n    // Send the datagram to ourselves\n    struct sockaddr_in dest;\n    memset(&dest, 0, sizeof(dest));\n    dest.sin_family = AF_INET;\n    dest.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    dest.sin_port = addr.sin_port; // same port we bound to\n\n    if (sendto(sock, payload, payload_len, 0, (struct sockaddr *)&dest, sizeof(dest)) < 0) {\n        close(sock);\n        return 0;\n    }\n\n    // Set up pcap on loopback\n    char errbuf[PCAP_ERRBUF_SIZE];\n    pcap_t *handle = pcap_create(\"lo\", errbuf);\n    if (handle == NULL) {\n        close(sock);\n        return 0;\n    }\n\n    // Set immediate mode to avoid buffering delays\n    if (pcap_set_immediate_mode(handle, 1) != 0) {\n        pcap_close(handle);\n        close(sock);\n        return 0;\n    }\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        close(sock);\n        return 0;\n    }\n\n    // Capture one packet with a short timeout\n    struct pcap_pkthdr *header;\n    const u_char *packet;\n    int ret = pcap_next_ex(handle, &header, &packet);\n    if (ret == 1) {\n        // Successfully got a packet; we don't need to process it further\n        (void)header;\n        (void)packet;\n    }\n\n    pcap_close(handle);\n    close(sock);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":181,"completion_tokens":644,"total_tokens":825,"prompt_tokens_details":{"cached_tokens":0},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":181},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}