it_depth;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.g_pass = VPX_RC_ONE_PASS;\n    cfg.g_lag_in_frames = 0;\n    cfg.rc_end_usage = VPX_CBR;\n    cfg.rc_target_bitrate = 256;\n\n    if (vpx_codec_enc_init(&ctx, vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Encode frame\n    vpx_codec_encode(&ctx, img, 0, 1, 0, VPX_DL_REALTIME);\n\n    // Cleanup\n    vpx_codec_destroy(&ctx);\n    vpx_img_free(img);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":171,"completion_tokens":792,"total_tokens":963,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":43},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}