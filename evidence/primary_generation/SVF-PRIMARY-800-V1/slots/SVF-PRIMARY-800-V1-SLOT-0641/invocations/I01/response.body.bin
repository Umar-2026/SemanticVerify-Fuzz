{"id":"8456cb0c-70e7-43e2-a991-52dfa0558d7c","object":"chat.completion","created":1786351045,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ares.h>\n\ntypedef struct {\n    int done;\n    int status;\n    unsigned char *buf;\n    int len;\n} query_result;\n\nstatic void query_callback(void *arg, int status, int timeouts, unsigned char *abuf, int alen) {\n    query_result *res = (query_result *)arg;\n    res->done = 1;\n    res->status = status;\n    res->buf = (unsigned char *)malloc(alen > 0 ? alen : 1);\n    if (res->buf) {\n        res->len = alen;\n        if (alen > 0) {\n            memcpy(res->buf, abuf, alen);\n        }\n    } else {\n        res->len = 0;\n    }\n    (void)timeouts;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int optmask = ARES_OPT_FLAGS;\n\n    if (ares_init_options(&channel, &options, optmask) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv != NULL) {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    // Derive two hostnames from fuzz input.\n    // Use first half for name1, second half for name2.\n    size_t half = size / 2;\n    size_t len1 = half;\n    size_t len2 = size - half;\n\n    // Ensure names are null-terminated and bounded.\n    char name1[256];\n    char name2[256];\n    if (len1 >= sizeof(name1)) len1 = sizeof(name1) - 1;\n    if (len2 >= sizeof(name2)) len2 = sizeof(name2) - 1;\n    memcpy(name1, data, len1);\n    name1[len1] = '\\0';\n    memcpy(name2, data + half, len2);\n    name2[len2] = '\\0';\n\n    query_result res1;\n    query_result res2;\n    memset(&res1, 0, sizeof(res1));\n    memset(&res2, 0, sizeof(res2));\n\n    ares_query_dnsrec(channel, name1, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &res1, NULL);\n    ares_query_dnsrec(channel, name2, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &res2, NULL);\n\n    // Process until both callbacks have fired.\n    int max_waits = 1000;\n    while ((!res1.done || !res2.done) && max_waits-- > 0) {\n        ares_process_fd(channel, ARES_SOCKET_BAD, ARES_SOCKET_BAD);\n    }\n\n    // Consume results.\n    if (res1.buf) {\n        free(res1.buf);\n    }\n    if (res2.buf) {\n        free(res2.buf);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":222,"completion_tokens":757,"total_tokens":979,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":94},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}