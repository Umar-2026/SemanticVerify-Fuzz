{"id":"ad686eac-75cd-4573-875b-39e8e869c6c6","object":"chat.completion","created":1786293331,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *f = fdopen(fd, \"wb\");\n    if (!f) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, f);\n    fclose(f);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (!tif) {\n        unlink(filename);\n        return 0;\n    }\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel;\n    uint16_t planar_config;\n    uint32_t rows_per_strip;\n\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n    TIFFGetField(tif, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);\n\n    if (width == 0 || height == 0 || samples_per_pixel == 0 || bits_per_sample == 0) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    // Compute scanline size and allocate buffer\n    tmsize_t scanline_size = TIFFScanlineSize(tif);\n    if (scanline_size <= 0) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    uint8_t *scanline_buf = (uint8_t *)malloc(scanline_size);\n    if (!scanline_buf) {\n        TIFFClose(tif);\n        unlink(filename);\n        return 0;\n    }\n\n    // Read a few scanlines (up to 4 or height, whichever is smaller)\n    uint32_t num_scanlines = height < 4 ? height : 4;\n    for (uint32_t row = 0; row < num_scanlines; row++) {\n        if (TIFFReadScanline(tif, scanline_buf, row, 0) < 0) {\n            break;\n        }\n    }\n\n    free(scanline_buf);\n\n    // Also attempt strip reading if strips are present\n    if (rows_per_strip > 0) {\n        tmsize_t strip_size = TIFFStripSize(tif);\n        if (strip_size > 0) {\n            uint8_t *strip_buf = (uint8_t *)malloc(strip_size);\n            if (strip_buf) {\n                uint32_t num_strips = TIFFNumberOfStrips(tif);\n                uint32_t strips_to_read = num_strips < 2 ? num_strips : 2;\n                for (uint32_t s = 0; s < strips_to_read; s++) {\n                    if (TIFFReadEncodedStrip(tif, s, strip_buf, strip_size) < 0) {\n                        break;\n                    }\n                }\n                free(strip_buf);\n            }\n        }\n    }\n\n    TIFFClose(tif);\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":174,"completion_tokens":825,"total_tokens":999,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":46},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}