{"id":"5b3431e6-aadf-4364-99f6-0abe1d1bad2d","object":"chat.completion","created":1786293288,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *fp = fdopen(fd, \"wb\");\n    if (!fp) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, fp);\n    fclose(fp);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    unlink(filename);\n    if (!tif) return 0;\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel, planar_config;\n    uint32_t rows_per_strip;\n\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n    TIFFGetField(tif, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);\n\n    if (width == 0 || height == 0 || rows_per_strip == 0) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Compute scanline size in bytes\n    tmsize_t scanline_size = TIFFScanlineSize(tif);\n    if (scanline_size <= 0) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Allocate buffer for one scanline\n    uint8_t *scanline_buf = (uint8_t *)malloc(scanline_size);\n    if (!scanline_buf) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Read a few scanlines (up to 4 or height, whichever is smaller)\n    uint32_t num_scanlines = height < 4 ? height : 4;\n    for (uint32_t row = 0; row < num_scanlines; row++) {\n        if (TIFFReadScanline(tif, scanline_buf, row, 0) < 0) {\n            break;\n        }\n    }\n\n    free(scanline_buf);\n\n    // Allocate buffer for one strip\n    tmsize_t strip_size = TIFFStripSize(tif);\n    if (strip_size > 0) {\n        uint8_t *strip_buf = (uint8_t *)malloc(strip_size);\n        if (strip_buf) {\n            // Read a few strips (up to 4 or number of strips, whichever is smaller)\n            tstrip_t num_strips = TIFFNumberOfStrips(tif);\n            tstrip_t max_strips = num_strips < 4 ? num_strips : 4;\n            for (tstrip_t strip = 0; strip < max_strips; strip++) {\n                if (TIFFReadEncodedStrip(tif, strip, strip_buf, strip_size) < 0) {\n                    break;\n                }\n            }\n            free(strip_buf);\n        }\n    }\n\n    TIFFClose(tif);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":174,"completion_tokens":803,"total_tokens":977,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":46},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}