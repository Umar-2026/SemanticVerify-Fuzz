{"id":"49499a2b-be59-4b15-8095-21f3ba0b06bb","object":"chat.completion","created":1786350984,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ares.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int optmask = ARES_OPT_FLAGS;\n\n    int status = ares_init_options(&channel, &options, optmask);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv != NULL && server_csv[0] != '\\0') {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    // Derive a bounded domain name from fuzz input.\n    // Use at most 63 bytes for the label, and ensure it is null-terminated.\n    size_t domain_len = size;\n    if (domain_len > 63) {\n        domain_len = 63;\n    }\n    char domain[64];\n    memcpy(domain, data, domain_len);\n    domain[domain_len] = '\\0';\n\n    // Ensure the domain is not empty and does not contain invalid characters.\n    if (domain[0] == '\\0') {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    // Issue an A-record query.\n    ares_query_dnsrec(channel, domain, ARES_CLASS_IN, ARES_REC_TYPE_A, NULL, NULL, NULL);\n\n    // Allow the query to proceed briefly.\n    int nfds;\n    fd_set readers, writers;\n    struct timeval tv;\n    tv.tv_sec = 0;\n    tv.tv_usec = 10000; // 10 ms\n    for (int i = 0; i < 5; i++) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        nfds = ares_fds(channel, &readers, &writers);\n        if (nfds == 0) {\n            break;\n        }\n        if (select(nfds, &readers, &writers, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &readers, &writers);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}\n\n#ifdef __cplusplus\n}\n#endif"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":232,"completion_tokens":570,"total_tokens":802,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":104},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}