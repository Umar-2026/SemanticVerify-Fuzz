{"id":"1793eb6f-9ef4-44a0-87e6-6ea16a5be49f","object":"chat.completion","created":1786292560,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <unistd.h>\n#include <fcntl.h>\n#include <sys/stat.h>\n\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Split input into two parts\n    size_t split = size / 2;\n    const uint8_t *part1 = data;\n    size_t part1_size = split;\n    const uint8_t *part2 = data + split;\n    size_t part2_size = size - split;\n\n    // Create temporary files\n    char template1[] = \"/tmp/curl_fuzz_XXXXXX\";\n    char template2[] = \"/tmp/curl_fuzz_XXXXXX\";\n    int fd1 = mkstemp(template1);\n    int fd2 = mkstemp(template2);\n    if (fd1 < 0 || fd2 < 0) {\n        if (fd1 >= 0) close(fd1);\n        if (fd2 >= 0) close(fd2);\n        return 0;\n    }\n\n    // Write data to files\n    ssize_t written1 = write(fd1, part1, part1_size);\n    ssize_t written2 = write(fd2, part2, part2_size);\n    close(fd1);\n    close(fd2);\n    if (written1 != (ssize_t)part1_size || written2 != (ssize_t)part2_size) {\n        unlink(template1);\n        unlink(template2);\n        return 0;\n    }\n\n    // Build file URLs\n    char url1[512];\n    char url2[512];\n    snprintf(url1, sizeof(url1), \"file://%s\", template1);\n    snprintf(url2, sizeof(url2), \"file://%s\", template2);\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        unlink(template1);\n        unlink(template2);\n        return 0;\n    }\n\n    // First transfer\n    curl_easy_setopt(curl, CURLOPT_URL, url1);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_perform(curl);\n\n    // Second transfer with same handle\n    curl_easy_setopt(curl, CURLOPT_URL, url2);\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n\n    unlink(template1);\n    unlink(template2);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":180,"completion_tokens":653,"total_tokens":833,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":52},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}