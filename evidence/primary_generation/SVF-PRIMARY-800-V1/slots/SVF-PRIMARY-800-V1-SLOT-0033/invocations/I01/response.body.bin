{"id":"3d5fb18d-7cb3-4396-a828-914e54e07160","object":"chat.completion","created":1786291674,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Use first byte to determine number of chunks (2 to 9)\n    unsigned int num_chunks = 2 + (data[0] % 8);\n    if (size < 1 + num_chunks) {\n        return 0;\n    }\n\n    // Extract chunk sizes from the next num_chunks bytes\n    size_t chunk_sizes[9];\n    size_t total_chunk_size = 0;\n    for (unsigned int i = 0; i < num_chunks; i++) {\n        chunk_sizes[i] = data[1 + i] % 64; // each chunk at most 63 bytes\n        total_chunk_size += chunk_sizes[i];\n    }\n\n    // Ensure we have enough input data for all chunks\n    if (1 + num_chunks + total_chunk_size > size) {\n        return 0;\n    }\n\n    // Set up z_stream for inflate\n    z_stream strm;\n    memset(&strm, 0, sizeof(strm));\n    if (inflateInit(&strm) != Z_OK) {\n        return 0;\n    }\n\n    // Feed chunks through the streaming decompressor\n    const uint8_t *input_ptr = data + 1 + num_chunks;\n    int ret = Z_OK;\n    unsigned char outbuf[256];\n\n    for (unsigned int i = 0; i < num_chunks; i++) {\n        strm.next_in = (Bytef *)input_ptr;\n        strm.avail_in = (uInt)chunk_sizes[i];\n        input_ptr += chunk_sizes[i];\n\n        while (strm.avail_in > 0) {\n            strm.next_out = outbuf;\n            strm.avail_out = sizeof(outbuf);\n\n            ret = inflate(&strm, Z_NO_FLUSH);\n            if (ret != Z_OK && ret != Z_STREAM_END && ret != Z_BUF_ERROR) {\n                // Error or unexpected return; stop processing\n                inflateEnd(&strm);\n                return 0;\n            }\n\n            if (ret == Z_STREAM_END) {\n                // Stream ended; no more input should be processed\n                inflateEnd(&strm);\n                return 0;\n            }\n\n            if (strm.avail_in == 0) {\n                break;\n            }\n        }\n    }\n\n    // Finish the stream\n    if (ret == Z_OK) {\n        strm.next_in = NULL;\n        strm.avail_in = 0;\n        do {\n            strm.next_out = outbuf;\n            strm.avail_out = sizeof(outbuf);\n            ret = inflate(&strm, Z_FINISH);\n            if (ret != Z_OK && ret != Z_STREAM_END && ret != Z_BUF_ERROR) {\n                break;\n            }\n        } while (ret != Z_STREAM_END && strm.avail_out == 0);\n    }\n\n    inflateEnd(&strm);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":163,"completion_tokens":699,"total_tokens":862,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":35},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}