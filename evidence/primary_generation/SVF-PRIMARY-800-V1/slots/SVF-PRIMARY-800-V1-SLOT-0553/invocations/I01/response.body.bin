{"id":"aa94e631-2053-49ae-98b1-0b00e6479749","object":"chat.completion","created":1786350510,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"vpx/vpx_codec.h\"\n#include \"vpx/vpx_image.h\"\n#include \"vpx/vpx_encoder.h\"\n\n#define MAX_IMAGE_SIZE (1024 * 1024)\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 16) return 0;\n\n    // Parse basic parameters from the fuzz input\n    unsigned int width = (data[0] << 8) | data[1];\n    unsigned int height = (data[2] << 8) | data[3];\n    if (width == 0 || height == 0 || width > 4096 || height > 4096) return 0;\n\n    // Determine image format from input\n    vpx_img_fmt_t fmt = (vpx_img_fmt_t)(data[4] % 4); // 0=VPX_IMG_FMT_NONE, 1=RGB24, 2=RGB32, 3=YV12\n    if (fmt == VPX_IMG_FMT_NONE) fmt = VPX_IMG_FMT_YV12;\n\n    // Allocate image\n    vpx_image_t *img = vpx_img_alloc(NULL, fmt, width, height, 1);\n    if (!img) return 0;\n\n    // Fill image data with fuzz bytes (bounded)\n    size_t plane_size = 0;\n    for (int i = 0; i < 3; i++) {\n        if (img->planes[i]) {\n            plane_size += img->stride[i] * img->d_h;\n        }\n    }\n    if (plane_size > MAX_IMAGE_SIZE) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    size_t offset = 5;\n    for (int i = 0; i < 3; i++) {\n        if (img->planes[i]) {\n            size_t bytes = img->stride[i] * img->d_h;\n            if (offset + bytes > size) {\n                // Pad with zeros if not enough data\n                memset(img->planes[i], 0, bytes);\n            } else {\n                memcpy(img->planes[i], data + offset, bytes);\n                offset += bytes;\n            }\n        }\n    }\n\n    // Initialize codec context\n    vpx_codec_iface_t *iface = vpx_codec_vp8_cx();\n    vpx_codec_enc_cfg_t cfg;\n    if (vpx_codec_enc_config_default(iface, &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Adjust config from fuzz input\n    cfg.g_w = width;\n    cfg.g_h = height;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.g_threads = (data[5] % 4) + 1;\n    cfg.rc_target_bitrate = (data[6] << 8) | data[7];\n\n    vpx_codec_ctx_t ctx;\n    if (vpx_codec_enc_init(&ctx, iface, &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Encode the image\n    vpx_codec_err_t res = vpx_codec_encode(&ctx, img, 0, 1, 0, VPX_DL_REALTIME);\n    if (res == VPX_CODEC_OK) {\n        vpx_codec_iter_t iter = NULL;\n        const vpx_codec_cx_pkt_t *pkt;\n        while ((pkt = vpx_codec_get_cx_data(&ctx, &iter)) != NULL) {\n            // Consume packet data (no-op)\n        }\n    }\n\n    vpx_codec_destroy(&ctx);\n    vpx_img_free(img);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":171,"completion_tokens":876,"total_tokens":1047,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":43},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}