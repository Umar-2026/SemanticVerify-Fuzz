{"id":"48c04a31-5e4d-432d-b302-ece578f0513f","object":"chat.completion","created":1786351006,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _WIN32\n#include <winsock2.h>\n#include <ws2tcpip.h>\n#else\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#endif\n\n#define MAX_LOOKUPS 16\n#define MAX_HOSTNAME_LEN 256\n\ntypedef struct {\n    int pending;\n    int completed;\n    int failures;\n} lookup_state;\n\nstatic void dns_callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    lookup_state *state = (lookup_state *)arg;\n    state->completed++;\n    if (status != ARES_SUCCESS) {\n        state->failures++;\n    }\n    if (result) {\n        ares_freeaddrinfo(result);\n    }\n    state->pending--;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (!server_csv || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    int optmask = 0;\n\n    if (ares_init_options(&channel, &options, optmask) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    if (ares_set_servers_csv(channel, server_csv) != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    lookup_state state;\n    state.pending = 0;\n    state.completed = 0;\n    state.failures = 0;\n\n    size_t offset = 0;\n    int lookups = 0;\n\n    while (offset < size && lookups < MAX_LOOKUPS) {\n        size_t len = data[offset];\n        offset++;\n        if (len == 0 || len > MAX_HOSTNAME_LEN || offset + len > size) {\n            break;\n        }\n\n        char hostname[MAX_HOSTNAME_LEN + 1];\n        memcpy(hostname, data + offset, len);\n        hostname[len] = '\\0';\n        offset += len;\n\n        struct ares_addrinfo_hints hints;\n        memset(&hints, 0, sizeof(hints));\n        hints.ai_family = AF_UNSPEC;\n        hints.ai_socktype = SOCK_STREAM;\n\n        state.pending++;\n        ares_getaddrinfo(channel, hostname, NULL, &hints, dns_callback, &state);\n        lookups++;\n    }\n\n    if (state.pending == 0) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    int numfds;\n    fd_set readers, writers;\n    struct timeval tv;\n    int res;\n\n    while (state.pending > 0) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        numfds = 0;\n        ares_fds(channel, &readers, &writers);\n        if (ares_getsock(channel, NULL, 0) == 0) {\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000;\n        res = select(numfds, &readers, &writers, NULL, &tv);\n        if (res < 0) {\n            break;\n        }\n        ares_process_fd(channel, ARES_SOCKET_BAD, ARES_SOCKET_BAD);\n        ares_process(channel, &readers, &writers);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":816,"total_tokens":1020,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}