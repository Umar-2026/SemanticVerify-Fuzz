{"id":"c71d102f-ac48-44e7-8d5f-1bc8c661d5be","object":"chat.completion","created":1786293456,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary input file from fuzz data\n    char input_path[] = \"/tmp/fuzz_input_XXXXXX\";\n    int input_fd = mkstemp(input_path);\n    if (input_fd < 0) return 0;\n    write(input_fd, data, size);\n    close(input_fd);\n\n    // Create a temporary output file\n    char output_path[] = \"/tmp/fuzz_output_XXXXXX\";\n    int output_fd = mkstemp(output_path);\n    if (output_fd < 0) {\n        unlink(input_path);\n        return 0;\n    }\n    close(output_fd);\n\n    TIFF *in = TIFFOpen(input_path, \"r\");\n    if (!in) {\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    TIFF *out = TIFFOpen(output_path, \"w\");\n    if (!out) {\n        TIFFClose(in);\n        unlink(input_path);\n        unlink(output_path);\n        return 0;\n    }\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel;\n    uint16_t photometric, planar_config;\n    uint16_t compression, orientation;\n\n    if (TIFFGetField(in, TIFFTAG_IMAGEWIDTH, &width) &&\n        TIFFGetField(in, TIFFTAG_IMAGELENGTH, &height) &&\n        TIFFGetField(in, TIFFTAG_BITSPERSAMPLE, &bits_per_sample) &&\n        TIFFGetField(in, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel) &&\n        TIFFGetField(in, TIFFTAG_PHOTOMETRIC, &photometric) &&\n        TIFFGetField(in, TIFFTAG_PLANARCONFIG, &planar_config)) {\n\n        // Copy essential tags to output\n        TIFFSetField(out, TIFFTAG_IMAGEWIDTH, width);\n        TIFFSetField(out, TIFFTAG_IMAGELENGTH, height);\n        TIFFSetField(out, TIFFTAG_BITSPERSAMPLE, bits_per_sample);\n        TIFFSetField(out, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);\n        TIFFSetField(out, TIFFTAG_PHOTOMETRIC, photometric);\n        TIFFSetField(out, TIFFTAG_PLANARCONFIG, planar_config);\n\n        // Optional tags with fallback\n        if (TIFFGetField(in, TIFFTAG_COMPRESSION, &compression))\n            TIFFSetField(out, TIFFTAG_COMPRESSION, compression);\n        else\n            TIFFSetField(out, TIFFTAG_COMPRESSION, COMPRESSION_NONE);\n\n        if (TIFFGetField(in, TIFFTAG_ORIENTATION, &orientation))\n            TIFFSetField(out, TIFFTAG_ORIENTATION, orientation);\n        else\n            TIFFSetField(out, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);\n\n        // Allocate scanline buffer\n        tmsize_t scanline_size = TIFFScanlineSize(in);\n        if (scanline_size <= 0) {\n            TIFFClose(in);\n            TIFFClose(out);\n            unlink(input_path);\n            unlink(output_path);\n            return 0;\n        }\n\n        uint8_t *buffer = (uint8_t *)malloc(scanline_size);\n        if (!buffer) {\n            TIFFClose(in);\n            TIFFClose(out);\n            unlink(input_path);\n            unlink(output_path);\n            return 0;\n        }\n\n        // Read and write scanlines\n        for (uint32_t row = 0; row < height; row++) {\n            if (TIFFReadScanline(in, buffer, row, 0) < 0) {\n                free(buffer);\n                TIFFClose(in);\n                TIFFClose(out);\n                unlink(input_path);\n                unlink(output_path);\n                return 0;\n            }\n            if (TIFFWriteScanline(out, buffer, row, 0) < 0) {\n                free(buffer);\n                TIFFClose(in);\n                TIFFClose(out);\n                unlink(input_path);\n                unlink(output_path);\n                return 0;\n            }\n        }\n\n        free(buffer);\n    }\n\n    TIFFClose(in);\n    TIFFClose(out);\n\n    unlink(input_path);\n    unlink(output_path);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":182,"completion_tokens":1022,"total_tokens":1204,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":54},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}