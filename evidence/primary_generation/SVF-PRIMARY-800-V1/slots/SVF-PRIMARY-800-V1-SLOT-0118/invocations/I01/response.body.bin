            "text": "#include \u003cpcap.h\u003e\n#include \u003cstdint.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 8) {\n        return 0;\n    }\n\n    char errbuf[PCAP_ERRBUF_SIZE];\n    pcap_t *handle;\n    struct pcap_pkthdr *header;\n    const u_char *pkt_data;\n\n    int snaplen = (data[0] \u003c\u003c 8) | data[1];\n    int timeout = (data[2] \u003c\u003c 8) | data[3];\n\n    handle = pcap_create(\"lo\", errbuf);\n    if (handle == NULL) {\n        return 0;\n    }\n\n    if (pcap_set_snaplen(handle, snaplen) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_set_timeout(handle, timeout) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    int status = pcap_next_ex(handle, &header, &pkt_data);\n    \n    pcap_close(handle);\n\n    return 0;\n}",
