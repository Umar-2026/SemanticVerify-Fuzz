{"id":"eb9d5319-fb42-43d2-816b-392acdb8f890","object":"chat.completion","created":1786293195,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n#include \"tiffio.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 16) return 0;\n\n    TIFF *tif = TIFFOpen(\"/tmp/fuzz_output.tif\", \"w\");\n    if (!tif) return 0;\n\n    uint32_t width = (data[0] << 24) | (data[1] << 16) | (data[2] << 8) | data[3];\n    uint32_t height = (data[4] << 24) | (data[5] << 16) | (data[6] << 8) | data[7];\n    uint16_t bits_per_sample = (data[8] << 8) | data[9];\n    uint16_t samples_per_pixel = (data[10] << 8) | data[11];\n    uint16_t compression = (data[12] << 8) | data[13];\n    uint16_t photometric = (data[14] << 8) | data[15];\n\n    if (width == 0 || height == 0 || width > 4096 || height > 4096) {\n        TIFFClose(tif);\n        return 0;\n    }\n    if (bits_per_sample == 0 || bits_per_sample > 64) {\n        TIFFClose(tif);\n        return 0;\n    }\n    if (samples_per_pixel == 0 || samples_per_pixel > 4) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);\n    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);\n    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, bits_per_sample);\n    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);\n    TIFFSetField(tif, TIFFTAG_COMPRESSION, compression);\n    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, photometric);\n    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);\n    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, 1);\n\n    size_t scanline_size = (width * bits_per_sample * samples_per_pixel + 7) / 8;\n    if (scanline_size == 0 || scanline_size > 65536) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    uint8_t *scanline = (uint8_t *)malloc(scanline_size);\n    if (!scanline) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    for (uint32_t row = 0; row < height; row++) {\n        memset(scanline, 0, scanline_size);\n        if (size > 16) {\n            size_t copy_len = scanline_size < (size - 16) ? scanline_size : (size - 16);\n            memcpy(scanline, data + 16, copy_len);\n        }\n        if (TIFFWriteScanline(tif, scanline, row, 0) < 0) {\n            free(scanline);\n            TIFFClose(tif);\n            return 0;\n        }\n    }\n\n    free(scanline);\n    TIFFClose(tif);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":176,"completion_tokens":788,"total_tokens":964,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":48},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}