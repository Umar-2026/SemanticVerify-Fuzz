{"id":"9e1709a1-1b62-4097-a410-c960b7fd5e9a","object":"chat.completion","created":1786350527,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"vpx/vpx_encoder.h\"\n#include \"vpx/vp8cx.h\"\n#include \"vpx/vpx_image.h\"\n\n#define MAX_IMAGE_SIZE (1024 * 1024)\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) return 0;\n\n    // Parse dimensions from input\n    uint16_t width = (uint16_t)((data[0] << 8) | data[1]);\n    uint16_t height = (uint16_t)((data[2] << 8) | data[3]);\n    if (width == 0 || height == 0 || width > 4096 || height > 4096) return 0;\n\n    // Determine pixel format from next byte\n    vpx_img_fmt_t fmt;\n    if (size < 5) return 0;\n    switch (data[4] % 4) {\n        case 0: fmt = VPX_IMG_FMT_I420; break;\n        case 1: fmt = VPX_IMG_FMT_I422; break;\n        case 2: fmt = VPX_IMG_FMT_I444; break;\n        default: fmt = VPX_IMG_FMT_YV12; break;\n    }\n\n    // Allocate image\n    vpx_image_t *img = vpx_img_alloc(NULL, fmt, width, height, 1);\n    if (!img) return 0;\n\n    // Fill image planes with fuzz data\n    size_t offset = 5;\n    for (int plane = 0; plane < 3; plane++) {\n        size_t plane_size = img->stride[plane] * img->d_h;\n        if (offset + plane_size > size) {\n            // Fill remaining with zeros\n            memset(img->planes[plane], 0, plane_size);\n        } else {\n            memcpy(img->planes[plane], data + offset, plane_size);\n            offset += plane_size;\n        }\n    }\n\n    // Initialize encoder configuration\n    vpx_codec_enc_cfg_t cfg;\n    if (vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    cfg.g_w = width;\n    cfg.g_h = height;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    // Create encoder context\n    vpx_codec_ctx_t ctx;\n    if (vpx_codec_enc_init(&ctx, vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Encode the image\n    vpx_codec_err_t res = vpx_codec_encode(&ctx, img, 0, 1, 0, VPX_DL_REALTIME);\n    if (res == VPX_CODEC_OK) {\n        // Consume any output packets\n        const vpx_codec_cx_pkt_t *pkt;\n        vpx_codec_iter_t iter = NULL;\n        while ((pkt = vpx_codec_get_cx_data(&ctx, &iter)) != NULL) {\n            // Just iterate through packets\n        }\n    }\n\n    // Cleanup\n    vpx_codec_destroy(&ctx);\n    vpx_img_free(img);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":171,"completion_tokens":785,"total_tokens":956,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":43},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}