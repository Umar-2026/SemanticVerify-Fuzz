{"id":"59c6c332-d801-459c-aae7-ea880288730f","object":"chat.completion","created":1786350634,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n\n#include \"vpx/vpx_encoder.h\"\n#include \"vpx/vp8cx.h\"\n#include \"vpx/vpx_image.h\"\n\n#define WIDTH 64\n#define HEIGHT 64\n#define MAX_PACKETS 16\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    vpx_codec_ctx_t codec;\n    vpx_codec_enc_cfg_t cfg;\n    vpx_image_t *img = NULL;\n    vpx_codec_iter_t iter = NULL;\n    const vpx_codec_cx_pkt_t *pkt;\n    int packet_count = 0;\n    int ret;\n\n    // Initialize configuration\n    if (vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        return 0;\n    }\n\n    cfg.g_w = WIDTH;\n    cfg.g_h = HEIGHT;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    // Initialize encoder\n    if (vpx_codec_enc_init(&codec, vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        return 0;\n    }\n\n    // Allocate image\n    img = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, WIDTH, HEIGHT, 1);\n    if (!img) {\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    // Fill image planes with fuzz data\n    size_t offset = 0;\n    size_t plane_size_y = img->stride[0] * HEIGHT;\n    size_t plane_size_uv = img->stride[1] * (HEIGHT / 2);\n\n    for (size_t i = 0; i < plane_size_y && offset < size; i++) {\n        img->planes[0][i] = data[offset++];\n    }\n    for (size_t i = 0; i < plane_size_uv && offset < size; i++) {\n        img->planes[1][i] = data[offset++];\n    }\n    for (size_t i = 0; i < plane_size_uv && offset < size; i++) {\n        img->planes[2][i] = data[offset++];\n    }\n\n    // Encode a few frames\n    for (int frame = 0; frame < 3; frame++) {\n        ret = vpx_codec_encode(&codec, img, frame, 1, 0, VPX_DL_REALTIME);\n        if (ret != VPX_CODEC_OK) {\n            break;\n        }\n\n        // Consume packets\n        iter = NULL;\n        while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n            if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n                packet_count++;\n                if (packet_count >= MAX_PACKETS) {\n                    break;\n                }\n            }\n        }\n        if (packet_count >= MAX_PACKETS) {\n            break;\n        }\n    }\n\n    // Cleanup\n    vpx_img_free(img);\n    vpx_codec_destroy(&codec);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":191,"completion_tokens":768,"total_tokens":959,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":63},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}