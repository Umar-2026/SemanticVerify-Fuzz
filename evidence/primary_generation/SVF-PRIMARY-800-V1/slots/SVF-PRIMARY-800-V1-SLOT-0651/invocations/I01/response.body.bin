tv;\n    while (1) {\n        num_fds = 0;\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000; /* 100ms */\n        ares_fds(channel, &readers, &writers);\n        num_fds = ares_getsock(channel, NULL, 0);\n        if (num_fds == 0) {\n            break;\n        }\n        ares_process_fd(channel, FD_ISSET(0, &readers) ? 0 : ARES_SOCKET_BAD,\n                        FD_ISSET(1, &writers) ? 1 : ARES_SOCKET_BAD);\n        if (tv.tv_sec == 0 && tv.tv_usec == 0) {\n            break;\n        }\n    }\n\n    /* Bounded summary: just ensure the callback ran and count is sane */\n    if (count > 1000) {\n        count = 1000;\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":754,"total_tokens":958,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}