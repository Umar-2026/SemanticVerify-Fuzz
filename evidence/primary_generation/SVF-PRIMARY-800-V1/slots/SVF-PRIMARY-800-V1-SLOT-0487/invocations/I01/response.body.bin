{"id":"12e57df6-40a6-451b-9935-0a0c9d537e70","object":"chat.completion","created":1786350244,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *f = fdopen(fd, \"wb\");\n    if (!f) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, f);\n    fclose(f);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (tif) {\n        uint32_t width, height;\n        uint16_t bits_per_sample, samples_per_pixel;\n        uint16_t planar_config;\n        tsize_t scanline_size;\n\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n        TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n\n        scanline_size = TIFFScanlineSize(tif);\n        if (scanline_size > 0 && width > 0 && height > 0) {\n            uint8_t *buf = (uint8_t *)malloc(scanline_size);\n            if (buf) {\n                // Try reading scanlines from top to bottom\n                for (uint32_t row = 0; row < height; row++) {\n                    if (TIFFReadScanline(tif, buf, row, 0) < 0) {\n                        // Read failure: free and close\n                        free(buf);\n                        TIFFClose(tif);\n                        unlink(filename);\n                        return 1; // outcome: read failure\n                    }\n                }\n                free(buf);\n                // Successful read of all scanlines\n                TIFFClose(tif);\n                unlink(filename);\n                return 2; // outcome: full read success\n            } else {\n                TIFFClose(tif);\n                unlink(filename);\n                return 3; // outcome: allocation failure\n            }\n        } else {\n            // Invalid dimensions or scanline size\n            TIFFClose(tif);\n            unlink(filename);\n            return 4; // outcome: invalid geometry\n        }\n    } else {\n        unlink(filename);\n        return 5; // outcome: open failure\n    }\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":167,"completion_tokens":613,"total_tokens":780,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":39},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}