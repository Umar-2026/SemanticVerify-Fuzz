{"id":"147cc6cd-4b6f-40b0-bf11-df29992cae72","object":"chat.completion","created":1786292280,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n\nstatic int process_pcap(pcap_t *handle, const char *name) {\n    int datalink = pcap_datalink(handle);\n    if (datalink < 0) {\n        fprintf(stderr, \"%s: pcap_datalink failed\\n\", name);\n        return -1;\n    }\n    printf(\"%s: datalink=%d\\n\", name, datalink);\n    return 0;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    /* Derive two independent bounded settings from input */\n    size_t half = size / 2;\n    size_t len1 = half;\n    size_t len2 = size - half;\n    if (len1 == 0 || len2 == 0) return 0;\n\n    /* First context */\n    char errbuf1[PCAP_ERRBUF_SIZE];\n    pcap_t *p1 = pcap_create(\"lo\", errbuf1);\n    if (p1 == NULL) return 0;\n\n    /* Apply bounded input-derived setting: snaplen from first byte */\n    int snaplen1 = data[0] % 65536;\n    if (pcap_set_snaplen(p1, snaplen1) != 0) {\n        pcap_close(p1);\n        return 0;\n    }\n\n    if (pcap_activate(p1) != 0) {\n        pcap_close(p1);\n        return 0;\n    }\n\n    /* Second context */\n    char errbuf2[PCAP_ERRBUF_SIZE];\n    pcap_t *p2 = pcap_create(\"lo\", errbuf2);\n    if (p2 == NULL) {\n        pcap_close(p1);\n        return 0;\n    }\n\n    /* Apply bounded input-derived setting: snaplen from second byte */\n    int snaplen2 = data[1] % 65536;\n    if (pcap_set_snaplen(p2, snaplen2) != 0) {\n        pcap_close(p2);\n        pcap_close(p1);\n        return 0;\n    }\n\n    if (pcap_activate(p2) != 0) {\n        pcap_close(p2);\n        pcap_close(p1);\n        return 0;\n    }\n\n    /* Inspect metadata from each */\n    process_pcap(p1, \"ctx1\");\n    process_pcap(p2, \"ctx2\");\n\n    pcap_close(p2);\n    pcap_close(p1);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":177,"completion_tokens":575,"total_tokens":752,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":49},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}