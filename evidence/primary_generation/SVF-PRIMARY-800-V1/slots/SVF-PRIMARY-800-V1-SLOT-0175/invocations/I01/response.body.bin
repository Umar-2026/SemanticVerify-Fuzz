{"id":"4cc4266d-07cc-455c-b562-215f641c09cd","object":"chat.completion","created":1786292307,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <net/if.h>\n#include <errno.h>\n\n#define MAX_PACKETS 10\n#define SNAP_LEN 65535\n#define TIMEOUT_MS 1000\n\nstatic void emit_udp_packet(void) {\n    int fd = socket(AF_INET, SOCK_DGRAM, 0);\n    if (fd < 0) return;\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(9999);\n    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n    const char *payload = \"fuzz\";\n    sendto(fd, payload, 4, 0, (struct sockaddr *)&addr, sizeof(addr));\n    close(fd);\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    pcap_t *handle = pcap_create(\"lo\", NULL);\n    if (handle == NULL) return 0;\n\n    if (pcap_set_snaplen(handle, SNAP_LEN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n    if (pcap_set_promisc(handle, 0) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n    if (pcap_set_timeout(handle, TIMEOUT_MS) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    // Build a filter program from fuzz input (bounded)\n    char filter_expr[128];\n    size_t len = size < sizeof(filter_expr) - 1 ? size : sizeof(filter_expr) - 1;\n    memcpy(filter_expr, data, len);\n    filter_expr[len] = '\\0';\n\n    struct bpf_program fp;\n    if (pcap_compile(handle, &fp, filter_expr, 1, PCAP_NETMASK_UNKNOWN) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    if (pcap_setfilter(handle, &fp) != 0) {\n        pcap_freecode(&fp);\n        pcap_close(handle);\n        return 0;\n    }\n    pcap_freecode(&fp);\n\n    // Emit a local UDP packet to trigger capture\n    emit_udp_packet();\n\n    // Capture a bounded number of packets\n    struct pcap_pkthdr *header;\n    const u_char *packet_data;\n    int packets_seen = 0;\n    while (packets_seen < MAX_PACKETS) {\n        int ret = pcap_next_ex(handle, &header, &packet_data);\n        if (ret == 1) {\n            packets_seen++;\n            // Inspect packet data (bounded)\n            if (header->caplen > 0) {\n                volatile uint8_t first_byte = packet_data[0];\n                (void)first_byte;\n            }\n        } else if (ret == 0) {\n            // Timeout, continue\n            continue;\n        } else {\n            // Error or EOF\n            break;\n        }\n    }\n\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":189,"completion_tokens":810,"total_tokens":999,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":61},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}