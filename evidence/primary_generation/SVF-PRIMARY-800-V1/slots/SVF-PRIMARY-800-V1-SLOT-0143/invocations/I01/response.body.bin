{"id":"a10765d9-2fdf-4b1d-986e-f04e3964d357","object":"chat.completion","created":1786292177,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <pcap/pcap.h>\n#include <stdint.h>\n#include <string.h>\n#include <stdlib.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) {\n        return 0;\n    }\n\n    char errbuf[PCAP_ERRBUF_SIZE];\n    pcap_t *handle = pcap_create(\"lo\", errbuf);\n    if (handle == NULL) {\n        return 0;\n    }\n\n    if (pcap_activate(handle) != 0) {\n        pcap_close(handle);\n        return 0;\n    }\n\n    // Query a capture property: datalink type\n    int dl = pcap_datalink(handle);\n    (void)dl;\n\n    // Inspect locally generated packet data using pcap_next_ex\n    // We'll use the fuzz input to determine how many packets to attempt to read (bounded).\n    // The actual packet data comes from the loopback interface, not from fuzz input.\n    size_t attempts = (size_t)data[0] % 4; // bounded 0-3\n    for (size_t i = 0; i < attempts; i++) {\n        struct pcap_pkthdr *header;\n        const u_char *packet;\n        int ret = pcap_next_ex(handle, &header, &packet);\n        if (ret != 1) {\n            // No packet or error; stop\n            break;\n        }\n        // Inspect packet data: just touch the first byte if available\n        if (header->caplen > 0) {\n            volatile uint8_t b = packet[0];\n            (void)b;\n        }\n    }\n\n    pcap_close(handle);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":185,"completion_tokens":380,"total_tokens":565,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":57},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}