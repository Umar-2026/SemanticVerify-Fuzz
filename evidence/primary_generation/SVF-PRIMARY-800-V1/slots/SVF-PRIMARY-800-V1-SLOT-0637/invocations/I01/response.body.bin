{"id":"9814c834-65fc-4583-a0ab-515d8f7f455a","object":"chat.completion","created":1786351029,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <ares.h>\n#include <netdb.h>\n#include <arpa/inet.h>\n#include <sys/socket.h>\n\ntypedef struct {\n    int pending;\n    int failures;\n    int successes;\n} lookup_state;\n\nstatic void addr_callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    lookup_state *state = (lookup_state *)arg;\n    (void)timeouts;\n    if (status == ARES_SUCCESS && result != NULL) {\n        state->successes++;\n        struct ares_addrinfo_node *node = result->nodes;\n        while (node != NULL) {\n            node = node->ai_next;\n        }\n        ares_freeaddrinfo(result);\n    } else {\n        state->failures++;\n    }\n    state->pending--;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    if (size < 1) {\n        return 0;\n    }\n\n    /* Bound the number of lookups to avoid excessive work */\n    size_t max_lookups = 16;\n    size_t num_lookups = (size_t)data[0] % max_lookups;\n    if (num_lookups == 0) {\n        num_lookups = 1;\n    }\n\n    /* Extract hostname candidates from fuzz input, each NUL-terminated */\n    char hostnames[16][256];\n    size_t host_count = 0;\n    size_t offset = 1;\n    while (host_count < num_lookups && offset < size) {\n        size_t len = 0;\n        while (offset + len < size && data[offset + len] != '\\0' && len < 255) {\n            len++;\n        }\n        if (len == 0) {\n            break;\n        }\n        memcpy(hostnames[host_count], data + offset, len);\n        hostnames[host_count][len] = '\\0';\n        host_count++;\n        offset += len + 1;\n    }\n\n    if (host_count == 0) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int status = ares_init_options(&channel, &options, 0);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    lookup_state state;\n    memset(&state, 0, sizeof(state));\n    state.pending = 0;\n\n    struct ares_addrinfo_hints hints;\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    for (size_t i = 0; i < host_count; i++) {\n        ares_getaddrinfo(channel, hostnames[i], NULL, &hints, addr_callback, &state);\n        state.pending++;\n    }\n\n    /* Process until all callbacks have fired or a timeout */\n    int numfds;\n    fd_set readers, writers;\n    struct timeval tv;\n    while (state.pending > 0) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        numfds = ares_fds(channel, &readers, &writers);\n        if (numfds == 0) {\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 1000; /* 1 ms */\n        if (select(numfds, &readers, &writers, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &readers, &writers);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,"completion_tokens":934,"total_tokens":1138,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":76},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}