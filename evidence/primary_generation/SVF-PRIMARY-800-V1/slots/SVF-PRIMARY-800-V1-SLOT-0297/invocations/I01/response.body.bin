{"id":"63d26479-dff2-4327-97ab-5a40680d07aa","object":"chat.completion","created":1786292786,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    size_t total = size * nmemb;\n    char **buf = (char **)userdata;\n    size_t current_len = *buf ? strlen(*buf) : 0;\n    char *new_buf = realloc(*buf, current_len + total + 1);\n    if (!new_buf) {\n        return 0;\n    }\n    *buf = new_buf;\n    memcpy(*buf + current_len, ptr, total);\n    (*buf)[current_len + total] = '\\0';\n    return total;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Bounded configuration from fuzz input\n    uint8_t timeout = data[0];\n    uint8_t follow_redirects = data[1] & 0x01;\n    uint8_t verbose = (data[1] >> 1) & 0x01;\n    uint8_t ssl_verify = (data[1] >> 2) & 0x01;\n\n    // Use a fixed local file URL\n    const char *url = \"file:///tmp/curl_fuzz_input.txt\";\n\n    // Initialize libcurl globally\n    if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) {\n        return 0;\n    }\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        curl_global_cleanup();\n        return 0;\n    }\n\n    // Application output buffer\n    char *output = NULL;\n\n    // Set options with bounded values\n    curl_easy_setopt(curl, CURLOPT_URL, url);\n    curl_easy_setopt(curl, CURLOPT_TIMEOUT, (long)timeout);\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, follow_redirects ? 1L : 0L);\n    curl_easy_setopt(curl, CURLOPT_VERBOSE, verbose ? 1L : 0L);\n    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, ssl_verify ? 1L : 0L);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &output);\n\n    // Perform the transfer\n    CURLcode res = curl_easy_perform(curl);\n\n    // Cleanup\n    if (output) {\n        free(output);\n    }\n    curl_easy_cleanup(curl);\n    curl_global_cleanup();\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":193,"completion_tokens":639,"total_tokens":832,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":65},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}