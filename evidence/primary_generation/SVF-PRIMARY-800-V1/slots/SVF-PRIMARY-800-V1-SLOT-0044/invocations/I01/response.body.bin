            "text": "#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cstdint.h\u003e\n#include \"zlib.h\"\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size \u003c 4) {\n        return 0;\n    }\n\n    size_t half = size / 2;\n    const uint8_t *payload1 = data;\n    size_t size1 = half;\n    const uint8_t *payload2 = data + half;\n    size_t size2 = size - half;\n\n    z_stream strm;\n    memset(&strm, 0, sizeof(strm));\n\n    if (inflateInit(&strm) != Z_OK) {\n        return 0;\n    }\n\n    uint8_t out[1024];\n\n    strm.next_in = (Bytef *)payload1;\n    strm.avail_in = (uInt)size1;\n    strm.next_out = out;\n    strm.avail_out = sizeof(out);\n    inflate(&strm, Z_FINISH);\n\n    if (inflateReset(&strm) != Z_OK) {\n        inflateEnd(&strm);\n        return 0;\n    }\n\n    strm.next_in = (Bytef *)payload2;\n    strm.avail_in = (uInt)size2;\n    strm.next_out = out;\n    strm.avail_out = sizeof(out);\n    inflate(&strm, Z_FINISH);\n\n    inflateEnd(&strm);\n    return 0;\n}",
