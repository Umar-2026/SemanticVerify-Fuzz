{"id":"55ba742d-4a7e-4f3b-a4c7-d3d39f0e1b9a","object":"chat.completion","created":1786350622,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"vpx/vpx_encoder.h\"\n#include \"vpx/vp8cx.h\"\n\n#define IMG_WIDTH 64\n#define IMG_HEIGHT 64\n#define MAX_PACKETS 16\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    vpx_image_t *img = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, IMG_WIDTH, IMG_HEIGHT, 1);\n    if (!img) return 0;\n\n    // Fill image planes with fuzz data\n    size_t offset = 0;\n    for (int plane = 0; plane < 3; plane++) {\n        int w = (plane == 0) ? IMG_WIDTH : IMG_WIDTH / 2;\n        int h = (plane == 0) ? IMG_HEIGHT : IMG_HEIGHT / 2;\n        size_t plane_size = (size_t)w * h;\n        for (int y = 0; y < h; y++) {\n            uint8_t *row = img->planes[plane] + y * img->stride[plane];\n            for (int x = 0; x < w; x++) {\n                if (offset < size) {\n                    row[x] = data[offset++];\n                } else {\n                    row[x] = 0;\n                }\n            }\n        }\n    }\n\n    vpx_codec_enc_cfg_t cfg;\n    if (vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n    cfg.g_w = IMG_WIDTH;\n    cfg.g_h = IMG_HEIGHT;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    vpx_codec_ctx_t codec;\n    if (vpx_codec_enc_init(&codec, vpx_codec_vp8_cx(), &cfg, 0) != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    vpx_codec_err_t res = vpx_codec_encode(&codec, img, 0, 1, 0, VPX_DL_REALTIME);\n    if (res == VPX_CODEC_OK) {\n        const vpx_codec_cx_pkt_t *pkt;\n        int packet_count = 0;\n        while ((pkt = vpx_codec_get_cx_data(&codec, &res)) != NULL) {\n            if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n                // Consume packet data\n                volatile uint8_t sum = 0;\n                const uint8_t *payload = (const uint8_t *)pkt->data.frame.buf;\n                for (size_t i = 0; i < pkt->data.frame.sz && i < 4096; i++) {\n                    sum += payload[i];\n                }\n                (void)sum;\n            }\n            packet_count++;\n            if (packet_count >= MAX_PACKETS) break;\n        }\n    }\n\n    vpx_codec_destroy(&codec);\n    vpx_img_free(img);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":191,"completion_tokens":754,"total_tokens":945,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":63},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}