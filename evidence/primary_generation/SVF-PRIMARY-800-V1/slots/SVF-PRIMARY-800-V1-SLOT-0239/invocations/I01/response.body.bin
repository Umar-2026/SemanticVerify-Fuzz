{"id":"1b8a192e-5de3-49a2-900a-6cc253fc5768","object":"chat.completion","created":1786292565,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <stdio.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Split input into two parts: first half for file1, second half for file2\n    size_t half = size / 2;\n    const uint8_t *data1 = data;\n    size_t size1 = half;\n    const uint8_t *data2 = data + half;\n    size_t size2 = size - half;\n\n    // Create temporary files\n    char template1[] = \"/tmp/curl_fuzz_XXXXXX\";\n    char template2[] = \"/tmp/curl_fuzz_XXXXXX\";\n    int fd1 = mkstemp(template1);\n    int fd2 = mkstemp(template2);\n    if (fd1 < 0 || fd2 < 0) {\n        if (fd1 >= 0) close(fd1);\n        if (fd2 >= 0) close(fd2);\n        return 0;\n    }\n\n    // Write data to files\n    ssize_t written1 = write(fd1, data1, size1);\n    ssize_t written2 = write(fd2, data2, size2);\n    close(fd1);\n    close(fd2);\n    if (written1 != (ssize_t)size1 || written2 != (ssize_t)size2) {\n        unlink(template1);\n        unlink(template2);\n        return 0;\n    }\n\n    // Build file:// URLs\n    char url1[512];\n    char url2[512];\n    snprintf(url1, sizeof(url1), \"file://%s\", template1);\n    snprintf(url2, sizeof(url2), \"file://%s\", template2);\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        unlink(template1);\n        unlink(template2);\n        return 0;\n    }\n\n    // First transfer\n    curl_easy_setopt(curl, CURLOPT_URL, url1);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_WRITEDATA, NULL);\n    curl_easy_perform(curl);\n\n    // Second transfer with same handle\n    curl_easy_setopt(curl, CURLOPT_URL, url2);\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n\n    unlink(template1);\n    unlink(template2);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":180,"completion_tokens":644,"total_tokens":824,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":52},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}