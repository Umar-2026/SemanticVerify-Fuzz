{"id":"d4932611-1f8e-4d3c-9ec5-29e379fb9b5f","object":"chat.completion","created":1786293383,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 8) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    write(fd, data, size);\n    close(fd);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    unlink(filename);\n    if (!tif) return 0;\n\n    uint32_t width, height;\n    uint16_t bits_per_sample, samples_per_pixel;\n    uint16_t planar_config;\n\n    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n    TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n    TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n    TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n    TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n\n    tmsize_t scanline_size = TIFFScanlineSize(tif);\n    if (scanline_size <= 0) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Allocate a dynamically sized buffer for one scanline\n    uint8_t *buf = (uint8_t *)malloc(scanline_size);\n    if (!buf) {\n        TIFFClose(tif);\n        return 0;\n    }\n\n    // Read and process each scanline\n    for (uint32_t row = 0; row < height; row++) {\n        if (TIFFReadScanline(tif, buf, row, 0) < 0) {\n            break;\n        }\n        // Simple inspection: compute a checksum over the scanline data\n        uint32_t checksum = 0;\n        for (tmsize_t i = 0; i < scanline_size; i++) {\n            checksum = (checksum * 31) + buf[i];\n        }\n        // Use checksum to prevent optimization (no-op)\n        if (checksum == 0xDEADBEEF) {\n            // This branch is never taken, but keeps the compiler honest\n            volatile uint8_t dummy = buf[0];\n            (void)dummy;\n        }\n    }\n\n    free(buf);\n    TIFFClose(tif);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":169,"completion_tokens":583,"total_tokens":752,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":41},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}