{"id":"de32d550-563e-4745-86df-3ac798c07eeb","object":"chat.completion","created":1786351263,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ares.h>\n\ntypedef struct {\n    int done;\n    int got_record;\n} query_state;\n\nstatic void query_callback(void *arg, int status, int timeouts, unsigned char *abuf, int alen) {\n    (void)timeouts;\n    (void)abuf;\n    (void)alen;\n    query_state *state = (query_state *)arg;\n    if (status == ARES_SUCCESS) {\n        state->got_record = 1;\n    }\n    state->done = 1;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 4) {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int optmask = ARES_OPT_FLAGS;\n\n    if (ares_init_options(&channel, &options, optmask) != ARES_SUCCESS) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv != NULL) {\n        ares_set_servers_csv(channel, server_csv);\n    }\n\n    // Build a bounded hostname from fuzz input (max 63 chars per label, total 255)\n    char hostname[256];\n    size_t len = size < 255 ? size : 255;\n    memcpy(hostname, data, len);\n    hostname[len] = '\\0';\n    // Ensure it's a valid hostname-ish string: replace non-printable with 'a'\n    for (size_t i = 0; i < len; i++) {\n        if (hostname[i] < 33 || hostname[i] > 126) {\n            hostname[i] = 'a';\n        }\n    }\n\n    query_state state;\n    state.done = 0;\n    state.got_record = 0;\n\n    ares_query_dnsrec(channel, hostname, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &state, NULL);\n\n    // Process until done or timeout (bounded loop)\n    int max_waits = 100;\n    while (!state.done && max_waits-- > 0) {\n        struct timeval tv;\n        tv.tv_sec = 0;\n        tv.tv_usec = 10000; // 10ms\n        ares_process_fd(channel, ARES_SOCKET_BAD, ARES_SOCKET_BAD);\n        select(0, NULL, NULL, NULL, &tv);\n    }\n\n    // Produce binary result: 1 if got_record, else 0\n    uint8_t result = state.got_record ? 1 : 0;\n    // Output via a simple side-effect to prevent optimization\n    __asm__ volatile(\"\" : : \"r\"(result) : \"memory\");\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":236,"completion_tokens":673,"total_tokens":909,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":108},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}