{"id":"27a6fbb5-b2ea-453b-a169-660787576233","object":"chat.completion","created":1786351013,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _WIN32\n#include <winsock2.h>\n#include <ws2tcpip.h>\n#else\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#endif\n\n#define MAX_LOOKUPS 16\n#define MAX_NAME_LEN 256\n\ntypedef struct {\n    int pending;\n    int completed;\n    int errors;\n} lookup_state;\n\nstatic void addr_callback(void *arg, int status, int timeouts, struct ares_addrinfo *result) {\n    lookup_state *state = (lookup_state *)arg;\n    state->completed++;\n    if (status != ARES_SUCCESS) {\n        state->errors++;\n        fprintf(stderr, \"Lookup failed: %s\\n\", ares_strerror(status));\n    } else {\n        struct ares_addrinfo_node *node = result->nodes;\n        while (node != NULL) {\n            char addr[INET6_ADDRSTRLEN] = {0};\n            if (node->ai_family == AF_INET) {\n                struct sockaddr_in *sin = (struct sockaddr_in *)node->ai_addr;\n                inet_ntop(AF_INET, &sin->sin_addr, addr, sizeof(addr));\n            } else if (node->ai_family == AF_INET6) {\n                struct sockaddr_in6 *sin6 = (struct sockaddr_in6 *)node->ai_addr;\n                inet_ntop(AF_INET6, &sin6->sin6_addr, addr, sizeof(addr));\n            }\n            if (addr[0]) {\n                printf(\"Resolved: %s\\n\", addr);\n            }\n            node = node->ai_next;\n        }\n    }\n    if (result) {\n        ares_freeaddrinfo(result);\n    }\n    state->pending--;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size == 0) {\n        return 0;\n    }\n\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    if (server_csv == NULL || server_csv[0] == '\\0') {\n        return 0;\n    }\n\n    ares_channel channel;\n    struct ares_options options;\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    int optmask = ARES_OPT_FLAGS;\n\n    int status = ares_init_options(&channel, &options, optmask);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    status = ares_set_servers_csv(channel, server_csv);\n    if (status != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    lookup_state state;\n    state.pending = 0;\n    state.completed = 0;\n    state.errors = 0;\n\n    size_t offset = 0;\n    int lookups = 0;\n    while (offset < size && lookups < MAX_LOOKUPS) {\n        size_t name_len = data[offset++];\n        if (name_len == 0 || name_len > MAX_NAME_LEN - 1) {\n            break;\n        }\n        if (offset + name_len > size) {\n            break;\n        }\n        char name[MAX_NAME_LEN];\n        memcpy(name, data + offset, name_len);\n        name[name_len] = '\\0';\n        offset += name_len;\n\n        struct ares_addrinfo_hints hints;\n        memset(&hints, 0, sizeof(hints));\n        hints.ai_family = AF_UNSPEC;\n        hints.ai_socktype = SOCK_STREAM;\n\n        state.pending++;\n        ares_getaddrinfo(channel, name, NULL, &hints, addr_callback, &state);\n        lookups++;\n    }\n\n    if (lookups == 0) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    int numfds;\n    fd_set readers, writers;\n    struct timeval tv, *tvp;\n    while (state.pending > 0) {\n        FD_ZERO(&readers);\n        FD_ZERO(&writers);\n        numfds = ares_fds(channel, &readers, &writers);\n        if (numfds == 0) {\n            break;\n        }\n        tv.tv_sec = 1;\n        tv.tv_usec = 0;\n        tvp = &tv;\n        if (select(numfds, &readers, &writers, NULL, tvp) < 0) {\n            break;\n        }\n        ares_process(channel, &readers, &writers);\n    }\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":204,