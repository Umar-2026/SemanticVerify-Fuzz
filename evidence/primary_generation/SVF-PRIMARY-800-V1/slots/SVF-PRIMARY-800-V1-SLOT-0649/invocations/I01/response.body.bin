sv) != ARES_SUCCESS) {\n        ares_destroy(channel);\n        return 0;\n    }\n\n    query_result res1;\n    query_result res2;\n    memset(&res1, 0, sizeof(res1));\n    memset(&res2, 0, sizeof(res2));\n\n    ares_query_dnsrec(channel, name1, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &res1, 0);\n    ares_query_dnsrec(channel, name2, ARES_CLASS_IN, ARES_REC_TYPE_A, query_callback, &res2, 0);\n\n    /* Drive the event loop until both callbacks have fired. */\n    int max_fd;\n    fd_set read_fds, write_fds;\n    struct timeval tv;\n    int nfds;\n    int both_done = 0;\n\n    while (!both_done) {\n        FD_ZERO(&read_fds);\n        FD_ZERO(&write_fds);\n        nfds = ares_fds(channel, &read_fds, &write_fds);\n        if (nfds == 0) {\n            /* No sockets pending; break to avoid infinite loop. */\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 100000; /* 100 ms */\n        max_fd = nfds;\n        if (select(max_fd, &read_fds, &write_fds, NULL, &tv) < 0) {\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n        if (res1.done && res2.done) {\n            both_done = 1;\n        }\n    }\n\n    /* Consume callback outcomes. */\n    if (res1.buf) free(res1.buf);\n    if (res2.buf) free(res2.buf);\n\n    ares_destroy(channel);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":222,"completion_tokens":984,"total_tokens":1206,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":94},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}