{"id":"94fca4bb-bcb2-45fb-bf2c-ef2841f5969a","object":"chat.completion","created":1786292643,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <curl/curl.h>\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Split input into two parts for two files\n    size_t half = size / 2;\n    const uint8_t *data1 = data;\n    size_t size1 = half;\n    const uint8_t *data2 = data + half;\n    size_t size2 = size - half;\n\n    // Create temporary file names\n    char file1[] = \"/tmp/curl_fuzz_XXXXXX\";\n    char file2[] = \"/tmp/curl_fuzz_XXXXXX\";\n    int fd1 = mkstemp(file1);\n    int fd2 = mkstemp(file2);\n    if (fd1 == -1 || fd2 == -1) {\n        if (fd1 != -1) close(fd1);\n        if (fd2 != -1) close(fd2);\n        return 0;\n    }\n\n    // Write data to files\n    ssize_t written1 = write(fd1, data1, size1);\n    ssize_t written2 = write(fd2, data2, size2);\n    close(fd1);\n    close(fd2);\n    if (written1 != (ssize_t)size1 || written2 != (ssize_t)size2) {\n        unlink(file1);\n        unlink(file2);\n        return 0;\n    }\n\n    // Build file:// URLs\n    char url1[512];\n    char url2[512];\n    snprintf(url1, sizeof(url1), \"file://%s\", file1);\n    snprintf(url2, sizeof(url2), \"file://%s\", file2);\n\n    CURL *curl1 = curl_easy_init();\n    CURL *curl2 = curl_easy_init();\n    if (!curl1 || !curl2) {\n        if (curl1) curl_easy_cleanup(curl1);\n        if (curl2) curl_easy_cleanup(curl2);\n        unlink(file1);\n        unlink(file2);\n        return 0;\n    }\n\n    // Configure and perform first transfer\n    curl_easy_setopt(curl1, CURLOPT_URL, url1);\n    curl_easy_setopt(curl1, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl1, CURLOPT_NOSIGNAL, 1L);\n    CURLcode res1 = curl_easy_perform(curl1);\n\n    // Configure and perform second transfer\n    curl_easy_setopt(curl2, CURLOPT_URL, url2);\n    curl_easy_setopt(curl2, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl2, CURLOPT_NOSIGNAL, 1L);\n    CURLcode res2 = curl_easy_perform(curl2);\n\n    // Cleanup\n    curl_easy_cleanup(curl1);\n    curl_easy_cleanup(curl2);\n    unlink(file1);\n    unlink(file2);\n\n    (void)res1;\n    (void)res2;\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":174,"completion_tokens":758,"total_tokens":932,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":46},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}