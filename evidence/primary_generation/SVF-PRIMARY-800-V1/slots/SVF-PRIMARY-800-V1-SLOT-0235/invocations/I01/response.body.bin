{"id":"89e281ab-18ef-42d6-bac6-3786702a6071","object":"chat.completion","created":1786292554,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <unistd.h>\n#include <fcntl.h>\n#include <sys/stat.h>\n\n#include <curl/curl.h>\n\n#define MAX_FILE_SIZE 4096\n#define MAX_FILENAME_LEN 64\n\nstatic size_t write_callback(char *ptr, size_t size, size_t nmemb, void *userdata) {\n    (void)ptr;\n    (void)userdata;\n    return size * nmemb;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) {\n        return 0;\n    }\n\n    // Split input into two parts\n    size_t split = size / 2;\n    const uint8_t *data1 = data;\n    size_t size1 = split;\n    const uint8_t *data2 = data + split;\n    size_t size2 = size - split;\n\n    // Limit file sizes\n    if (size1 > MAX_FILE_SIZE) size1 = MAX_FILE_SIZE;\n    if (size2 > MAX_FILE_SIZE) size2 = MAX_FILE_SIZE;\n\n    // Create temporary files\n    char filename1[MAX_FILENAME_LEN];\n    char filename2[MAX_FILENAME_LEN];\n    snprintf(filename1, sizeof(filename1), \"/tmp/curl_fuzz_%d_1\", getpid());\n    snprintf(filename2, sizeof(filename2), \"/tmp/curl_fuzz_%d_2\", getpid());\n\n    int fd1 = open(filename1, O_WRONLY | O_CREAT | O_TRUNC, 0600);\n    int fd2 = open(filename2, O_WRONLY | O_CREAT | O_TRUNC, 0600);\n    if (fd1 < 0 || fd2 < 0) {\n        if (fd1 >= 0) close(fd1);\n        if (fd2 >= 0) close(fd2);\n        return 0;\n    }\n\n    ssize_t written1 = write(fd1, data1, size1);\n    ssize_t written2 = write(fd2, data2, size2);\n    close(fd1);\n    close(fd2);\n    if (written1 != (ssize_t)size1 || written2 != (ssize_t)size2) {\n        unlink(filename1);\n        unlink(filename2);\n        return 0;\n    }\n\n    // Build file:// URLs\n    char url1[256];\n    char url2[256];\n    snprintf(url1, sizeof(url1), \"file://%s\", filename1);\n    snprintf(url2, sizeof(url2), \"file://%s\", filename2);\n\n    CURL *curl = curl_easy_init();\n    if (!curl) {\n        unlink(filename1);\n        unlink(filename2);\n        return 0;\n    }\n\n    // First transfer\n    curl_easy_setopt(curl, CURLOPT_URL, url1);\n    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);\n    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n    curl_easy_perform(curl);\n\n    // Second transfer with same handle\n    curl_easy_setopt(curl, CURLOPT_URL, url2);\n    curl_easy_perform(curl);\n\n    curl_easy_cleanup(curl);\n\n    unlink(filename1);\n    unlink(filename2);\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":180,"completion_tokens":763,"total_tokens":943,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":52},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}