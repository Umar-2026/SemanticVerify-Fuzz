{"id":"b380e8ee-5c03-494a-aebe-312a651e99f6","object":"chat.completion","created":1786350605,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"vpx/vpx_encoder.h\"\n#include \"vpx/vp8cx.h\"\n\n#define IMG_WIDTH 64\n#define IMG_HEIGHT 64\n#define MAX_PACKETS 16\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 1) return 0;\n\n    vpx_image_t *img = NULL;\n    vpx_codec_ctx_t codec;\n    vpx_codec_enc_cfg_t cfg;\n    vpx_codec_err_t res;\n    int packets = 0;\n\n    // Initialize encoder configuration\n    res = vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0);\n    if (res != VPX_CODEC_OK) return 0;\n\n    cfg.g_w = IMG_WIDTH;\n    cfg.g_h = IMG_HEIGHT;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.rc_target_bitrate = 256;\n\n    // Allocate image\n    img = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, IMG_WIDTH, IMG_HEIGHT, 1);\n    if (!img) return 0;\n\n    // Fill image planes with fuzz data\n    size_t offset = 0;\n    for (int plane = 0; plane < 3; plane++) {\n        int w = (plane == 0) ? IMG_WIDTH : IMG_WIDTH / 2;\n        int h = (plane == 0) ? IMG_HEIGHT : IMG_HEIGHT / 2;\n        for (int y = 0; y < h; y++) {\n            uint8_t *row = img->planes[plane] + y * img->stride[plane];\n            for (int x = 0; x < w; x++) {\n                if (offset < size) {\n                    row[x] = data[offset++];\n                } else {\n                    row[x] = 0;\n                }\n            }\n        }\n    }\n\n    // Initialize encoder\n    res = vpx_codec_enc_init(&codec, vpx_codec_vp8_cx(), &cfg, 0);\n    if (res != VPX_CODEC_OK) {\n        vpx_img_free(img);\n        return 0;\n    }\n\n    // Encode the image\n    res = vpx_codec_encode(&codec, img, 0, 1, 0, VPX_DL_REALTIME);\n    if (res == VPX_CODEC_OK) {\n        // Consume generated packets\n        const vpx_codec_cx_pkt_t *pkt;\n        while ((pkt = vpx_codec_get_cx_data(&codec, &res)) != NULL) {\n            if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n                packets++;\n                if (packets >= MAX_PACKETS) break;\n            }\n        }\n    }\n\n    // Cleanup\n    vpx_codec_destroy(&codec);\n    vpx_img_free(img);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":191,"completion_tokens":696,"total_tokens":887,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":63},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}