{"id":"29720876-f388-4630-8c1e-f47200721f61","object":"chat.completion","created":1786350251,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n#include <tiffio.h>\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    // Create a temporary file to hold the input data\n    char filename[] = \"/tmp/libtiff_fuzz_XXXXXX\";\n    int fd = mkstemp(filename);\n    if (fd < 0) return 0;\n    FILE *f = fdopen(fd, \"wb\");\n    if (!f) {\n        close(fd);\n        unlink(filename);\n        return 0;\n    }\n    fwrite(data, 1, size, f);\n    fclose(f);\n\n    TIFF *tif = TIFFOpen(filename, \"r\");\n    if (tif) {\n        uint32_t width, height;\n        uint16_t bits_per_sample, samples_per_pixel;\n        uint16_t planar_config;\n\n        TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width);\n        TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height);\n        TIFFGetField(tif, TIFFTAG_BITSPERSAMPLE, &bits_per_sample);\n        TIFFGetField(tif, TIFFTAG_SAMPLESPERPIXEL, &samples_per_pixel);\n        TIFFGetField(tif, TIFFTAG_PLANARCONFIG, &planar_config);\n\n        // Compute scanline size safely\n        uint64_t scanline_size = TIFFScanlineSize(tif);\n        if (scanline_size == 0 || scanline_size > 1024 * 1024 * 16) {\n            TIFFClose(tif);\n            unlink(filename);\n            return 0;\n        }\n\n        uint8_t *buf = (uint8_t *)malloc(scanline_size);\n        if (!buf) {\n            TIFFClose(tif);\n            unlink(filename);\n            return 0;\n        }\n\n        // Attempt to read scanlines\n        int read_result = 0;\n        uint32_t rows_to_read = height;\n        if (rows_to_read > 1000) rows_to_read = 1000; // bound work\n\n        for (uint32_t row = 0; row < rows_to_read; row++) {\n            int ret = TIFFReadScanline(tif, buf, row, 0);\n            if (ret < 0) {\n                read_result = -1;\n                break;\n            } else if (ret == 0) {\n                read_result = 1;\n            } else {\n                read_result = 2;\n            }\n        }\n\n        // Multiple functional outcomes based on open and read results\n        if (read_result == -1) {\n            // Read failed: do nothing special\n        } else if (read_result == 1) {\n            // Some rows read successfully, some not\n            // Just touch the buffer to ensure it's used\n            if (buf[0] == 0xAA) {\n                // dummy branch\n            }\n        } else if (read_result == 2) {\n            // All rows read successfully\n            // Compute a simple checksum over the buffer\n            uint32_t checksum = 0;\n            for (uint32_t i = 0; i < scanline_size; i++) {\n                checksum += buf[i];\n            }\n            if (checksum == 0xDEADBEEF) {\n                // dummy branch\n            }\n        } else {\n            // No rows read (height == 0)\n            // Just close\n        }\n\n        free(buf);\n        TIFFClose(tif);\n    } else {\n        // Open failed: nothing to do\n    }\n\n    unlink(filename);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":167,"completion_tokens":817,"total_tokens":984,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":39},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}