{"id":"238c202d-8a7a-4dee-8011-cc23703a45e8","object":"chat.completion","created":1786351297,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <ares.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n#include <unistd.h>\n#include <errno.h>\n\nstatic int callback_called = 0;\nstatic int callback_status = -1;\nstatic int callback_timeouts = 0;\nstatic struct ares_addrinfo *callback_result = NULL;\n\nstatic void addr_callback(void *arg, int status, int timeouts, struct ares_addrinfo *res) {\n    (void)arg;\n    callback_called = 1;\n    callback_status = status;\n    callback_timeouts = timeouts;\n    callback_result = res;\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    ares_channel channel;\n    struct ares_options options;\n    int optmask = 0;\n    int status;\n    const char *server_csv = getenv(\"SVF_CARES_SERVER_CSV\");\n    char hostname[256];\n    size_t hostname_len;\n    struct ares_addrinfo_hints hints;\n    int fd_count;\n    fd_set read_fds, write_fds;\n    struct timeval tv;\n    int nfds;\n    int i;\n    int result = 0;\n\n    if (size < 1) return 0;\n\n    memset(&options, 0, sizeof(options));\n    options.flags = ARES_FLAG_STAYOPEN;\n    optmask |= ARES_OPT_FLAGS;\n\n    status = ares_init_options(&channel, &options, optmask);\n    if (status != ARES_SUCCESS) {\n        return 0;\n    }\n\n    if (server_csv != NULL && server_csv[0] != '\\0') {\n        status = ares_set_servers_csv(channel, server_csv);\n        if (status != ARES_SUCCESS) {\n            ares_destroy(channel);\n            return 0;\n        }\n    }\n\n    hostname_len = size < sizeof(hostname) - 1 ? size : sizeof(hostname) - 1;\n    memcpy(hostname, data, hostname_len);\n    hostname[hostname_len] = '\\0';\n\n    memset(&hints, 0, sizeof(hints));\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n\n    callback_called = 0;\n    callback_status = -1;\n    callback_timeouts = 0;\n    callback_result = NULL;\n\n    ares_getaddrinfo(channel, hostname, NULL, &hints, addr_callback, NULL);\n\n    for (i = 0; i < 100 && !callback_called; i++) {\n        fd_count = ares_fds(channel, &read_fds, &write_fds);\n        if (fd_count == 0) {\n            break;\n        }\n        tv.tv_sec = 0;\n        tv.tv_usec = 10000;\n        nfds = select(fd_count, &read_fds, &write_fds, NULL, &tv);\n        if (nfds < 0) {\n            if (errno == EINTR) continue;\n            break;\n        }\n        ares_process(channel, &read_fds, &write_fds);\n    }\n\n    if (callback_called) {\n        if (callback_status == ARES_SUCCESS && callback_result != NULL) {\n            result = 1;\n        } else if (callback_status == ARES_ENOTFOUND || callback_status == ARES_ENODATA) {\n            result = 2;\n        } else if (callback_status == ARES_ETIMEOUT) {\n            result = 3;\n        } else {\n            result = 4;\n        }\n    } else {\n        result = 5;\n    }\n\n    if (callback_result != NULL) {\n        ares_freeaddrinfo(callback_result);\n    }\n\n    ares_destroy(channel);\n    return result;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":202,"completion_tokens":858,"total_tokens":1060,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":74},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}