ch (opt_byte % 4) {\n        case 0:\n            // Follow redirects (disabled for file://, but set anyway)\n            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);\n            break;\n        case 1:\n            // Set a timeout\n            curl_easy_setopt(curl, CURLOPT_TIMEOUT, 5L);\n            break;\n        case 2:\n            // Set user agent\n            curl_easy_setopt(curl, CURLOPT_USERAGENT, \"fuzz-agent\");\n            break;\n        case 3:\n            // Set no signal\n            curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\n            break;\n        default:\n            break;\n    }\n\n    // Perform the transfer\n    CURLcode res = curl_easy_perform(curl);\n\n    // Cleanup\n    curl_easy_cleanup(curl);\n    curl_global_cleanup();\n\n    if (output) {\n        free(output);\n    }\n\n    // Remove temporary file\n    remove(\"/tmp/curl_fuzz_input\");\n\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":193,"completion_tokens":768,"total_tokens":961,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":65},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}