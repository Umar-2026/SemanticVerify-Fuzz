{"id":"d7bdc6cb-6059-4732-b397-b2a2688ff71b","object":"chat.completion","created":1786350432,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <vpx/vpx_encoder.h>\n#include <vpx/vp8cx.h>\n\n#define WIDTH 64\n#define HEIGHT 64\n#define BIT_DEPTH 8\n\nstatic void generate_frame(vpx_image_t *img, unsigned int seed) {\n    unsigned int x, y;\n    unsigned int val = seed;\n    for (y = 0; y < HEIGHT; y++) {\n        for (x = 0; x < WIDTH; x++) {\n            val = val * 1103515245 + 12345;\n            img->planes[VPX_PLANE_Y][y * img->stride[VPX_PLANE_Y] + x] = (unsigned char)((val >> 16) & 0xFF);\n        }\n    }\n    for (y = 0; y < HEIGHT / 2; y++) {\n        for (x = 0; x < WIDTH / 2; x++) {\n            val = val * 1103515245 + 12345;\n            img->planes[VPX_PLANE_U][y * img->stride[VPX_PLANE_U] + x] = (unsigned char)((val >> 16) & 0xFF);\n            val = val * 1103515245 + 12345;\n            img->planes[VPX_PLANE_V][y * img->stride[VPX_PLANE_V] + x] = (unsigned char)((val >> 16) & 0xFF);\n        }\n    }\n}\n\nint LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {\n    if (size < 2) return 0;\n\n    vpx_codec_ctx_t codec;\n    vpx_codec_enc_cfg_t cfg;\n    vpx_image_t *img1 = NULL;\n    vpx_image_t *img2 = NULL;\n    vpx_codec_iter_t iter = NULL;\n    const vpx_codec_cx_pkt_t *pkt;\n    int ret;\n\n    // Initialize config\n    if (vpx_codec_enc_config_default(vpx_codec_vp8_cx(), &cfg, 0)) return 0;\n    cfg.g_w = WIDTH;\n    cfg.g_h = HEIGHT;\n    cfg.g_timebase.num = 1;\n    cfg.g_timebase.den = 30;\n    cfg.g_pass = VPX_RC_ONE_PASS;\n    cfg.g_lag_in_frames = 0;\n    cfg.rc_end_usage = VPX_CBR;\n    cfg.rc_target_bitrate = 256;\n\n    // Initialize encoder\n    if (vpx_codec_enc_init(&codec, vpx_codec_vp8_cx(), &cfg, 0)) return 0;\n\n    // Allocate and generate first frame\n    img1 = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, WIDTH, HEIGHT, 1);\n    if (!img1) {\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n    generate_frame(img1, data[0] | (data[1] << 8));\n\n    // Encode first frame\n    ret = vpx_codec_encode(&codec, img1, 0, 1, 0, VPX_DL_REALTIME);\n    if (ret != VPX_CODEC_OK) {\n        vpx_img_free(img1);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    // Drain packets for first frame\n    while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n        if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n            // Process packet (not needed for this test)\n        }\n    }\n\n    // Allocate and generate second frame independently\n    img2 = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, WIDTH, HEIGHT, 1);\n    if (!img2) {\n        vpx_img_free(img1);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n    generate_frame(img2, (data[0] << 8) | data[1]);\n\n    // Encode second frame\n    ret = vpx_codec_encode(&codec, img2, 1, 1, 0, VPX_DL_REALTIME);\n    if (ret != VPX_CODEC_OK) {\n        vpx_img_free(img1);\n        vpx_img_free(img2);\n        vpx_codec_destroy(&codec);\n        return 0;\n    }\n\n    // Drain packets for second frame\n    iter = NULL;\n    while ((pkt = vpx_codec_get_cx_data(&codec, &iter)) != NULL) {\n        if (pkt->kind == VPX_CODEC_CX_FRAME_PKT) {\n            // Process packet (not needed for this test)\n        }\n    }\n\n    // Cleanup\n    vpx_img_free(img1);\n    vpx_img_free(img2);\n    vpx_codec_destroy(&codec);\n    return 0;\n}"},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":167,"completion_tokens":1132,"total_tokens":1299,"prompt_tokens_details":{"cached_tokens":128},"prompt_cache_hit_tokens":128,"prompt_cache_miss_tokens":39},"system_fingerprint":"fp_a18b46594c_prod0820_fp8_kvcache_20260402"}