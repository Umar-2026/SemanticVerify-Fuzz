        {
          "name": "direct_cache_split",
          "required_fields": [
            "prompt_cache_hit_tokens",
            "prompt_cache_miss_tokens",
            "completion_tokens"
          ]
        },
        {
          "derivation": "cache_hit=prompt_tokens_details.cached_tokens; cache_miss=prompt_tokens-cache_hit",
          "name": "derive_cache_split",
          "required_fields": [
            "prompt_tokens",
            "prompt_tokens_details.cached_tokens",
            "completion_tokens"
          ]
        }
      ]
    },
    "Gemini": {
      "formula": "(promptTokenCount * input_rate + (candidatesTokenCount + thoughtsTokenCount_or_zero) * output_including_thinking_rate) / 1000000",
      "invalid_or_insufficient_usage": "PRESERVE_RESPONSE_AND_PAUSE_BEFORE_NEXT_CALL",
      "optional_usage_fields": {
        "cachedContentTokenCount": "must be absent or zero because the frozen request plan does not request explicit cached content",
        "thoughtsTokenCount": "if absent, reported thinking-token count is recorded as zero for the estimate"
      },
      "pricing_tier": "Standard paid",
      "rates": {
        "input": 0.25,
        "output_including_thinking_tokens": 1.5
      },
      "required_usage_fields": [
        "promptTokenCount",
        "candidatesTokenCount"
      ],
      "unexpected_positive_cachedContentTokenCount": "PRESERVE_RESPONSE_AND_PAUSE_BEFORE_NEXT_CALL",
