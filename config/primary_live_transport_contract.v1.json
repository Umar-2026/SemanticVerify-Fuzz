      "formula": "(cache_hit_tokens * input_cache_hit + cache_miss_tokens * input_cache_miss + completion_tokens * output) / 1000000",
      "invalid_or_insufficient_usage": "PRESERVE_RESPONSE_AND_PAUSE_BEFORE_NEXT_CALL",
      "rates": {
