{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semanticverify-fuzz.invalid/schema/normalized-obligation-instance-1.0.0",
  "title": "SemanticVerify-Fuzz normalized protocol-obligation instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "obligation_instance_id",
    "driver_id",
    "resource_identity",
    "rule_id",
    "program_point_or_exit",
    "abstract_context",
    "eligibility",
    "out_of_scope_reason",
    "required_condition",
    "observed_state_set",
    "relevant_branch_predicate_class",
    "raw_witness_paths",
    "verdict",
    "unknown_limitation_codes",
    "defect_category",
    "severity",
    "source_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "obligation_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "driver_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_identity": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "program_point_or_exit": {
      "type": "string",
      "minLength": 1
    },
    "abstract_context": {
      "type": "string",
      "minLength": 1
    },
    "eligibility": {
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE"
      ]
    },
    "out_of_scope_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_condition": {
      "type": "string",
      "minLength": 1
    },
    "observed_state_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relevant_branch_predicate_class": {
      "type": "string",
      "minLength": 1
    },
    "raw_witness_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "VALID",
        "VIOLATION-MUST",
        "VIOLATION-MAY",
        "UNKNOWN",
        null
      ]
    },
    "unknown_limitation_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "U01_UNSUPPORTED_SEMANTICS",
          "U02_UNRESOLVED_ALIAS",
          "U03_UNRESOLVED_INDIRECT_CALL",
          "U04_STATE_CAP_EXHAUSTION",
          "U05_MISSING_EVIDENCE",
          "U06_OUT_OF_MODEL_INTERACTION",
          "U07_UNSUPPORTED_SIDE_EFFECT"
        ]
      }
    },
    "defect_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6",
        "D7",
        "D8",
        null
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNSPECIFIED"
      ]
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "OUT_OF_SCOPE"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": null
          },
          "out_of_scope_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "unknown_limitation_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
