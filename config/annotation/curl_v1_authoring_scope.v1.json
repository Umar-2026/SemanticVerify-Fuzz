        "EASY_OWNED",
        "EASY_CLOSED"
      ]
    },
    "EXPLICIT_GLOBAL_STATE": {
      "bounded_scope": "Only the explicit curl_global_init/curl_global_cleanup pair exercised by frozen scenario S10 is modeled as an explicit resource obligation.",
      "easy_init_auto_initialization_exception": true,
      "states": [
        "NO_EXPLICIT_GLOBAL_INIT",
        "EXPLICIT_GLOBAL_READY",
        "EXPLICIT_GLOBAL_CLEANED"
      ]
    },
    "MULTI_HANDLE": {
      "c_type": "CURLM *",
      "creation": {
        "curl_multi_init_non_null": "MULTI_OWNED",
        "curl_multi_init_null": "NO_MULTI"
      },
      "release": {
        "function": "curl_multi_cleanup",
        "result_state": "MULTI_CLOSED"
      },
      "states": [
        "NO_MULTI",
        "MULTI_OWNED",
        "MULTI_CLOSED"
      ]
    }
  },
