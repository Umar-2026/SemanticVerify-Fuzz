  "source_representation_forms": [
    {
      "representation_id": "ZE1-SF0-RAW-ATOM-EXACT",
      "definition": "Exact retained source atom string with no normalization."
    },
    {
      "representation_id": "ZE1-SF1-DOT-SEGMENT-SEQUENCE-EXACT",
      "definition": "Split ZE1-SF0 on literal '.' and preserve leading, internal, and trailing empty dot segments."
    },
    {
      "representation_id": "ZE1-SF2-PER-SEGMENT-LEXICAL-TOKEN-SEQUENCES",
      "definition": "For every ZE1-SF1 dot segment independently: '_' and '-' are separators; split ASCII lowercase-or-digit to ASCII uppercase boundaries; split ASCII acronym boundaries before the uppercase character that begins a capitalized word; lowercase ASCII A-Z only; preserve digits and non-ASCII code points; discard separator-created empty lexical tokens."
    },
    {
      "representation_id": "ZE1-SF3-FLATTENED-LEXICAL-TOKEN-SEQUENCE",
      "definition": "Concatenate ZE1-SF2 lexical-token sequences in original dot-segment order."
    }
  ],
